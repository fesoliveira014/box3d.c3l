module b3;

import std::math::quaternion;

alias Vec3 = float[<3>];
alias Quat = Quaternionf;
alias Matrix3 = Vec3[3];

<*
 A world position. Distinct from Vec3 so a position is never silently used as a direction.
 box3d widens this to double in large-world mode, which this package does not build.
*>
typedef Pos = inline Vec3;

struct WorldId {
    ushort index1;
    ushort generation;
}
$assert WorldId::size == 4;
$assert WorldId::alignment == 2;
$assert WorldId::members[0].offset == 0 && WorldId::members[0].name == "index1";
$assert WorldId::members[1].offset == 2 && WorldId::members[1].name == "generation";

struct BodyId {
    int index1;
    ushort world0;
    ushort generation;
}
$assert BodyId::size == 8;
$assert BodyId::alignment == 4;
$assert BodyId::members[0].offset == 0 && BodyId::members[0].name == "index1";
$assert BodyId::members[1].offset == 4 && BodyId::members[1].name == "world0";
$assert BodyId::members[2].offset == 6 && BodyId::members[2].name == "generation";

struct ShapeId {
    int index1;
    ushort world0;
    ushort generation;
}
$assert ShapeId::size == 8;
$assert ShapeId::alignment == 4;
$assert ShapeId::members[0].offset == 0 && ShapeId::members[0].name == "index1";
$assert ShapeId::members[1].offset == 4 && ShapeId::members[1].name == "world0";
$assert ShapeId::members[2].offset == 6 && ShapeId::members[2].name == "generation";

struct JointId {
    int index1;
    ushort world0;
    ushort generation;
}
$assert JointId::size == 8;
$assert JointId::alignment == 4;
$assert JointId::members[0].offset == 0 && JointId::members[0].name == "index1";
$assert JointId::members[1].offset == 4 && JointId::members[1].name == "world0";
$assert JointId::members[2].offset == 6 && JointId::members[2].name == "generation";

struct ContactId {
    int index1;
    ushort world0;
    short padding;
    uint generation;
}
$assert ContactId::size == 12;
$assert ContactId::alignment == 4;
$assert ContactId::members[0].offset == 0 && ContactId::members[0].name == "index1";
$assert ContactId::members[1].offset == 4 && ContactId::members[1].name == "world0";
$assert ContactId::members[2].offset == 6 && ContactId::members[2].name == "padding";
$assert ContactId::members[3].offset == 8 && ContactId::members[3].name == "generation";

struct Transform {
    Vec3 p;
    Quat q;
}
$assert Transform::size == 28;
$assert Transform::alignment == 4;

struct WorldTransform {
    Pos p;
    Quat q;
}
$assert WorldTransform::size == 28;
$assert WorldTransform::alignment == 4;
$assert WorldTransform::members[0].offset == 0 && WorldTransform::members[0].name == "p";
$assert WorldTransform::members[1].offset == 12 && WorldTransform::members[1].name == "q";

struct Aabb {
    Vec3 lower_bound;
    Vec3 upper_bound;
}
$assert Aabb::size == 24;
$assert Aabb::alignment == 4;

struct Plane {
    Vec3 normal;
    float offset;
}
$assert Plane::size == 16;
$assert Plane::alignment == 4;

struct CosSin {
    float cosine;
    float sine;
}
$assert CosSin::size == 8;
$assert CosSin::alignment == 4;

struct SegmentDistanceResult {
    Vec3 point1;
    float fraction1;
    Vec3 point2;
    float fraction2;
}
$assert SegmentDistanceResult::size == 32;
$assert SegmentDistanceResult::alignment == 4;

$assert Vec3::size == 12;
$assert Vec3::alignment == 4;
$assert Pos::size == 12;
$assert Pos::alignment == 4;
$assert Quat::size == 16;
$assert Quat::alignment == 4;
$assert Matrix3::size == 36;
$assert Matrix3::alignment == 4;

extern fn Vec3 point_to_segment_distance(Vec3 a, Vec3 b, Vec3 q) @cname("b3PointToSegmentDistance");
extern fn CosSin compute_cos_sin(float radians) @cname("b3ComputeCosSin");
extern fn SegmentDistanceResult segment_distance(Vec3 p1, Vec3 q1, Vec3 p2, Vec3 q2) @cname("b3SegmentDistance");
extern fn bool is_valid_vec3(Vec3 a) @cname("b3IsValidVec3");
extern fn bool is_valid_quat(Quat q) @cname("b3IsValidQuat");
extern fn bool is_valid_transform(Transform a) @cname("b3IsValidTransform");
extern fn bool is_valid_aabb(Aabb a) @cname("b3IsValidAABB");
extern fn bool is_valid_plane(Plane a) @cname("b3IsValidPlane");

alias AllocFn = fn void*(int size, int alignment);
alias FreeFn = fn void(void* mem);
alias AssertFn = fn int(char* condition, char* file_name, int line_number);
alias LogFn = fn void(char* message);

struct Version {
    int major;
    int minor;
    int revision;
}
$assert Version::size == 12;
$assert Version::alignment == 4;

extern fn Version version() @cname("b3GetVersion");
extern fn bool is_double_precision() @cname("b3IsDoublePrecision");
extern fn int byte_count() @cname("b3GetByteCount");
extern fn void set_allocator(AllocFn alloc_fn, FreeFn free_fn) @cname("b3SetAllocator");
extern fn void set_assert_fn(AssertFn assert_fn) @cname("b3SetAssertFcn");
extern fn void set_log_fn(LogFn log_fn) @cname("b3SetLogFcn");
extern fn ulong ticks() @cname("b3GetTicks");
extern fn float milliseconds(ulong ticks) @cname("b3GetMilliseconds");
extern fn void yield() @cname("b3Yield");
extern fn void sleep(int milliseconds) @cname("b3Sleep");
extern fn float length_units_per_meter() @cname("b3GetLengthUnitsPerMeter");
extern fn void set_length_units_per_meter(float length_units) @cname("b3SetLengthUnitsPerMeter");
extern fn float stall_threshold() @cname("b3GetStallThreshold");
extern fn void set_stall_threshold(float seconds) @cname("b3SetStallThreshold");
extern fn uint hash_bytes(uint hash, char* data, int count) @cname("b3Hash");
