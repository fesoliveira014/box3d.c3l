extern fn void ShapeId.enable_hit_events(self, bool flag) @cname("b3Shape_EnableHitEvents");
extern fn bool ShapeId.are_hit_events_enabled(self) @cname("b3Shape_AreHitEventsEnabled");

<*
 Raw geometry accessors. Each reads a union member box3d selects by shape type and asserts, in a
 debug build, that the type matches; that assertion is compiled out here, so the checked getters
 in box3d_shape.c3 are the only public way in.
*>
extern fn Sphere sphere_raw(ShapeId shape_id) @cname("b3Shape_GetSphere") @private;
extern fn Capsule capsule_raw(ShapeId shape_id) @cname("b3Shape_GetCapsule") @private;
extern fn HullData* hull_raw(ShapeId shape_id) @cname("b3Shape_GetHull") @private;

<*
 Sets the shape's geometry and, with it, its type — a capsule handed a sphere becomes a sphere.
 The body's mass is not recomputed until BodyId.apply_mass_from_shapes() is called.
*>
extern fn void ShapeId.set_sphere(self, Sphere* sphere) @cname("b3Shape_SetSphere");
extern fn void ShapeId.set_capsule(self, Capsule* capsule) @cname("b3Shape_SetCapsule");
extern fn void ShapeId.set_hull(self, HullData* hull) @cname("b3Shape_SetHull");

extern fn Aabb ShapeId.aabb(self) @cname("b3Shape_GetAABB");
extern fn MassData ShapeId.compute_mass_data(self) @cname("b3Shape_ComputeMassData");
extern fn Vec3 ShapeId.closest_point(self, Vec3 target) @cname("b3Shape_GetClosestPoint");
extern fn void ShapeId.apply_wind(self, Vec3 wind, float drag, float lift, float max_speed, bool wake) @cname("b3Shape_ApplyWind");

<*
 A shape began overlapping a sensor shape during the last step. Both shapes must have asked for
 sensor events in their definition — the visitor as well as the sensor.
*>
struct SensorBeginTouchEvent {
    ShapeId sensor_shape_id;
    ShapeId visitor_shape_id;
}

<*
 A shape stopped overlapping a sensor shape. Either identifier may already be dead: destroying a
 body or shape, moving it, or changing its filter all end an overlap, so check them with
 ShapeId.is_valid() before use.
*>
struct SensorEndTouchEvent {
    ShapeId sensor_shape_id;
    ShapeId visitor_shape_id;
}

struct SensorEvents @private {
    SensorBeginTouchEvent* begin_events;
    SensorEndTouchEvent* end_events;
    int begin_count;
    int end_count;
}

<*
 Two shapes began touching during the last step.
*>
struct ContactBeginTouchEvent {
    ShapeId shape_id_a;
    ShapeId shape_id_b;
    ContactId contact_id;
}

<*
 Two shapes stopped touching. Every identifier here may already be dead — see
 SensorEndTouchEvent — and the contact itself is checked with ContactId.is_valid().
*>
struct ContactEndTouchEvent {
    ShapeId shape_id_a;
    ShapeId shape_id_b;
    ContactId contact_id;
}

<*
 Two shapes collided faster than the world's hit event threshold. The normal points from shape A
 to shape B, and the point is the mid-point between the two surfaces at the start of the step,
 which may be a speculative point at which the shapes were not yet touching.
*>
struct ContactHitEvent {
    ShapeId shape_id_a;
    ShapeId shape_id_b;
    ContactId contact_id;
    Pos point;
    Vec3 normal;
    float approach_speed;
    ulong user_material_id_a;
    ulong user_material_id_b;
}

struct ContactEvents @private {
    ContactBeginTouchEvent* begin_events;
    ContactEndTouchEvent* end_events;
    ContactHitEvent* hit_events;
    int begin_count;
    int end_count;
    int hit_count;
}

<*
 A body moved under simulation during the last step. Bodies the caller moved itself are not
 reported. The transform is the pose the body ended the step at, so a caller updating render
 transforms reads it here instead of calling BodyId.transform() per body, and the user data is
 the pointer BodyId.set_user_data() wrote on that body.
*>
struct BodyMoveEvent {
    void* user_data;
    WorldTransform transform;
    BodyId body_id;
    bool fell_asleep;
}

struct BodyEvents @private {
    BodyMoveEvent* move_events;
    int move_count;
}

<*
 An awake joint whose force or torque exceeded its threshold. The forces themselves are not
 reported, and the user data is the pointer JointId.set_user_data() wrote on that joint.
*>
struct JointEvent {
    JointId joint_id;
    void* user_data;
}

struct JointEvents @private {
    JointEvent* joint_events;
    int count;
}

<*
 Raw contact-event accessor. The three slice wrappers in box3d_event.c3 are the public way to
 these arrays, so this stays private: it hands back three pointer-and-count pairs a caller would
 otherwise have to pair up correctly by hand.
*>
extern fn ContactEvents contact_events_raw(WorldId world_id) @cname("b3World_GetContactEvents") @private;

extern fn bool ContactId.is_valid(self) @cname("b3Contact_IsValid");

<*
 Raw sensor-event accessor. Private for the same reason as contact_events_raw: the two slice
 wrappers in box3d_event.c3 are the public way to these arrays.
*>
extern fn SensorEvents sensor_events_raw(WorldId world_id) @cname("b3World_GetSensorEvents") @private;

<*
 Raw body-event accessor. Private for the same reason as contact_events_raw.
*>
extern fn BodyEvents body_events_raw(WorldId world_id) @cname("b3World_GetBodyEvents") @private;

<*
 Raw joint-event accessor. Private for the same reason as contact_events_raw.
*>
extern fn JointEvents joint_events_raw(WorldId world_id) @cname("b3World_GetJointEvents") @private;

extern fn bool JointId.is_valid(self) @cname("b3Joint_IsValid");

<*
 Called for each contact point between two shapes, at least one of which asked for pre-solve
 events, before the solver runs. Returning false discards the contact for that step, so the two
 shapes pass through each other. box3d may call this from a worker thread, and the world must not
 be modified from inside it. The context pointer is stored in the world and dereferenced on every
 call, so it must outlive the world.
*>
alias PreSolveFn = fn bool(ShapeId shape_id_a, ShapeId shape_id_b, Pos point, Vec3 normal, void* context);

<*
 Called when two shapes whose definitions enabled custom filtering are about to begin colliding.
 Returning false stops the pair from colliding at all. Only one of the two shapes needs to have
 enabled it. box3d may call this from a worker thread, and the world must not be modified from
 inside it. The context pointer is stored in the world and dereferenced on every call, so it must
 outlive the world.
*>
alias CustomFilterFn = fn bool(ShapeId shape_id_a, ShapeId shape_id_b, void* context);

extern fn void WorldId.set_pre_solve_callback(self, PreSolveFn pre_solve_fn, void* context) @cname("b3World_SetPreSolveCallback");
extern fn void WorldId.set_custom_filter_callback(self, CustomFilterFn custom_filter_fn, void* context) @cname("b3World_SetCustomFilterCallback");

const int MAX_MANIFOLD_POINTS = 4;
const int MAX_SHAPE_CAST_POINTS = 128;

<*
 Filters which shapes a query considers. A shape is considered when the query's mask_bits
 overlap the shape's category_bits and the shape's mask_bits overlap the query's category_bits.
 default_query_filter() sets every bit in both, so an unmodified filter considers everything.
 The id and name fields are recording metadata and are ignored when not recording; name must
 outlive the query if it is set.
*>
struct QueryFilter {
    ulong category_bits;
    ulong mask_bits;
    ulong id;
    ZString name;
}

<*
 The closest hit from WorldId.cast_ray_closest(). node_visits and leaf_visits are traversal
 diagnostics. When hit is false every other field is undefined, which is why the wrapper faults
 instead of returning this struct.
*>
struct RayResult {
    ShapeId shape_id;
    Pos point;
    Vec3 normal;
    ulong user_material_id;
    float fraction;
    int triangle_index;
    int child_index;
    int node_visits;
    int leaf_visits;
    bool hit;
}

<*
 A convex point cloud with an external radius, used as the swept shape of a shape cast or the
 probe of an overlap query. The points are borrowed: box3d reads them during the call and does
 not copy them, so they must outlive it — a stack array is fine, a temporary is not. count must
 not exceed MAX_SHAPE_CAST_POINTS.
*>
struct ShapeProxy {
    Vec3* points;
    int count;
    float radius;
}

<*
 The result of a single-shape ray or shape cast. When hit is false every other field is
 undefined. material_index is -1 when the shape carries no material.
*>
struct CastOutput {
    Vec3 normal;
    Vec3 point;
    float fraction;
    int iterations;
    int triangle_index;
    int child_index;
    int material_index;
    bool hit;
}

<*
 The same layout as CastOutput in this build. box3d widens the hit point to a double-precision
 position under BOX3D_DOUBLE_PRECISION, which this package never compiles; the alias keeps the
 two names distinct so a future double-precision variant changes one declaration.
*>
alias WorldCastOutput = CastOutput;

<*
 The result of casting at one specific body. When hit is false every other field is undefined.
*>
struct BodyCastResult {
    ShapeId shape_id;
    Pos point;
    Vec3 normal;
    float fraction;
    int triangle_index;
    ulong user_material_id;
    int iterations;
    bool hit;
}

<*
 Broad-phase traversal counters returned by the callback queries. Diagnostic only.
*>
struct TreeStats {
    int node_visits;
    int leaf_visits;
}

<*
 One contact point of a manifold. box3d uses speculative collision, so a point may be separated:
 separation is negative only when the shapes actually overlap, and total_normal_impulse is what
 distinguishes a point that carried an interaction from one that merely existed.
*>
struct ManifoldPoint {
    Vec3 anchor_a;
    Vec3 anchor_b;
    float separation;
    float base_separation;
    float normal_impulse;
    float total_normal_impulse;
    float normal_velocity;
    uint feature_id;
    int triangle_index;
    bool persisted;
}

<*
 The contact points between two colliding shapes. Only the first point_count entries of points
 are valid — contact_points() returns exactly that prefix. The normal is a unit vector pointing
 from shape A to shape B.
*>
struct Manifold {
    ManifoldPoint[MAX_MANIFOLD_POINTS] points;
    Vec3 normal;
    float twist_impulse;
    Vec3 friction_impulse;
    Vec3 rolling_impulse;
    int point_count;
}

<*
 One touching contact. The manifolds pointer and its count keep box3d's own layout because this
 struct is written by box3d into a caller-supplied buffer and cannot hold a C3 slice; read them
 through contact_manifolds(), which carries the borrow in its docstring.
*>
struct ContactData {
    ContactId contact_id;
    ShapeId shape_id_a;
    ShapeId shape_id_b;
    Manifold* manifolds;
    int manifold_count;
}

<*
 A point on a body and the distance to it. box3d measures both against the shapes' core points
 with their radii excluded, so for a sphere or a capsule the point is the centre line and the
 distance overshoots the surface by the radius.
*>
struct ClosestPoint {
    Vec3 point;
    float distance;
}

extern fn QueryFilter default_query_filter() @cname("b3DefaultQueryFilter");

<*
 Raw closest-hit accessor. Private because a miss comes back as a struct whose point, normal and
 fraction are undefined; WorldId.cast_ray_closest() turns that into a fault.
*>
extern fn RayResult cast_ray_closest_raw(
  WorldId world_id,
  Pos origin,
  Vec3 translation,
  QueryFilter filter,
) @cname("b3World_CastRayClosest") @private;

<*
 Raw single-shape ray cast. Private because a miss comes back as a struct of undefined fields.
*>
extern fn WorldCastOutput shape_ray_cast_raw(
  ShapeId shape_id,
  Pos origin,
  Vec3 translation,
) @cname("b3Shape_RayCast") @private;

<*
 Raw single-body ray cast. Private for the same reason as shape_ray_cast_raw.
*>
extern fn BodyCastResult body_cast_ray_raw(
  BodyId body_id,
  Pos origin,
  Vec3 translation,
  QueryFilter filter,
  float max_fraction,
  WorldTransform body_transform,
) @cname("b3Body_CastRay") @private;

<*
 Raw single-body shape cast. Private for the same reason as shape_ray_cast_raw.
*>
extern fn BodyCastResult body_cast_shape_raw(
  BodyId body_id,
  Pos origin,
  ShapeProxy* proxy,
  Vec3 translation,
  QueryFilter filter,
  float max_fraction,
  bool can_encroach,
  WorldTransform body_transform,
) @cname("b3Body_CastShape") @private;

extern fn bool BodyId.overlap_shape(
  self,
  Pos origin,
  ShapeProxy* proxy,
  QueryFilter filter,
  WorldTransform body_transform,
) @cname("b3Body_OverlapShape");

<*
 Raw closest-point accessor. Private because it reports the point through an out-parameter and
 the distance through its return value; BodyId.closest_point() returns both together.
*>
extern fn float body_closest_point_raw(
  BodyId body_id,
  Vec3* result,
  Vec3 target,
) @cname("b3Body_GetClosestPoint") @private;

<*
 Called once for each shape a cast finds along its path, in no particular order. The return value
 steers the cast: -1 rejects this shape and continues, 0 ends the cast, 1 continues without
 clipping, and any fraction between them clips the cast to that point so later shapes are only
 reported if they are nearer. The query runs synchronously on the calling thread, and the world
 must not be modified from inside it.
*>
alias CastResultFn = fn float(
  ShapeId shape_id,
  Pos point,
  Vec3 normal,
  float fraction,
  ulong user_material_id,
  int triangle_index,
  int child_index,
  void* context,
);

<*
 Called once for each shape an overlap query finds. Returning false ends the query. The query
 runs synchronously on the calling thread, and the world must not be modified from inside it.
*>
alias OverlapResultFn = fn bool(ShapeId shape_id, void* context);

<*
 Fires a ray from origin to origin + translation and calls fcn once per shape found along it, in
 no particular order. The callback's return value steers the cast — see CastResultFn. Returns the
 broad-phase traversal counters.
*>
extern fn TreeStats WorldId.cast_ray(
  self,
  Pos origin,
  Vec3 translation,
  QueryFilter filter,
  CastResultFn fcn,
  void* context,
) @cname("b3World_CastRay");

<*
 Sweeps a convex proxy instead of a point, calling fcn once per shape it reaches. The proxy's
 points are borrowed for the duration of the call and its count must not exceed
 MAX_SHAPE_CAST_POINTS. Reported fractions stop short of true contact by box3d's speculative
 margin.
*>
extern fn TreeStats WorldId.cast_shape(
  self,
  Pos origin,
  ShapeProxy* proxy,
  Vec3 translation,
  QueryFilter filter,
  CastResultFn fcn,
  void* context,
) @cname("b3World_CastShape");

<*
 Reports shapes whose broad-phase bounds potentially overlap the query box; it is not an exact
 test against the shape's actual geometry.
*>
extern fn TreeStats WorldId.overlap_aabb(
  self,
  Aabb aabb,
  QueryFilter filter,
  OverlapResultFn fcn,
  void* context,
) @cname("b3World_OverlapAABB");

<*
 Calls fcn once per shape overlapping a convex proxy placed at origin. The proxy's points are
 borrowed for the duration of the call and its count must not exceed MAX_SHAPE_CAST_POINTS.
*>
extern fn TreeStats WorldId.overlap_shape(
  self,
  Pos origin,
  ShapeProxy* proxy,
  QueryFilter filter,
  OverlapResultFn fcn,
  void* context,
) @cname("b3World_OverlapShape");

<*
 One shape a collecting cast found, carrying exactly what the cast callback is given. This is a
 C3 type with no C counterpart: RayResult is the closest-hit result and its traversal counters
 and hit flag mean nothing for a collected hit.
*>
struct CastHit {
    ShapeId shape_id;
    Pos point;
    Vec3 normal;
    float fraction;
    ulong user_material_id;
    int triangle_index;
    int child_index;
}

<*
 The touching contact behind a contact id. The manifolds it carries point into live internal
 state — read them through ContactData.contact_manifolds() and do not hold the result.
*>
extern fn ContactData ContactId.data(self) @cname("b3Contact_GetData");

<*
 An upper bound on the contacts BodyId.contact_data() will write. It counts every contact on the
 body, including ones that are not touching and so never appear in the data, and it reports zero
 while the world is locked.
*>
extern fn int BodyId.contact_capacity(self) @cname("b3Body_GetContactCapacity");

<*
 Raw body contact filler. Private because it reports its count through a return value;
 BodyId.contact_data() returns the filled prefix instead.
*>
extern fn int body_contact_data_raw(
  BodyId body_id,
  ContactData* contact_data,
  int capacity,
) @cname("b3Body_GetContactData") @private;

<*
 An upper bound on the contacts ShapeId.contact_data() will write. It is the whole body's contact
 count, not this shape's, so it over-reports for a body carrying several shapes. It is zero for a
 sensor and zero while the world is locked.
*>
extern fn int ShapeId.contact_capacity(self) @cname("b3Shape_GetContactCapacity");

<*
 Raw shape contact filler. Private for the same reason as body_contact_data_raw.
*>
extern fn int shape_contact_data_raw(
  ShapeId shape_id,
  ContactData* contact_data,
  int capacity,
) @cname("b3Shape_GetContactData") @private;

<*
 The number of shapes attached to this body. Exact, unlike the contact capacities.
*>
extern fn int BodyId.shape_count(self) @cname("b3Body_GetShapeCount");

<*
 Raw body shape filler. Private because it reports its count through a return value;
 BodyId.shapes() returns the filled prefix instead.
*>
extern fn int body_shapes_raw(
  BodyId body_id,
  ShapeId* shape_array,
  int capacity,
) @cname("b3Body_GetShapes") @private;

<*
 The number of shapes currently overlapping this sensor. Exact, unlike the contact capacities,
 but zero for a shape that is not a sensor and zero while the world is locked.
*>
extern fn int ShapeId.sensor_capacity(self) @cname("b3Shape_GetSensorCapacity");

<*
 Raw sensor overlap filler. Private for the same reason as body_shapes_raw.
*>
extern fn int shape_sensor_data_raw(
  ShapeId shape_id,
  ShapeId* visitor_ids,
  int capacity,
) @cname("b3Shape_GetSensorData") @private;

enum JointType : int {
    PARALLEL,
    DISTANCE,
    FILTER,
    MOTOR,
    PRISMATIC,
    REVOLUTE,
    SPHERICAL,
    WELD,
    WHEEL,
}

<*
 The definition every joint type builds on. Must come from default_filter_joint_def(), or from
 another type's default — see WorldId.create_filter_joint. Both local frames are measured from
 their body's origin rather than its centre of mass, so recomputing a body's mass leaves the
 joint where it was. default_filter_joint_def() sets force_threshold and torque_threshold to
 float::max, and a joint whose thresholds both keep that value is never checked at all: either one
 below it arms the check, and being armed is not being reported — see set_force_threshold.
*>
struct JointDef {
    void* user_data;
    BodyId body_id_a;
    BodyId body_id_b;
    Transform local_frame_a;
    Transform local_frame_b;
    float force_threshold;
    float torque_threshold;
    float constraint_hertz;
    float constraint_damping_ratio;
    float draw_scale;
    bool collide_connected;
    int internal_value;
}

<*
 A filter joint definition. A filter joint constrains nothing: it exists so the two bodies it
 links stop colliding, and that suppression lasts only while collide_connected stays false.
*>
struct FilterJointDef {
    inline JointDef base;
}

extern fn FilterJointDef default_filter_joint_def() @cname("b3DefaultFilterJointDef");

<*
 The soft-constraint tuning a joint solves with. This is a C3 type with no C counterpart: box3d
 reports the pair through two out-parameters.
*>
struct ConstraintTuning {
    float hertz;
    float damping_ratio;
}

<*
 Raw filter joint constructor. Bypasses WorldId.create_filter_joint's definition guard, so it is
 private to the module — box3d_joint.c3's WorldId.create_filter_joint is the only caller and is the
 only public way to a live filter joint.
*>
extern fn JointId create_filter_joint_raw(
  WorldId world_id,
  FilterJointDef* def,
) @cname("b3CreateFilterJoint") @private;

<*
 Removes this joint from its world, dropping whatever it constrained between the two bodies. A
 collision the joint was suppressing does not return the way set_collide_connected(true) returns
 one: nothing re-offers the pair to the broad phase, so two settled bodies regain no contact until
 one of them moves.

 @param wake_attached : "false leaves two sleeping attached bodies asleep; true wakes both"
*>
extern fn void JointId.destroy(self, bool wake_attached) @cname("b3DestroyJoint");

<*
 This joint's type, which box3d fixes when the joint is created and offers no way to change.
*>
extern fn JointType JointId.type(self) @cname("b3Joint_GetType");

<*
 The body this joint's definition named as body_id_a.
*>
extern fn BodyId JointId.body_a(self) @cname("b3Joint_GetBodyA");

<*
 The body this joint's definition named as body_id_b.
*>
extern fn BodyId JointId.body_b(self) @cname("b3Joint_GetBodyB");

<*
 The world that owns this joint.
*>
extern fn WorldId JointId.world(self) @cname("b3Joint_GetWorld");

<*
 Moves this joint's anchor on body A. The frame is measured from that body's origin rather than
 its centre of mass, so recomputing the body's mass leaves the anchor where it was.
*>
extern fn void JointId.set_local_frame_a(self, Transform local_frame) @cname("b3Joint_SetLocalFrameA");

<*
 This joint's anchor on body A, measured from that body's origin.
*>
extern fn Transform JointId.local_frame_a(self) @cname("b3Joint_GetLocalFrameA");

<*
 Moves this joint's anchor on body B, measured from that body's origin like set_local_frame_a.
*>
extern fn void JointId.set_local_frame_b(self, Transform local_frame) @cname("b3Joint_SetLocalFrameB");

<*
 This joint's anchor on body B, measured from that body's origin.
*>
extern fn Transform JointId.local_frame_b(self) @cname("b3Joint_GetLocalFrameB");

<*
 Lets the two linked bodies collide again, or stops them colliding.

 This flag, not the joint's type, is what suppresses the collision: box3d refuses the pair for any
 joint linking the two bodies whose collide_connected is false, whatever its type. Turning it on
 has them colliding again from the next step; turning it off ends the collision at once, dropping
 the contacts they already had. The effect is observable only while at least one of the two bodies
 is dynamic — two non-dynamic bodies never collide anyway. Dropping the contacts is reported: each
 one that was touching and whose shapes asked for contact events pushes an end-touch event, and
 because it is appended outside a step it surfaces in the batch the next step() fills, not in the
 one WorldId.contact_end_touch_events() returns beforehand. Silently does nothing while the world
 is locked, mid WorldId.step or inside a callback box3d runs during one.
*>
extern fn void JointId.set_collide_connected(self, bool should_collide) @cname("b3Joint_SetCollideConnected");

<*
 Whether the two linked bodies are allowed to collide. False on a joint built from a default
 definition, and that false is what suppresses the collision — see set_collide_connected.
*>
extern fn bool JointId.collide_connected(self) @cname("b3Joint_GetCollideConnected");

extern fn void JointId.set_user_data(self, void* user_data) @cname("b3Joint_SetUserData");
extern fn void* JointId.user_data(self) @cname("b3Joint_GetUserData");

<*
 Wakes both bodies this joint links, not only one — though two dynamic bodies a joint links share
 one island, so waking either of them wakes the other anyway. Silently does nothing while the
 world is locked, mid WorldId.step or inside a callback box3d runs during one.
*>
extern fn void JointId.wake_bodies(self) @cname("b3Joint_WakeBodies");

<*
 The force this joint is applying to hold its constraint, in newtons.

 box3d answers this and the three accessors that follow from a branch on the joint's own type, so
 a zero says nothing until it is read against that type. It can be a joint that is genuinely
 unloaded. It can be a channel the type never measures, which a parallel joint's force and a
 distance joint's torque both are however hard either joint is working. It can be a channel the
 type measures only in some of its states, which ordinary runtime setters turn on and off. And a
 wheel joint's angular separation is a case upstream has left unwritten, handed back as a zero
 rather than refused. A filter joint enforces nothing and reports zero from all four permanently,
 but it is one instance of the second reason, not the rule the other eight types follow.
*>
extern fn Vec3 JointId.constraint_force(self) @cname("b3Joint_GetConstraintForce");

<*
 The torque this joint is applying to hold its constraint, in newton-metres. A zero is read
 against the joint's type rather than taken for an idle joint — see constraint_force. A non-zero
 needs care too: some types double-count an axis here, the revolute joint's hinge axis among them,
 so a per-type torque getter such as RevoluteJointId.motor_torque() is the honest reading wherever
 one exists. Nor is it a pure getter on a revolute joint, where box3d writes the joint's two
 perpendicular warm-starting axes on the way past — a write the next substep recomputes from the
 same frames.
*>
extern fn Vec3 JointId.constraint_torque(self) @cname("b3Joint_GetConstraintTorque");

<*
 How far this joint is from the placement it holds its two bodies in, usually in metres. Some
 types measure the world-space distance between the two anchors, others the error left in the
 translation they constrain. A zero is read against the joint's type rather than taken for a
 joint resting where it wants to be — see constraint_force.
*>
extern fn float JointId.linear_separation(self) @cname("b3Joint_GetLinearSeparation");

<*
 How far this joint's two bodies have turned out of the relative orientation it holds them in,
 usually in radians. box3d builds this from the two body rotations and never reads the joint's
 anchors, so moving an anchor does not move the reading. A zero is read against the joint's type
 rather than taken for two bodies in alignment — see constraint_force.
*>
extern fn float JointId.angular_separation(self) @cname("b3Joint_GetAngularSeparation");

<*
 Retunes the soft constraint this joint is solved with, which box3d calls an advanced feature. A
 joint built from a default definition carries 60 hertz and a damping ratio of 2. box3d asserts
 both values are finite and non-negative; this package links a release build where that assertion
 is compiled out, and the wrappers do not restore it.

 @param hertz : "the stiffness in cycles per second"
 @param damping_ratio : "the non-dimensional damping ratio, one for critical damping"
*>
extern fn void JointId.set_constraint_tuning(self, float hertz, float damping_ratio) @cname("b3Joint_SetConstraintTuning");

<*
 Raw constraint tuning accessor. Private because it reports the pair through two out-parameters;
 box3d_joint.c3's JointId.constraint_tuning() returns them as one value.
*>
extern fn void constraint_tuning_raw(
  JointId joint_id,
  float* hertz,
  float* damping_ratio,
) @cname("b3Joint_GetConstraintTuning") @private;

<*
 Sets the force at which this joint starts appearing in WorldId.joint_events(), in newtons.

 One check covers both thresholds. It is armed only while at least one of the two is below
 float::max, so a joint whose thresholds both keep the default is never even checked. Being armed
 is not being reported: an armed joint is reported on the steps where its force reaches this
 threshold or its torque reaches the torque threshold, so a joint armed by a threshold it never
 reaches appears in no event, while a threshold of zero reports the joint on every step it is
 awake. The force compared against this threshold is a reaction force box3d computes inside the
 solve; it is not the value constraint_force() returns, which is a different per-type computation
 sharing the same unit. box3d asserts the value is finite and non-negative; this package links a
 release build where that assertion is compiled out, and the wrappers do not restore it.
*>
extern fn void JointId.set_force_threshold(self, float threshold) @cname("b3Joint_SetForceThreshold");

<*
 The force at which this joint starts appearing in WorldId.joint_events(), float::max on a joint
 built from a default definition.
*>
extern fn float JointId.force_threshold(self) @cname("b3Joint_GetForceThreshold");

<*
 Sets the torque at which this joint starts appearing in WorldId.joint_events(), in
 newton-metres. It shares one check with the force threshold, so the arming rule and the
 compiled-out assertion described on set_force_threshold govern this one too.
*>
extern fn void JointId.set_torque_threshold(self, float threshold) @cname("b3Joint_SetTorqueThreshold");

<*
 The torque at which this joint starts appearing in WorldId.joint_events(), float::max on a joint
 built from a default definition.
*>
extern fn float JointId.torque_threshold(self) @cname("b3Joint_GetTorqueThreshold");

<*
 The number of joints linked to this body. Exact, unlike the contact capacities, and it keeps
 counting while the world is locked: box3d reaches the world here without the locked check, the
 same exception shape_count() is, rather than reporting zero the way the contact and sensor
 capacities do.
*>
extern fn int BodyId.joint_count(self) @cname("b3Body_GetJointCount");

<*
 Raw body joint filler. Private because it reports its count through a return value;
 BodyId.joints() returns the filled prefix instead.
*>
extern fn int body_joints_raw(
  BodyId body_id,
  JointId* joint_array,
  int capacity,
) @cname("b3Body_GetJoints") @private;

<*
 A joint known to be revolute. box3d resolves every per-type accessor through a joint-type
 assertion this release build compiles out, so a revolute accessor reaching a joint of another
 type reinterprets that joint's solver union instead: a getter hands back nonsense and a setter
 writes over the other type's state. The distinct handle moves that check to the one place the
 type is genuinely in question. A RevoluteJointId converts to a JointId on its own, so every
 shared joint accessor reaches it uncast; the way back is JointId.as_revolute(), which checks.
*>
typedef RevoluteJointId = inline JointId;

<*
 A revolute joint definition. The joint fixes a point on body B to a point on body A and leaves
 the two free to turn about the z axis of their local frames, with an optional spring, limit and
 motor. Must come from default_revolute_joint_def(), which zeroes every field it adds to the
 base: no spring, no limit, no motor, and hertz, damping_ratio and max_motor_torque all 0 rather
 than the float::max thresholds the base defaults to. A default revolute joint is a bare hinge.

 Three of the angles are corrected on the way in rather than taken as written: target_angle is
 clamped into [-pi, pi], and lower_angle and upper_angle are swapped into order if they are
 reversed and then both clamped into [-0.99 pi, 0.99 pi] — the same correction set_limits applies
 at runtime. A joint's limits need not read back as the definition set them.
*>
struct RevoluteJointDef {
    inline JointDef base;
    float target_angle;
    bool enable_spring;
    float hertz;
    float damping_ratio;
    bool enable_limit;
    float lower_angle;
    float upper_angle;
    bool enable_motor;
    float max_motor_torque;
    float motor_speed;
}

extern fn RevoluteJointDef default_revolute_joint_def() @cname("b3DefaultRevoluteJointDef");

<*
 Raw revolute joint constructor. Bypasses WorldId.create_revolute_joint's definition guard and
 hands back a joint of no particular type, so it is private to the module —
 box3d_joint_revolute.c3's WorldId.create_revolute_joint is the only caller and is the only public
 way to a live revolute joint.
*>
extern fn JointId create_revolute_joint_raw(
  WorldId world_id,
  RevoluteJointDef* def,
) @cname("b3CreateRevoluteJoint") @private;

<*
 Enables or disables this joint's motor. A change to the flag discards the motor's accumulated
 impulse, so motor_torque() reads zero until the next step rather than the torque the motor was
 applying before.
*>
extern fn void RevoluteJointId.enable_motor(self, bool enable_motor) @cname("b3RevoluteJoint_EnableMotor");

<*
 Whether this joint's motor is enabled. False on a joint built from a default definition.
*>
extern fn bool RevoluteJointId.is_motor_enabled(self) @cname("b3RevoluteJoint_IsMotorEnabled");

<*
 Sets the speed the motor drives the hinge at, in radians per second about the z axis of the two
 local frames. It is a target the motor pursues only as far as max_motor_torque() lets it, not a
 speed the hinge is made to hold. box3d asserts the value is finite and nothing further — a
 negative speed drives the hinge the other way; this package links a release build where that
 assertion is compiled out, and the wrappers do not restore it.
*>
extern fn void RevoluteJointId.set_motor_speed(self, float motor_speed) @cname("b3RevoluteJoint_SetMotorSpeed");

<*
 The speed the motor drives the hinge at, in radians per second. What was set, not what the hinge
 is turning at.
*>
extern fn float RevoluteJointId.motor_speed(self) @cname("b3RevoluteJoint_GetMotorSpeed");

<*
 The torque the motor applied over the last step, in newton-metres, bounded by
 max_motor_torque(). This is the honest reading of the two available. The shared
 constraint_torque() double-counts the hinge axis: box3d adds the joint's axial impulse — spring
 plus motor plus limit — along the frame z axis and then, under a note leaving pivot torque
 unwritten, adds that identical quantity along the same axis a second time. On a joint with no
 spring and no limit that makes constraint_torque() report exactly twice this value about the
 hinge axis.
*>
extern fn float RevoluteJointId.motor_torque(self) @cname("b3RevoluteJoint_GetMotorTorque");

<*
 Sets the largest torque the motor may apply, in newton-metres. 0 on a joint built from a default
 definition, which leaves an enabled motor unable to turn anything. box3d asserts the value is
 finite and non-negative; this package links a release build where that assertion is compiled
 out, and the wrappers do not restore it.
*>
extern fn void RevoluteJointId.set_max_motor_torque(self, float torque) @cname("b3RevoluteJoint_SetMaxMotorTorque");

<*
 The largest torque the motor may apply, in newton-metres.
*>
extern fn float RevoluteJointId.max_motor_torque(self) @cname("b3RevoluteJoint_GetMaxMotorTorque");

<*
 The hinge angle in radians: the twist about the frames' z axis of body B's local frame relative
 to body A's, kept in [-pi, pi]. It is measured from the alignment of those two frames and from
 nothing else — not from target_angle, and not from any reference angle, whatever box3d's header
 comment on this function says. The sign follows the frame z axis, so a positive motor speed
 drives the angle positive.
*>
extern fn float RevoluteJointId.angle(self) @cname("b3RevoluteJoint_GetAngle");

<*
 Enables or disables this joint's limit. A change to the flag discards the limit's accumulated
 impulses, so a limit switched back on rebuilds its hold over the following steps rather than
 resuming the one it had.
*>
extern fn void RevoluteJointId.enable_limit(self, bool enable_limit) @cname("b3RevoluteJoint_EnableLimit");

<*
 Whether this joint's limit is enabled. False on a joint built from a default definition. While it
 is off — and while it is on but not exceeded — the shared angular_separation() strips the hinge
 angle out of the relative rotation and reports what is left of the misalignment, which is zero for
 a hinge whose perpendicular constraint is holding and non-zero for one bent off its axis under
 load. Once the limit is on and the angle is past it the full relative rotation is reported
 instead, which is the state-dependent zero JointId.constraint_force describes rather than a
 permanent one.
*>
extern fn bool RevoluteJointId.is_limit_enabled(self) @cname("b3RevoluteJoint_IsLimitEnabled");

<*
 The low end of the angle the limit holds the hinge above, in radians about the frames' z axis. It
 is what box3d stored, not what it was handed: see set_limits. 0 on a joint built from a default
 definition.
*>
extern fn float RevoluteJointId.lower_limit(self) @cname("b3RevoluteJoint_GetLowerLimit");

<*
 The high end of the angle the limit holds the hinge below, in radians about the frames' z axis. It
 is what box3d stored, not what it was handed: see set_limits. 0 on a joint built from a default
 definition.
*>
extern fn float RevoluteJointId.upper_limit(self) @cname("b3RevoluteJoint_GetUpperLimit");

<*
 Sets the two angles in radians the limit holds the hinge between. box3d takes the smaller of the
 pair as the lower and the larger as the upper, so a reversed pair is quietly corrected rather than
 refused, and then clamps both into [-0.99 pi, 0.99 pi]. A wrapper faulting on a reversed pair would
 contradict the library, so the binding documents the swap instead of guarding it. The limit acts
 only while enable_limit() is on. box3d asserts both values are finite — their order and their
 range it corrects rather than asserts; this package links a release build where that assertion is
 compiled out, and the wrappers do not restore it.
*>
extern fn void RevoluteJointId.set_limits(self, float lower_radians, float upper_radians) @cname("b3RevoluteJoint_SetLimits");

<*
 Enables or disables this joint's angular spring. A change to the flag discards the spring's
 accumulated impulse, so a spring switched back on rebuilds its pull over the following steps
 rather than resuming the one it had.
*>
extern fn void RevoluteJointId.enable_spring(self, bool enable_spring) @cname("b3RevoluteJoint_EnableSpring");

<*
 Whether this joint's angular spring is enabled. False on a joint built from a default definition.
*>
extern fn bool RevoluteJointId.is_spring_enabled(self) @cname("b3RevoluteJoint_IsSpringEnabled");

<*
 Sets the spring's stiffness in hertz. 0 on a joint built from a default definition, which leaves
 an enabled spring pulling on nothing. box3d asserts the value is finite and non-negative; this
 package links a release build where that assertion is compiled out, and the wrappers do not
 restore it.
*>
extern fn void RevoluteJointId.set_spring_hertz(self, float hertz) @cname("b3RevoluteJoint_SetSpringHertz");

<*
 The spring's stiffness in hertz.
*>
extern fn float RevoluteJointId.spring_hertz(self) @cname("b3RevoluteJoint_GetSpringHertz");

<*
 Sets the spring's damping ratio, non-dimensional: 1 settles the hinge on its target without
 overshooting it. box3d asserts the value is finite and non-negative under the same compiled-out
 assertion set_spring_hertz describes.
*>
extern fn void RevoluteJointId.set_spring_damping_ratio(self, float damping_ratio) @cname("b3RevoluteJoint_SetSpringDampingRatio");

<*
 The spring's damping ratio, non-dimensional.
*>
extern fn float RevoluteJointId.spring_damping_ratio(self) @cname("b3RevoluteJoint_GetSpringDampingRatio");

<*
 Sets the spring's rest angle in radians about the frames' z axis: the angle the spring pulls the
 hinge toward while enable_spring() is on. The spring is the only thing box3d reads it for, and
 angle() in particular is not measured against it — angle() is the twist between the two local
 frames and carries no target term, so a hinge a spring has settled on a target of 0.7 reads 0.7.

 The value is stored as handed. box3d clamps a definition's target_angle into [-pi, pi] on the way
 through the constructor but this setter only asserts that the value is finite and inside the same
 range, and this package links a release build where that assertion is compiled out — a target set
 here can sit outside the range the same target in a definition would have been clamped into.
*>
extern fn void RevoluteJointId.set_target_angle(self, float target_radians) @cname("b3RevoluteJoint_SetTargetAngle");

<*
 The spring's rest angle in radians. 0 on a joint built from a default definition. What box3d
 stored, which is the definition's value clamped into [-pi, pi] or the setter's value unclamped:
 see set_target_angle.
*>
extern fn float RevoluteJointId.target_angle(self) @cname("b3RevoluteJoint_GetTargetAngle");

<*
 A joint known to be a distance joint. box3d resolves every per-type accessor through a joint-type
 assertion this release build compiles out, so a distance accessor reaching a joint of another
 type reinterprets that joint's solver union instead: a getter hands back nonsense and a setter
 writes over the other type's state. The distinct handle moves that check to the one place the
 type is genuinely in question. A DistanceJointId converts to a JointId on its own, so every
 shared joint accessor reaches it uncast; the way back is JointId.as_distance(), which checks.
*>
typedef DistanceJointId = inline JointId;

<*
 A distance joint definition. The joint connects a point on body A to a point on body B by a
 segment held at length, with an optional spring, limit and motor. Must come from
 default_distance_joint_def(), which — unlike the revolute default — does not zero the fields it
 adds to the base: length is 1, lower_spring_force is -float::max, upper_spring_force is
 float::max, and max_length is box3d's huge value, 1.0e5 scaled by the length unit. The remaining
 fields are zero or false.

 A default distance joint is rigid, and it stays rigid under more settings than the header
 describes. box3d solves the spring, the limit and the motor together only while
 enable_spring && (min_length < max_length || enable_limit == false); otherwise it solves a single
 rigid constraint and skips the limit and the motor entirely. So a sprung joint whose limit is
 enabled with min_length equal to max_length is rigid, and clearing enable_limit on that same
 joint makes it sprung again.
*>
struct DistanceJointDef {
    inline JointDef base;
    float length;
    bool enable_spring;
    float lower_spring_force;
    float upper_spring_force;
    float hertz;
    float damping_ratio;
    bool enable_limit;
    float min_length;
    float max_length;
    bool enable_motor;
    float max_motor_force;
    float motor_speed;
}

<*
 The range a distance joint's spring force is held between. This is a C3 type with no C
 counterpart: box3d reports the pair through two out-parameters.
*>
struct SpringForceRange {
    float lower;
    float upper;
}

extern fn DistanceJointDef default_distance_joint_def() @cname("b3DefaultDistanceJointDef");

<*
 Raw distance joint constructor. Bypasses WorldId.create_distance_joint's definition guard and
 hands back a joint of no particular type, so it is private to the module —
 box3d_joint_distance.c3's WorldId.create_distance_joint is the only caller and is the only public
 way to a live distance joint.
*>
extern fn JointId create_distance_joint_raw(
  WorldId world_id,
  DistanceJointDef* def,
) @cname("b3CreateDistanceJoint") @private;

<*
 Sets the rest length this joint holds its two anchors at. Not the distance they are at now,
 which is what current_length() reads.

 The value is clamped between box3d's linear slop and its huge value, neither of which is a fixed
 number: the floor is 0.005 length units and the ceiling 1.0e5 of them, so a floor of 0.005 at
 unit scale becomes 0.010 once the length unit is 2. The clamp is silent — length() reports what
 was stored, not what was asked for. Setting the length also zeroes the joint's three accumulated
 impulses, discarding the warm-start state the solver had built, so the joint rebuilds its hold
 over the following steps rather than resuming the one it had.
*>
extern fn void DistanceJointId.set_length(self, float length) @cname("b3DistanceJoint_SetLength");

<*
 The rest length this joint holds its two anchors at. Not the distance the anchors are at now,
 which is what current_length() reads — even a rigid joint sits a little off its rest length, by
 the residual the solver leaves. Both are plain floats, so either one compiles where the other is
 meant.

 It is what box3d stored, and the two paths that store it disagree at both ends. Construction
 raises the definition's length to the linear slop and gives it no ceiling at all, so a
 definition's 0 arrives as 0.005 length units while a definition's 1.0e7 arrives untouched — and
 a zero or negative definition length is not refused on the way, because the check that would
 have refused it is compiled out of this release build. set_length clamps instead, between that
 same floor and box3d's huge value of 1.0e5 scaled by the length unit, so the very length a
 definition keeps comes back from the setter cut down to 1.0e5 length units.
*>
extern fn float DistanceJointId.length(self) @cname("b3DistanceJoint_GetLength");

<*
 The distance between this joint's two anchors as they stand now, measured from the two bodies'
 current transforms. Not the rest length the joint holds them at, which is what length() reads.

 The reading is meaningful whether the joint is rigid or sprung, and it is how the two are told
 apart: a rigid joint keeps this within a hair of its rest length and a sprung one does not.
 Which of the two a joint is follows the compound condition DistanceJointDef describes, not the
 spring flag on its own. Zero while the world is locked, mid WorldId.step or inside a callback
 box3d runs during one.
*>
extern fn float DistanceJointId.current_length(self) @cname("b3DistanceJoint_GetCurrentLength");

<*
 Enables or disables this joint's limit, which holds the anchors' separation between min_length
 and max_length. box3d reaches the limit only inside the branch it solves the spring in, so the
 flag acts under the compound condition DistanceJointDef describes rather than on its own:
 enabling it on a joint whose spring is off changes nothing, and enabling it with min_length equal
 to max_length turns the joint rigid rather than tightening it, because that is the other half of
 the same condition.

 Unlike the revolute joint's flag of the same name, this one leaves the joint's accumulated
 impulses alone.
*>
extern fn void DistanceJointId.enable_limit(self, bool enable_limit) @cname("b3DistanceJoint_EnableLimit");

<*
 Whether this joint's limit is enabled. False on a joint built from a default definition. The flag
 is stored whatever the rest of the joint is set to, so a true reading says the limit was asked
 for and not that it is acting: whether the solver reaches the limit at all follows the compound
 condition DistanceJointDef describes.
*>
extern fn bool DistanceJointId.is_limit_enabled(self) @cname("b3DistanceJoint_IsLimitEnabled");

<*
 Sets the two lengths the limit holds the anchors' separation between. box3d clamps each of the
 pair between its linear slop and its huge value — 0.005 length units and 1.0e5 of them, so the
 floor is 0.010 once the length unit is 2 — and then stores the smaller of the clamped pair as the
 minimum and the larger as the maximum. A reversed pair is accepted and quietly corrected rather
 than refused, and a pair under the floor comes back as two equal lengths. Both corrections are
 silent: min_length() and max_length() report what was stored, not what was asked for.

 The clamp and the swap are this setter's own, and none of the joint's three range setters agrees
 with another: set_length clamps its single value and has nothing to order, and the setter for the
 spring's force range neither clamps nor orders its pair. Read each rather than carrying one over.

 Setting the range also zeroes the joint's three accumulated impulses, discarding the warm-start
 state the solver had built, so the joint rebuilds its hold over the following steps rather than
 resuming the one it had.
*>
extern fn void DistanceJointId.set_length_range(self, float min_length, float max_length) @cname("b3DistanceJoint_SetLengthRange");

<*
 The low end of the separation the limit holds the anchors above. It is what box3d stored, not
 what it was handed: see set_length_range. On a joint fresh from its definition it is neither,
 because construction is its own path — it raises the definition's min_length to the linear slop
 and applies none of the setter's ceiling, so a default definition's 0 arrives as 0.005 length
 units.
*>
extern fn float DistanceJointId.min_length(self) @cname("b3DistanceJoint_GetMinLength");

<*
 The high end of the separation the limit holds the anchors below. It is what box3d stored, not
 what it was handed: see set_length_range. On a joint fresh from its definition it is the larger
 of the definition's two lengths and nothing else — no floor, no ceiling — so a default
 definition's max_length, box3d's huge value of 1.0e5 scaled by the length unit, arrives
 unchanged, while a definition whose max_length is under the slop leaves this reading below
 min_length().
*>
extern fn float DistanceJointId.max_length(self) @cname("b3DistanceJoint_GetMaxLength");

<*
 Enables or disables this joint's spring, and with it every part of the joint the solver reaches
 through the spring: box3d solves the spring, the limit and the motor together inside one branch,
 and its other half is a single rigid constraint. So this is the joint's master switch rather than
 the spring's alone — enabling the limit or the motor on a joint whose spring is off changes
 nothing — and it is not the only way into the rigid half. The whole condition is the one
 DistanceJointDef describes.

 Unlike the revolute joint's flag of the same name, this one leaves the joint's accumulated
 impulses alone.
*>
extern fn void DistanceJointId.enable_spring(self, bool enable_spring) @cname("b3DistanceJoint_EnableSpring");

<*
 Whether this joint's spring is enabled. False on a joint built from a default definition. The
 flag is stored whatever the rest of the joint is set to, so a true reading says the spring was
 asked for and not that the joint is sprung: the other half of the condition DistanceJointDef
 describes can still send it down the rigid branch.
*>
extern fn bool DistanceJointId.is_spring_enabled(self) @cname("b3DistanceJoint_IsSpringEnabled");

<*
 Sets the spring's stiffness in hertz. 0 on a joint built from a default definition, and box3d
 solves the spring only while this is above 0, so an enabled spring left at the default pulls on
 nothing — the joint still takes the sprung branch and its limit and motor still act, but the
 spring itself contributes no impulse.

 Unlike the revolute joint's setter of the same name, this one asserts nothing at all, so a
 negative or non-finite stiffness is not even checked in a build that keeps box3d's assertions.
*>
extern fn void DistanceJointId.set_spring_hertz(self, float hertz) @cname("b3DistanceJoint_SetSpringHertz");

<*
 The spring's stiffness in hertz.
*>
extern fn float DistanceJointId.spring_hertz(self) @cname("b3DistanceJoint_GetSpringHertz");

<*
 Sets the spring's damping ratio, non-dimensional: 1 settles the joint on its rest length without
 overshooting it. 0 on a joint built from a default definition. Asserts nothing, the same absence
 set_spring_hertz describes.
*>
extern fn void DistanceJointId.set_spring_damping_ratio(self, float damping_ratio) @cname("b3DistanceJoint_SetSpringDampingRatio");

<*
 The spring's damping ratio, non-dimensional.
*>
extern fn float DistanceJointId.spring_damping_ratio(self) @cname("b3DistanceJoint_GetSpringDampingRatio");

<*
 Sets the two forces the spring's pull is held between, in newtons: -float::max and float::max on
 a joint built from a default definition, which leaves it unbounded either way. box3d holds the
 spring's accumulated impulse between the pair scaled by the sub-step, and only inside the branch
 it solves the spring in, so the range acts under the compound condition DistanceJointDef
 describes and only while spring_hertz() is above 0.

 This setter neither clamps its pair nor orders it. It asserts that the lower force does not
 exceed the upper and stores both verbatim; this package links a release build where that
 assertion is compiled out, so an inverted pair is accepted in full and spring_force_range()
 reports it back the way it arrived. That is the opposite of set_length_range, which clamps both
 ends and swaps them into order, and the two sit one accessor apart — neither the clamp nor the
 swap carries over. An inverted range is not inert either: box3d clamps against it as stored.
*>
extern fn void DistanceJointId.set_spring_force_range(self, float lower_force, float upper_force) @cname("b3DistanceJoint_SetSpringForceRange");

<*
 Raw spring force range accessor. Private because it reports the pair through two out-parameters;
 box3d_joint_distance.c3's DistanceJointId.spring_force_range() returns them as one value.
*>
extern fn void spring_force_range_raw(
  DistanceJointId joint_id,
  float* lower_force,
  float* upper_force,
) @cname("b3DistanceJoint_GetSpringForceRange") @private;

<*
 Enables or disables this joint's motor, which drives the two anchors apart at motor_speed() with
 at most max_motor_force() behind it. box3d reaches the motor only inside the branch it solves the
 spring in, so the flag acts under the compound condition DistanceJointDef describes rather than
 on its own: on a joint whose spring is off an enabled motor drives nothing at all, whatever speed
 and force it carries, and the joint holds its rest length as though the motor were not there.

 A change to the flag discards the motor's accumulated impulse, so motor_force() reads zero until
 the next step rather than the force the motor was applying before. Storing the value the flag
 already holds discards nothing. This one does match the revolute joint's flag of the same name,
 unlike the spring and limit flags beside it.
*>
extern fn void DistanceJointId.enable_motor(self, bool enable_motor) @cname("b3DistanceJoint_EnableMotor");

<*
 Whether this joint's motor is enabled. False on a joint built from a default definition. The flag
 is stored whatever the rest of the joint is set to, so a true reading says the motor was asked
 for and not that it is driving anything: whether the solver reaches the motor at all follows the
 compound condition DistanceJointDef describes.
*>
extern fn bool DistanceJointId.is_motor_enabled(self) @cname("b3DistanceJoint_IsMotorEnabled");

<*
 Sets the speed the motor drives the two anchors apart at, in metres per second along the segment
 between them: a positive speed lengthens the joint and a negative one shortens it. It is a target
 the motor pursues only as far as max_motor_force() lets it, not a separation speed the joint is
 made to hold, and the solver pursues it only under the compound condition DistanceJointDef
 describes.

 Unlike the revolute joint's setter of the same name, which asserts the value is finite, this one
 asserts nothing at all. It stores the speed and leaves the motor's accumulated impulse as it
 stands.
*>
extern fn void DistanceJointId.set_motor_speed(self, float motor_speed) @cname("b3DistanceJoint_SetMotorSpeed");

<*
 The speed the motor drives the two anchors apart at, in metres per second. What was set, not what
 the anchors are separating at.
*>
extern fn float DistanceJointId.motor_speed(self) @cname("b3DistanceJoint_GetMotorSpeed");

<*
 Sets the largest force the motor may apply, in newtons. 0 on a joint built from a default
 definition, which leaves an enabled motor unable to move anything. box3d holds the motor's
 accumulated impulse between this force scaled by the sub-step either way, so a motor asked for
 more speed than that force buys settles at exactly this reading.

 Unlike the revolute joint's setter of the same shape, which asserts the value is finite and
 non-negative, this one asserts nothing at all. It stores the ceiling and leaves the motor's
 accumulated impulse as it stands, so motor_force() reports the force from the last step until
 another one is taken under the new ceiling.
*>
extern fn void DistanceJointId.set_max_motor_force(self, float force) @cname("b3DistanceJoint_SetMaxMotorForce");

<*
 The largest force the motor may apply, in newtons.
*>
extern fn float DistanceJointId.max_motor_force(self) @cname("b3DistanceJoint_GetMaxMotorForce");

<*
 The force the motor applied over the last step, in newtons, bounded by max_motor_force() either
 way: a motor asked for more speed than its ceiling buys reads exactly that ceiling. Zero on a
 joint the solver has only ever taken the rigid branch for, whatever speed and ceiling the motor
 carries. That branch leaves the motor's impulse untouched rather than clearing it, so a joint
 driven while it was sprung goes on reporting the last force its motor applied once it is made
 rigid.

 This is the motor's own share, where the shared constraint_force() is the whole joint's: box3d
 sums the spring's impulse, the two limit impulses and the motor's once each and lays the total
 along the segment between the anchors. So the shared reading carries this force exactly once —
 not twice, the way the revolute joint's constraint_torque() carries its motor torque — and the
 two agree only while the spring and the limit contribute nothing. Against a working spring they
 disagree by however hard the spring pulls back, which is no fixed relation at all: a motor held
 at 100 newtons against a spring holding the joint on its rest length leaves constraint_force()
 reporting under 2.
*>
extern fn float DistanceJointId.motor_force(self) @cname("b3DistanceJoint_GetMotorForce");

<*
 A joint known to be prismatic. box3d resolves every per-type accessor through a joint-type
 assertion this release build compiles out, so a prismatic accessor reaching a joint of another
 type reinterprets that joint's solver union instead: a getter hands back nonsense and a setter
 writes over the other type's state. The distinct handle moves that check to the one place the
 type is genuinely in question. A PrismaticJointId converts to a JointId on its own, so every
 shared joint accessor reaches it uncast; the way back is JointId.as_prismatic(), which checks.
*>
typedef PrismaticJointId = inline JointId;

<*
 A prismatic joint definition. The joint lets body B slide along the x axis of local frame A and
 leaves it no rotation at all relative to body A — a slider, where the revolute joint is a hinge
 about z. The translation the joint measures is zero where the two local frame origins coincide
 in world space. An optional spring, limit and motor act along that one axis. Must come from
 default_prismatic_joint_def(), which zeroes every field it adds to the base: no spring, no
 limit, no motor, and hertz, damping_ratio and max_motor_force all 0 rather than the float::max
 thresholds the base defaults to. A default prismatic joint is a bare slider.

 The two translations are stored as the definition wrote them, where the revolute constructor
 swaps a reversed pair of angles into order: box3d asserts the pair is ordered instead, and this
 release build compiles that assertion out, so a definition whose lower translation is above its
 upper one is accepted and kept that way round.
*>
struct PrismaticJointDef {
    inline JointDef base;
    bool enable_spring;
    float hertz;
    float damping_ratio;
    float target_translation;
    bool enable_limit;
    float lower_translation;
    float upper_translation;
    bool enable_motor;
    float max_motor_force;
    float motor_speed;
}

extern fn PrismaticJointDef default_prismatic_joint_def() @cname("b3DefaultPrismaticJointDef");

<*
 Raw prismatic joint constructor. Bypasses WorldId.create_prismatic_joint's definition guard and
 hands back a joint of no particular type, so it is private to the module —
 box3d_joint_prismatic.c3's WorldId.create_prismatic_joint is the only caller and is the only
 public way to a live prismatic joint.
*>
extern fn JointId create_prismatic_joint_raw(
  WorldId world_id,
  PrismaticJointDef* def,
) @cname("b3CreatePrismaticJoint") @private;

<*
 The slider's translation in metres: the offset between the two local frame origins in world
 space, resolved onto local frame A's x axis. Zero where those two origins coincide, whatever
 the bodies' own positions are. box3d's comment on this joint's constraint derivation names the
 z axis instead; the code rotates the x axis, and the joint follows the code.
*>
extern fn float PrismaticJointId.translation(self) @cname("b3PrismaticJoint_GetTranslation");

<*
 The rate of change of translation(), in metres per second: the two bodies' relative velocity at
 the joint anchors resolved onto the same axis, plus the term for that axis turning with body A.
 A body with no solver state — a static one, or a sleeping one — contributes zero velocity
 rather than being left out, so against a static anchor this is body B's own speed along the axis.
*>
extern fn float PrismaticJointId.speed(self) @cname("b3PrismaticJoint_GetSpeed");

<*
 Enables or disables this joint's limit. A change to the flag discards the limit's accumulated
 impulses, so a limit switched back on rebuilds its hold over the following steps rather than
 resuming the one it had. set_limits discards nothing.
*>
extern fn void PrismaticJointId.enable_limit(self, bool enable_limit) @cname("b3PrismaticJoint_EnableLimit");

<*
 Whether this joint's limit is enabled. False on a joint built from a default definition. The two
 translations are stored either way; they hold the slider only while this is on.
*>
extern fn bool PrismaticJointId.is_limit_enabled(self) @cname("b3PrismaticJoint_IsLimitEnabled");

<*
 The low end of the translation the limit holds the slider above, in metres along local frame A's
 x axis. It is what box3d stored, and which of the two paths stored it matters: see set_limits.
 0 on a joint built from a default definition.
*>
extern fn float PrismaticJointId.lower_limit(self) @cname("b3PrismaticJoint_GetLowerLimit");

<*
 The high end of the translation the limit holds the slider below, in metres along local frame A's
 x axis. It is what box3d stored, and which of the two paths stored it matters: see set_limits.
 0 on a joint built from a default definition.
*>
extern fn float PrismaticJointId.upper_limit(self) @cname("b3PrismaticJoint_GetUpperLimit");

<*
 Sets the two translations in metres the limit holds the slider between. box3d takes the smaller
 of the pair as the lower and the larger as the upper, so a reversed pair is quietly corrected
 rather than refused — and it stops there: neither end is bounded, where the revolute joint's
 identically named set_limits clamps its swapped pair into [-0.99 pi, 0.99 pi] and the distance
 joint's set_length_range clamps both ends of its own. This is also where the setter and the
 constructor part company: PrismaticJointDef's two translations are stored as the definition
 wrote them, reversed pair and all, so the pair that stays reversed through construction comes
 back ordered through here. The limit acts only while enable_limit() is on. box3d asserts both
 values are finite; this package links a release build where that assertion is compiled out, and
 the wrappers do not restore it.
*>
extern fn void PrismaticJointId.set_limits(self, float lower, float upper) @cname("b3PrismaticJoint_SetLimits");

<*
 Enables or disables this joint's spring. A change to the flag discards the spring's accumulated
 impulse, so a spring switched back on rebuilds its pull over the following steps rather than
 resuming the one it had. This joint's enable_limit does the same to its own two impulses, where
 the distance joint's two identically named flags discard nothing.
*>
extern fn void PrismaticJointId.enable_spring(self, bool enable_spring) @cname("b3PrismaticJoint_EnableSpring");

<*
 Whether this joint's spring is enabled. False on a joint built from a default definition.
*>
extern fn bool PrismaticJointId.is_spring_enabled(self) @cname("b3PrismaticJoint_IsSpringEnabled");

<*
 Sets the spring's stiffness in hertz. 0 on a joint built from a default definition, which leaves
 an enabled spring pulling on nothing. box3d asserts the value is finite and non-negative; this
 package links a release build where that assertion is compiled out, and the wrappers do not
 restore it.
*>
extern fn void PrismaticJointId.set_spring_hertz(self, float hertz) @cname("b3PrismaticJoint_SetSpringHertz");

<*
 The spring's stiffness in hertz.
*>
extern fn float PrismaticJointId.spring_hertz(self) @cname("b3PrismaticJoint_GetSpringHertz");

<*
 Sets the spring's damping ratio, non-dimensional: 1 settles the slider on its target without
 overshooting it. box3d asserts the value is finite and non-negative under the same compiled-out
 assertion set_spring_hertz describes.
*>
extern fn void PrismaticJointId.set_spring_damping_ratio(self, float damping_ratio) @cname("b3PrismaticJoint_SetSpringDampingRatio");

<*
 The spring's damping ratio, non-dimensional.
*>
extern fn float PrismaticJointId.spring_damping_ratio(self) @cname("b3PrismaticJoint_GetSpringDampingRatio");

<*
 Sets the spring's rest translation in metres along local frame A's x axis: the translation the
 spring pulls the slider toward while enable_spring() is on. The spring is the only thing box3d
 reads it for, and translation() in particular is not measured against it — translation() is the
 offset between the two local frame origins and carries no target term, so a slider a spring has
 settled on a target of 0.7 reads 0.7.

 The value is stored as handed and the limit, if it is on, still holds the slider inside its own
 pair, so a target outside that pair is pulled toward rather than reached. box3d asserts only
 that the value is finite, and PrismaticJointDef's target_translation goes through construction
 the same way — the two paths agree here, where the revolute joint's clamp their target angle in
 the constructor and leave it alone in the setter. This package links a release build where that
 assertion is compiled out, and the wrappers do not restore it.
*>
extern fn void PrismaticJointId.set_target_translation(self, float target_translation) @cname("b3PrismaticJoint_SetTargetTranslation");

<*
 The spring's rest translation in metres. 0 on a joint built from a default definition. What the
 definition or the setter handed box3d, neither path having bounded it.
*>
extern fn float PrismaticJointId.target_translation(self) @cname("b3PrismaticJoint_GetTargetTranslation");

<*
 Enables or disables this joint's motor. A change to the flag discards the motor's accumulated
 impulse, so motor_force() reads zero until the next step rather than the force the motor was
 applying before.
*>
extern fn void PrismaticJointId.enable_motor(self, bool enable_motor) @cname("b3PrismaticJoint_EnableMotor");

<*
 Whether this joint's motor is enabled. False on a joint built from a default definition.
*>
extern fn bool PrismaticJointId.is_motor_enabled(self) @cname("b3PrismaticJoint_IsMotorEnabled");

<*
 Sets the speed the motor drives the slider at, in metres per second along local frame A's x
 axis. It is a target the motor pursues only as far as max_motor_force() lets it, not a speed the
 slider is made to hold. box3d asserts the value is finite and nothing further — a negative speed
 drives the slider the other way; this package links a release build where that assertion is
 compiled out, and the wrappers do not restore it.
*>
extern fn void PrismaticJointId.set_motor_speed(self, float motor_speed) @cname("b3PrismaticJoint_SetMotorSpeed");

<*
 The speed the motor drives the slider at, in metres per second. What was set, not what the
 slider is moving at: speed() is that.
*>
extern fn float PrismaticJointId.motor_speed(self) @cname("b3PrismaticJoint_GetMotorSpeed");

<*
 Sets the largest force the motor may apply, in newtons. 0 on a joint built from a default
 definition, which leaves an enabled motor unable to move anything. box3d asserts the value is
 finite and non-negative; this package links a release build where that assertion is compiled
 out, and the wrappers do not restore it.
*>
extern fn void PrismaticJointId.set_max_motor_force(self, float force) @cname("b3PrismaticJoint_SetMaxMotorForce");

<*
 The largest force the motor may apply, in newtons.
*>
extern fn float PrismaticJointId.max_motor_force(self) @cname("b3PrismaticJoint_GetMaxMotorForce");

<*
 The force the motor applied over the last step, in newtons, bounded by max_motor_force(). This is
 the honest reading: on this type the shared constraint_force() is wrong in both its direction and
 its magnitude, and the shared constraint_torque() is wrong in its direction as well.

 The force vector is a full cyclic permutation of its three components, not merely the axial term
 laid on the wrong axis. box3d assembles the joint-space impulse as the two perpendicular terms
 followed by the axial one, where local frame A's basis carries the axial term first, so every
 component lands one slot over: the transverse reaction the slider is really carrying comes back
 along the frame's x axis, which is the one direction the slider leaves free. On identity frames
 under gravity along -y, the whole of a hanging body's weight reads on world x.

 The magnitude is wrong whenever a limit opposes a motor or a spring. box3d adds the lower and the
 upper limit impulse where the joint's own warm start subtracts the upper from the lower, so an
 opposed pair sums instead of cancelling: a motor at a 25 newton ceiling driven into its own limit
 reports 50 newtons of constraint force while the body is stationary and the net axial force is
 zero. With no limit live the axial sum is honest, each impulse counted once rather than twice the
 way the revolute joint's constraint_torque() counts its own.

 The shared constraint_torque() is double-rotated. box3d accumulates this joint's angular impulse
 in world space and then rotates it by local frame A and again by body A's transform, a chain
 copied from the force accessor, which legitimately needs it. The magnitude survives; the direction
 does not, as soon as either body A or local frame A is off identity. The weld joint's torque
 applies no rotation and is right, so this is a bug in one type rather than a convention to carry
 across them.
*>
extern fn float PrismaticJointId.motor_force(self) @cname("b3PrismaticJoint_GetMotorForce");

<*
 A joint known to be a weld joint. box3d resolves every per-type accessor through a joint-type
 assertion this release build compiles out, so a weld accessor reaching a joint of another type
 reinterprets that joint's solver union instead: a getter hands back nonsense and a setter writes
 over the other type's state. The distinct handle moves that check to the one place the type is
 genuinely in question. A WeldJointId converts to a JointId on its own, so every shared joint
 accessor reaches it uncast; the way back is JointId.as_weld(), which checks.
*>
typedef WeldJointId = inline JointId;

<*
 A weld joint definition. The joint holds the two bodies at the relative transform their local
 frames describe, with one spring over the translation and another over the rotation. Must come
 from default_weld_joint_def(), which zeroes all four fields it adds to the base.

 Zero hertz means rigid here rather than "no spring", which inverts the reading every other
 sprung joint type invites: box3d solves a channel with the joint's own constraint softness while
 its hertz is exactly 0 and builds a soft spring at any other value, so raising linear_hertz off 0
 makes the weld sag where raising a distance joint's hertz makes it firmer. The two channels are
 tested separately, so one may be rigid while the other is soft.

 box3d asserts all four fields are at or above 0 and this release build compiles that assertion
 out, so a negative or NaN value is stored verbatim. A negative hertz is where the two halves of
 the solver part company: the prepare step tests for exactly 0, so it builds a soft spring out of
 the negative value, while the solve's bias gate tests for above 0 and so does not engage that
 spring on its own.
*>
struct WeldJointDef {
    inline JointDef base;
    float linear_hertz;
    float angular_hertz;
    float linear_damping_ratio;
    float angular_damping_ratio;
}

extern fn WeldJointDef default_weld_joint_def() @cname("b3DefaultWeldJointDef");

<*
 Raw weld joint constructor. Bypasses WorldId.create_weld_joint's definition guard and hands back
 a joint of no particular type, so it is private to the module — box3d_joint_weld.c3's
 WorldId.create_weld_joint is the only caller and is the only public way to a live weld joint.
*>
extern fn JointId create_weld_joint_raw(
  WorldId world_id,
  WeldJointDef* def,
) @cname("b3CreateWeldJoint") @private;

<*
 Sets the stiffness in hertz of the spring over the two bodies' relative translation. 0 on a joint
 built from a default definition, where it asks for a rigid channel rather than an absent spring,
 as WeldJointDef describes. The value is stored as handed: nothing is clamped, and the joint's
 accumulated impulses stand rather than being discarded the way a prismatic joint's flags discard
 theirs.

 box3d asserts the value is finite and at or above 0, and this package links a release build where
 that assertion is compiled out. A negative value is where the two halves of the solver part
 company: the prepare step tests for exactly 0, so it builds a spring out of the negative number,
 while the solve engages that spring of its own accord only above 0 and otherwise leaves it to the
 passes that already carry bias.
*>
extern fn void WeldJointId.set_linear_hertz(self, float hertz) @cname("b3WeldJoint_SetLinearHertz");

<*
 The stiffness in hertz of the spring over the two bodies' relative translation. 0 on a joint built
 from a default definition, and 0 is this joint's rigid setting rather than its softest.
*>
extern fn float WeldJointId.linear_hertz(self) @cname("b3WeldJoint_GetLinearHertz");

<*
 Sets the damping ratio of the spring over the two bodies' relative translation, non-dimensional.
 box3d reads it only while linear_hertz() is away from 0, the channel otherwise being solved with
 the joint's own constraint tuning, which carries a damping ratio of its own. Asserted finite and
 at or above 0 under the same compiled-out assertion set_linear_hertz describes, and stored as
 handed.
*>
extern fn void WeldJointId.set_linear_damping_ratio(self, float damping_ratio) @cname("b3WeldJoint_SetLinearDampingRatio");

<*
 The damping ratio of the spring over the two bodies' relative translation, non-dimensional. 0 on
 a joint built from a default definition.
*>
extern fn float WeldJointId.linear_damping_ratio(self) @cname("b3WeldJoint_GetLinearDampingRatio");

<*
 Sets the stiffness in hertz of the spring over the two bodies' relative rotation. This is the
 joint's other channel and box3d tests the two separately, so the rotation may be rigid at 0 while
 the translation is soft, or the other way about. Everything set_linear_hertz describes holds here
 too, the disagreement over a negative value included.
*>
extern fn void WeldJointId.set_angular_hertz(self, float hertz) @cname("b3WeldJoint_SetAngularHertz");

<*
 The stiffness in hertz of the spring over the two bodies' relative rotation. 0 on a joint built
 from a default definition, and 0 is this joint's rigid setting rather than its softest.
*>
extern fn float WeldJointId.angular_hertz(self) @cname("b3WeldJoint_GetAngularHertz");

<*
 Sets the damping ratio of the spring over the two bodies' relative rotation, non-dimensional.
 Read only while angular_hertz() is away from 0, on the terms set_linear_damping_ratio describes.
*>
extern fn void WeldJointId.set_angular_damping_ratio(self, float damping_ratio) @cname("b3WeldJoint_SetAngularDampingRatio");

<*
 The damping ratio of the spring over the two bodies' relative rotation, non-dimensional. 0 on a
 joint built from a default definition.
*>
extern fn float WeldJointId.angular_damping_ratio(self) @cname("b3WeldJoint_GetAngularDampingRatio");

<*
 A joint known to be a parallel joint. box3d resolves every per-type accessor through a
 joint-type assertion this release build compiles out, so a parallel accessor reaching a joint of
 another type reinterprets that joint's solver union instead: a getter hands back nonsense and a
 setter writes over the other type's state. The distinct handle moves that check to the one place
 the type is genuinely in question. A ParallelJointId converts to a JointId on its own, so every
 shared joint accessor reaches it uncast; the way back is JointId.as_parallel(), which checks.
*>
typedef ParallelJointId = inline JointId;

<*
 A parallel joint definition. The joint constrains the angle between the z axis of local frame A
 and the z axis of local frame B with a spring and holds nothing else — the two bodies are left
 free to translate and to spin about that shared axis — which is what keeps a body upright. Must
 come from default_parallel_joint_def(), which, unlike the prismatic and the weld default, zeroes
 nothing it adds to the base: hertz is 1, damping_ratio is 1 and max_torque is float::max. A
 default parallel joint is already sprung.

 The spring is gated on max_torque rather than merely bounded by it: box3d solves it only while
 the ceiling is above 0, so a max_torque of 0 stops the joint constraining anything at all.

 box3d asserts hertz, damping_ratio and max_torque are each a real number at or above 0 and this
 release build compiles that assertion out, so a negative or NaN value is stored verbatim and
 reaches the solver.
*>
struct ParallelJointDef {
    inline JointDef base;
    float hertz;
    float damping_ratio;
    float max_torque;
}

extern fn ParallelJointDef default_parallel_joint_def() @cname("b3DefaultParallelJointDef");

<*
 Raw parallel joint constructor. Bypasses WorldId.create_parallel_joint's definition guard and
 hands back a joint of no particular type, so it is private to the module —
 box3d_joint_parallel.c3's WorldId.create_parallel_joint is the only caller and is the only
 public way to a live parallel joint.
*>
extern fn JointId create_parallel_joint_raw(
  WorldId world_id,
  ParallelJointDef* def,
) @cname("b3CreateParallelJoint") @private;

<*
 Sets the spring's stiffness in hertz. 1 on a joint built from a default definition, where the weld
 joint's two are 0 — and 0 does not mean here what it means there: box3d's softness for a zero
 hertz carries a zero mass scale, so a parallel spring at 0 stops solving rather than going rigid,
 the way a max_torque of 0 does.

 That leaves the two frames free only on a joint set to 0 before it has accumulated an impulse.
 box3d's warm start re-applies the impulse the spring already holds every substep and is gated on
 neither the hertz nor the ceiling, while the zero mass scale stops that impulse ever being updated
 or decayed, so a joint silenced after it has been working goes on pushing the bodies with the
 impulse it was holding at the time.

 box3d asserts the value is finite and at or above 0, and this package links a release build where
 that assertion is compiled out. The value is stored as handed, nothing is clamped, and the
 spring's accumulated impulse stands.
*>
extern fn void ParallelJointId.set_spring_hertz(self, float hertz) @cname("b3ParallelJoint_SetSpringHertz");

<*
 The spring's stiffness in hertz. 1 on a joint built from a default definition.
*>
extern fn float ParallelJointId.spring_hertz(self) @cname("b3ParallelJoint_GetSpringHertz");

<*
 Sets the spring's damping ratio, non-dimensional. 1 on a joint built from a default definition.
 Asserted finite and at or above 0 under the same compiled-out assertion set_spring_hertz
 describes, and stored as handed.
*>
extern fn void ParallelJointId.set_spring_damping_ratio(self, float damping_ratio) @cname("b3ParallelJoint_SetSpringDampingRatio");

<*
 The spring's damping ratio, non-dimensional. 1 on a joint built from a default definition.
*>
extern fn float ParallelJointId.spring_damping_ratio(self) @cname("b3ParallelJoint_GetSpringDampingRatio");

<*
 Sets the ceiling in newton-metres on the torque the spring may apply: box3d bounds the spring's
 accumulated impulse to the time step times this value. float::max on a joint built from a default
 definition. The ceiling gates the constraint as well as bounding it, so set_max_torque(0) leaves
 the joint solving nothing at all — this joint holds nothing else. Upstream names the parameter a
 force; what it stores and everything that reads it is a torque.

 A joint set to 0 before it has accumulated an impulse leaves the two bodies turning freely; one
 silenced after it has been working does not. box3d's warm start re-applies the impulse the spring
 already holds every substep and is gated on neither the ceiling nor the hertz, while the gate on
 the solve stops that impulse ever being updated or decayed, so it goes on being applied unchanged
 for as long as the joint lives — measured, a body left spinning under a joint silenced this way is
 pushed off the rate it was turning at rather than holding it.

 box3d asserts the value is finite and at or above 0, and this package links a release build where
 that assertion is compiled out. The value is stored as handed, and the spring's accumulated
 impulse stands.
*>
extern fn void ParallelJointId.set_max_torque(self, float torque) @cname("b3ParallelJoint_SetMaxTorque");

<*
 The ceiling in newton-metres on the torque the spring may apply. float::max on a joint built from
 a default definition.
*>
extern fn float ParallelJointId.max_torque(self) @cname("b3ParallelJoint_GetMaxTorque");

<*
 A joint known to be a motor joint. box3d resolves every per-type accessor through a joint-type
 assertion this release build compiles out, so a motor accessor reaching a joint of another type
 reinterprets that joint's solver union instead: a getter hands back nonsense and a setter writes
 over the other type's state. The distinct handle moves that check to the one place the type is
 genuinely in question. A MotorJointId converts to a JointId on its own, so every shared joint
 accessor reaches it uncast; the way back is JointId.as_motor(), which checks.
*>
typedef MotorJointId = inline JointId;

<*
 A motor joint definition. The joint drives body B towards a relative linear and angular velocity
 and, separately, pulls it towards the transform the two local frames describe through a linear
 and an angular spring. Both velocities are whole Vec3 values rather than the single motor speed
 the joint types with one driven axis carry.

 This type has no enable flags at all. Each of its four channels is switched by its own ceiling
 instead: box3d solves the linear and the angular drive only while max_velocity_force and
 max_velocity_torque respectively are above 0, and each spring only while both its ceiling and its
 hertz are. So a ceiling of 0 is not a bound this joint never reaches — it is the channel turned
 off.

 Must come from default_motor_joint_def(), which zeroes every field it adds to the base. A
 default motor joint therefore drives and holds nothing until a ceiling is raised. The
 constructor copies all ten fields across verbatim: nothing here is validated, clamped or
 reordered on the way in.
*>
struct MotorJointDef {
    inline JointDef base;
    Vec3 linear_velocity;
    float max_velocity_force;
    Vec3 angular_velocity;
    float max_velocity_torque;
    float linear_hertz;
    float linear_damping_ratio;
    float max_spring_force;
    float angular_hertz;
    float angular_damping_ratio;
    float max_spring_torque;
}

extern fn MotorJointDef default_motor_joint_def() @cname("b3DefaultMotorJointDef");

<*
 Raw motor joint constructor. Bypasses WorldId.create_motor_joint's definition guard and hands
 back a joint of no particular type, so it is private to the module — box3d_joint_motor.c3's
 WorldId.create_motor_joint is the only caller and is the only public way to a live motor joint.
*>
extern fn JointId create_motor_joint_raw(
  WorldId world_id,
  MotorJointDef* def,
) @cname("b3CreateMotorJoint") @private;

<*
 Sets the velocity the joint drives body B towards relative to body A, in metres per second along
 the world axes. box3d subtracts this vector from the two bodies' relative velocity as it stands,
 rotating it into no frame and projecting it onto no axis, so a velocity of (1, 0, 0) drives along
 world x however the two local frames are turned.

 The drive acts only while max_velocity_force() is above 0. This joint type carries no enable flag
 of any kind, so that ceiling is the whole switch. box3d asserts nothing here — not finiteness,
 not a bound — and clamps nothing. The value is stored as handed and the drive's accumulated
 impulse is left standing rather than discarded, so a joint retargeted mid-run works towards the
 new velocity from the force it was already applying.
*>
extern fn void MotorJointId.set_linear_velocity(self, Vec3 velocity) @cname("b3MotorJoint_SetLinearVelocity");

<*
 The velocity the joint drives body B towards relative to body A, in metres per second along the
 world axes. What was set, not what the two bodies are doing. Zero on a joint built from a default
 definition.
*>
extern fn Vec3 MotorJointId.linear_velocity(self) @cname("b3MotorJoint_GetLinearVelocity");

<*
 Sets the ceiling in newtons on the force the linear drive may apply. It is the drive's switch as
 well as its bound: box3d solves the linear drive only while this is above 0, so a joint whose
 ceiling is 0 — which is what a default definition gives it — drives nothing at all whatever
 linear_velocity() asks for, rather than driving weakly. A negative ceiling silences it the same
 way.

 Dropping a ceiling on a channel that has already been working does not undo what it holds.
 box3d's warm start re-applies all four of this joint's accumulated impulses every substep and is
 gated on nothing, while these gates stop those impulses ever being updated again, so a silenced
 channel goes on applying what it last held for as long as the joint lives — measured on the
 linear spring, a body it was holding against gravity stays exactly where it was for as long
 again after the ceiling is dropped to 0, where the same body under a spring whose ceiling was
 never raised falls freely.

 box3d asserts nothing here and clamps nothing: a negative ceiling is stored as handed and reads
 back negative. The two spring ceilings on this same joint do floor at 0, so the four ceilings are
 not one contract.
*>
extern fn void MotorJointId.set_max_velocity_force(self, float force) @cname("b3MotorJoint_SetMaxVelocityForce");

<*
 The ceiling in newtons on the force the linear drive may apply, and the switch deciding whether
 the drive is solved at all — see set_max_velocity_force. 0 on a joint built from a default
 definition, and otherwise whatever was stored, negatives included.

 This joint type has no force getter of its own, and the shared JointId.constraint_force() is a
 sound reading for it: box3d divides the sum of the linear drive's and the linear spring's
 accumulated impulses by the sub-step, each counted once, so it reports the whole linear force the
 joint applied over the last step with neither the double count the revolute joint's shared torque
 carries nor an axis permutation. With one of the two linear channels silent it is the other
 channel's force alone, bounded by that channel's ceiling.
*>
extern fn float MotorJointId.max_velocity_force(self) @cname("b3MotorJoint_GetMaxVelocityForce");

<*
 Sets the angular velocity the joint drives body B towards relative to body A, in radians per
 second about the world axes. box3d subtracts this vector from the difference of the two bodies'
 angular velocities and rotates it into no frame, so a velocity of (1, 0, 0) turns the body about
 world x however the two local frames are turned.

 The drive acts only while max_velocity_torque() is above 0. box3d asserts nothing here and clamps
 nothing; the value is stored as handed and the drive's accumulated impulse stands.
*>
extern fn void MotorJointId.set_angular_velocity(self, Vec3 velocity) @cname("b3MotorJoint_SetAngularVelocity");

<*
 The angular velocity the joint drives body B towards relative to body A, in radians per second
 about the world axes. What was set, not what the two bodies are doing. Zero on a joint built from
 a default definition.
*>
extern fn Vec3 MotorJointId.angular_velocity(self) @cname("b3MotorJoint_GetAngularVelocity");

<*
 Sets the ceiling in newton-metres on the torque the angular drive may apply. It is that drive's
 switch as well as its bound, for the reason and with the warm-start consequence
 set_max_velocity_force describes: 0 — what a default definition gives it — turns the angular
 drive off rather than weakening it, and a negative does the same.

 box3d asserts nothing here and clamps nothing, so a negative ceiling reads back negative.
*>
extern fn void MotorJointId.set_max_velocity_torque(self, float torque) @cname("b3MotorJoint_SetMaxVelocityTorque");

<*
 The ceiling in newton-metres on the torque the angular drive may apply, and the switch deciding
 whether that drive is solved at all — see set_max_velocity_torque. 0 on a joint built from a
 default definition, and otherwise whatever was stored, negatives included.

 This joint type has no torque getter of its own, and the shared JointId.constraint_torque() is a
 sound reading for it: box3d divides the sum of the angular drive's and the angular spring's
 accumulated impulses by the sub-step, each counted once, so it reports the whole torque the joint
 applied over the last step. With one of the two angular channels silent it is the other channel's
 torque alone, bounded by that channel's ceiling.
*>
extern fn float MotorJointId.max_velocity_torque(self) @cname("b3MotorJoint_GetMaxVelocityTorque");

<*
 Sets the linear spring's stiffness in hertz. The spring pulls the origin of local frame B onto the
 origin of local frame A, and box3d solves it only while this and max_spring_force() are both above
 0 — either one at 0 silences it, and both are 0 on a joint built from a default definition. So
 this is half a switch and not only a stiffness. A negative stiffness silences the spring the same
 way 0 does.

 Stiffness and damping are turned into solver coefficients at the top of each step, so a change
 lands on the next step rather than the one in progress. box3d asserts nothing here and clamps
 nothing; the value is stored as handed and the spring's accumulated impulse stands.
*>
extern fn void MotorJointId.set_linear_hertz(self, float hertz) @cname("b3MotorJoint_SetLinearHertz");

<*
 The linear spring's stiffness in hertz, and half the switch deciding whether that spring is solved
 at all — see set_linear_hertz. 0 on a joint built from a default definition.
*>
extern fn float MotorJointId.linear_hertz(self) @cname("b3MotorJoint_GetLinearHertz");

<*
 Sets the linear spring's damping ratio, non-dimensional: 1 settles body B on local frame A's
 origin without overshooting it. Unlike the stiffness beside it this decides nothing about whether
 the spring is solved, which follows linear_hertz() and max_spring_force() alone. box3d asserts
 nothing here and clamps nothing.
*>
extern fn void MotorJointId.set_linear_damping_ratio(self, float damping_ratio) @cname("b3MotorJoint_SetLinearDampingRatio");

<*
 The linear spring's damping ratio, non-dimensional. 0 on a joint built from a default definition.
*>
extern fn float MotorJointId.linear_damping_ratio(self) @cname("b3MotorJoint_GetLinearDampingRatio");

<*
 Sets the ceiling in newtons on the force the linear spring may apply, and the other half of that
 spring's switch: box3d solves the linear spring only while this and linear_hertz() are both above
 0, so a ceiling of 0 — what a default definition gives it — leaves the spring holding nothing
 however stiff it is.

 This ceiling floors at 0, where the two velocity ceilings on the same joint store a negative as
 handed: a negative force here reads back as exactly 0. The floor belongs to the setter alone —
 construction copies MotorJointDef's ten fields across verbatim, so a definition asking for a
 negative ceiling builds a joint reporting one, which this setter cannot produce.

 Silencing a working spring by dropping this to 0 leaves the impulse it holds standing, for the
 reason set_max_velocity_force gives. box3d asserts nothing here.
*>
extern fn void MotorJointId.set_max_spring_force(self, float force) @cname("b3MotorJoint_SetMaxSpringForce");

<*
 The ceiling in newtons on the force the linear spring may apply, and the other half of the switch
 deciding whether that spring is solved at all — see set_max_spring_force. 0 on a joint built from
 a default definition. Negative only on a joint whose definition carried one, never through the
 setter. The force the spring actually applied is read through the shared
 JointId.constraint_force(), which max_velocity_force describes.
*>
extern fn float MotorJointId.max_spring_force(self) @cname("b3MotorJoint_GetMaxSpringForce");

<*
 Sets the angular spring's stiffness in hertz. The spring turns local frame B onto local frame A's
 orientation, and box3d solves it only while this and max_spring_torque() are both above 0 — either
 one at 0 silences it, and both are 0 on a joint built from a default definition. A negative
 stiffness silences it the same way 0 does. box3d asserts nothing here and clamps nothing, and a
 change lands on the next step for the reason set_linear_hertz gives.
*>
extern fn void MotorJointId.set_angular_hertz(self, float hertz) @cname("b3MotorJoint_SetAngularHertz");

<*
 The angular spring's stiffness in hertz, and half the switch deciding whether that spring is
 solved at all — see set_angular_hertz. 0 on a joint built from a default definition.
*>
extern fn float MotorJointId.angular_hertz(self) @cname("b3MotorJoint_GetAngularHertz");

<*
 Sets the angular spring's damping ratio, non-dimensional: 1 settles local frame B on local frame
 A's orientation without overshooting it. It decides nothing about whether the spring is solved,
 which follows angular_hertz() and max_spring_torque() alone. box3d asserts nothing here and clamps
 nothing.
*>
extern fn void MotorJointId.set_angular_damping_ratio(self, float damping_ratio) @cname("b3MotorJoint_SetAngularDampingRatio");

<*
 The angular spring's damping ratio, non-dimensional. 0 on a joint built from a default definition.
*>
extern fn float MotorJointId.angular_damping_ratio(self) @cname("b3MotorJoint_GetAngularDampingRatio");

<*
 Sets the ceiling in newton-metres on the torque the angular spring may apply, and the other half
 of that spring's switch: box3d solves the angular spring only while this and angular_hertz() are
 both above 0, so a ceiling of 0 — what a default definition gives it — leaves the spring turning
 nothing however stiff it is.

 Like max_spring_force and unlike the two velocity ceilings, this one floors at 0: a negative
 torque reads back as exactly 0, and only a definition can leave this joint reporting a negative
 one. Silencing a working spring by dropping the ceiling leaves the impulse it holds standing, for
 the reason set_max_velocity_force gives. box3d asserts nothing here.
*>
extern fn void MotorJointId.set_max_spring_torque(self, float torque) @cname("b3MotorJoint_SetMaxSpringTorque");

<*
 The ceiling in newton-metres on the torque the angular spring may apply, and the other half of the
 switch deciding whether that spring is solved at all — see set_max_spring_torque. 0 on a joint
 built from a default definition. Negative only on a joint whose definition carried one, never
 through the setter. The torque the spring actually applied is read through the shared
 JointId.constraint_torque(), which max_velocity_torque describes.
*>
extern fn float MotorJointId.max_spring_torque(self) @cname("b3MotorJoint_GetMaxSpringTorque");

<*
 A joint known to be a spherical joint. box3d resolves every per-type accessor through a
 joint-type assertion this release build compiles out, so a spherical accessor reaching a joint of
 another type reinterprets that joint's solver union instead: a getter hands back nonsense and a
 setter writes over the other type's state. The distinct handle moves that check to the one place
 the type is genuinely in question. A SphericalJointId converts to a JointId on its own, so every
 shared joint accessor reaches it uncast; the way back is JointId.as_spherical(), which checks.
*>
typedef SphericalJointId = inline JointId;

<*
 A spherical joint definition. The joint pins the origin of local frame B to the origin of local
 frame A and leaves the orientation about that point free — a ball and socket. An optional cone
 limit bounds how far the two frames may swing apart, an optional twist limit bounds the rotation
 between them, an optional spring turns frame B towards target_rotation, and an optional motor
 drives their relative angular velocity, which is a whole Vec3 rather than a single speed.

 Both limited angles are measured from the two frames' relative ORIENTATION and never from
 position, which is the opposite of what this joint's name suggests. box3d builds each from body
 A's rotation composed with local frame A's, compared against body B's the same way, and the
 bodies' positions enter neither. So swinging a spherical joint as a pendulum leaves the cone and
 twist angles at exactly 0 however far the bodies travel, and only rotating a body moves them.

 Must come from default_spherical_joint_def(), which zeroes every field it adds to the base
 except target_rotation, which is the identity quaternion (0, 0, 0, 1) rather than the zero a
 reader scanning the rest of the default would expect. A default spherical joint is a bare ball
 and socket: no spring, no limit, no motor.

 Three fields are silently corrected on the way in. The constructor clamps cone_angle to
 [0, pi/2], half the range this type's own prose gives the field, and it swaps the two twist
 angles into order before clamping each to ±0.99 pi. box3d also asserts a cone angle within
 [0, 0.99 pi] and a valid target_rotation, both under assertions this release build compiles out,
 so an out-of-range angle is silently clamped rather than caught and a target_rotation that is
 not a unit quaternion is stored and solved against as handed.
*>
struct SphericalJointDef {
    inline JointDef base;
    bool enable_spring;
    float hertz;
    float damping_ratio;
    Quat target_rotation;
    bool enable_cone_limit;
    float cone_angle;
    bool enable_twist_limit;
    float lower_twist_angle;
    float upper_twist_angle;
    bool enable_motor;
    float max_motor_torque;
    Vec3 motor_velocity;
}

extern fn SphericalJointDef default_spherical_joint_def() @cname("b3DefaultSphericalJointDef");

<*
 Raw spherical joint constructor. Bypasses WorldId.create_spherical_joint's definition guard and
 hands back a joint of no particular type, so it is private to the module —
 box3d_joint_spherical.c3's WorldId.create_spherical_joint is the only caller and is the only
 public way to a live spherical joint.
*>
extern fn JointId create_spherical_joint_raw(
  WorldId world_id,
  SphericalJointDef* def,
) @cname("b3CreateSphericalJoint") @private;

<*
 Enables or disables this joint's cone limit, which bounds how far local frame B's z axis may tilt
 away from local frame A's. A change to the flag discards the cone's accumulated impulse, so a
 limit switched back on rebuilds its hold over the following steps rather than resuming the one it
 had.
*>
extern fn void SphericalJointId.enable_cone_limit(self, bool enable_limit) @cname("b3SphericalJoint_EnableConeLimit");

<*
 Whether this joint's cone limit is enabled. False on a joint built from a default definition.
*>
extern fn bool SphericalJointId.is_cone_limit_enabled(self) @cname("b3SphericalJoint_IsConeLimitEnabled");

<*
 Sets the angle in radians the cone limit holds the two frames' z axes within. box3d stores it
 exactly as handed and clamps nothing, where the constructor clamps SphericalJointDef's cone_angle
 into [0, pi/2]: an angle a definition asks for comes back narrowed and the same angle asked for
 here does not, so the two paths reach the solver with different cones. box3d asserts the value is
 finite and within [0, pi/2], an assertion this release build compiles out and the wrappers do not
 restore, so a negative angle or one past pi/2 reaches the solver through this call and through no
 other. The limit acts only while is_cone_limit_enabled() is on, and setting it leaves the impulse
 the cone had accumulated standing.
*>
extern fn void SphericalJointId.set_cone_limit(self, float angle_radians) @cname("b3SphericalJoint_SetConeLimit");

<*
 The angle in radians the cone limit holds the two frames' z axes within. It is what box3d stored,
 which is what set_cone_limit was handed or what the constructor clamped the definition's
 cone_angle to — see set_cone_limit for why those differ. 0 on a joint built from a default
 definition.
*>
extern fn float SphericalJointId.cone_limit(self) @cname("b3SphericalJoint_GetConeLimit");

<*
 The current angle in radians between local frame A's z axis and local frame B's, kept in [0, pi].
 It is read from the two frames' relative orientation and never from the bodies' positions, in the
 way SphericalJointDef describes, so carrying the bodies anywhere leaves it where it was and only
 turning one moves it. It is measured whether or not the cone limit is enabled, and against the
 frames' current alignment rather than against cone_limit().
*>
extern fn float SphericalJointId.cone_angle(self) @cname("b3SphericalJoint_GetConeAngle");

<*
 Enables or disables this joint's twist limit, which bounds the rotation of local frame B about
 the frames' shared z axis. A change to the flag discards both of the twist's accumulated
 impulses, so a limit switched back on rebuilds its hold over the following steps rather than
 resuming the one it had.
*>
extern fn void SphericalJointId.enable_twist_limit(self, bool enable_limit) @cname("b3SphericalJoint_EnableTwistLimit");

<*
 Whether this joint's twist limit is enabled. False on a joint built from a default definition.
*>
extern fn bool SphericalJointId.is_twist_limit_enabled(self) @cname("b3SphericalJoint_IsTwistLimitEnabled");

<*
 The low end of the rotation about the frames' z axis the twist limit holds body B above, in
 radians. It is what box3d stored, not what it was handed: see set_twist_limits. 0 on a joint
 built from a default definition.
*>
extern fn float SphericalJointId.lower_twist_limit(self) @cname("b3SphericalJoint_GetLowerTwistLimit");

<*
 The high end of the rotation about the frames' z axis the twist limit holds body B below, in
 radians. It is what box3d stored, not what it was handed: see set_twist_limits. 0 on a joint
 built from a default definition.
*>
extern fn float SphericalJointId.upper_twist_limit(self) @cname("b3SphericalJoint_GetUpperTwistLimit");

<*
 Sets the two angles in radians the twist limit holds the rotation about the frames' z axis
 between. box3d takes the smaller of the pair as the lower and the larger as the upper, so a
 reversed pair is quietly corrected rather than refused, and then clamps both ends into
 [-0.99 pi, 0.99 pi]. The constructor swaps and clamps the definition's pair the same way, so a
 twist limit arrives the same however it was asked for. box3d asserts only that both values are
 finite — their order and their range it corrects instead; that assertion is compiled out of this
 release build and the wrappers do not restore it. The limit acts only while
 is_twist_limit_enabled() is on, and setting it leaves the impulses the limit had accumulated
 standing.
*>
extern fn void SphericalJointId.set_twist_limits(self, float lower_radians, float upper_radians) @cname("b3SphericalJoint_SetTwistLimits");

<*
 The current rotation in radians of local frame B about the frames' shared z axis, kept in
 [-pi, pi]. It is read from the two frames' relative orientation and never from the bodies'
 positions, in the way SphericalJointDef describes, so carrying the bodies anywhere leaves it
 where it was and only turning one moves it. It is measured whether or not the twist limit is
 enabled, and against the frames' current alignment rather than against the pair
 lower_twist_limit() and upper_twist_limit() report.
*>
extern fn float SphericalJointId.twist_angle(self) @cname("b3SphericalJoint_GetTwistAngle");

<*
 Enables or disables this joint's angular spring, which turns local frame B towards the rotation
 target_rotation() names relative to local frame A. A change to the flag discards the spring's
 accumulated impulse, so a spring switched back on rebuilds its pull over the following steps
 rather than resuming the one it had, and one switched off releases what it was holding rather
 than leaving it standing. box3d asserts nothing here.
*>
extern fn void SphericalJointId.enable_spring(self, bool enable_spring) @cname("b3SphericalJoint_EnableSpring");

<*
 Whether this joint's angular spring is enabled. False on a joint built from a default definition.
*>
extern fn bool SphericalJointId.is_spring_enabled(self) @cname("b3SphericalJoint_IsSpringEnabled");

<*
 Sets the spring's stiffness in hertz. 0 on a joint built from a default definition, which leaves
 an enabled spring pulling on nothing: box3d's softness for zero hertz has a zero mass scale, so
 the spring computes no impulse at all. box3d asserts the value is finite and non-negative, an
 assertion this release build compiles out and the wrappers do not restore, and it clamps nothing.
 The constructor copies a definition's hertz the same way, so the two paths agree.
*>
extern fn void SphericalJointId.set_spring_hertz(self, float hertz) @cname("b3SphericalJoint_SetSpringHertz");

<*
 The spring's stiffness in hertz. 0 on a joint built from a default definition.
*>
extern fn float SphericalJointId.spring_hertz(self) @cname("b3SphericalJoint_GetSpringHertz");

<*
 Sets the spring's damping ratio, non-dimensional. 0 on a joint built from a default definition.
 box3d reads it only while spring_hertz() is non-zero, under the same compiled-out assertion
 set_spring_hertz describes, and the constructor copies a definition's ratio the same way.
*>
extern fn void SphericalJointId.set_spring_damping_ratio(self, float damping_ratio) @cname("b3SphericalJoint_SetSpringDampingRatio");

<*
 The spring's damping ratio, non-dimensional. 0 on a joint built from a default definition.
*>
extern fn float SphericalJointId.spring_damping_ratio(self) @cname("b3SphericalJoint_GetSpringDampingRatio");

<*
 Sets the rotation of local frame B relative to local frame A the spring turns towards while
 is_spring_enabled() is on. The spring is the only thing box3d reads it for: cone_angle() and
 twist_angle() are measured against the frames' current alignment and carry no target term, so a
 ball a spring has settled on its target still reports the angles that alignment gives.

 box3d stores the quaternion exactly as handed. It asserts only that the quaternion is valid — an
 assertion this release build compiles out and the wrappers do not restore — and it neither
 normalises nor corrects, so a target that is not a unit quaternion is stored and solved against as
 given. The constructor copies a definition's target_rotation under the same compiled-out
 assertion and normalises no more than this does, so unlike this type's cone angle the two paths
 agree on what they keep.
*>
extern fn void SphericalJointId.set_target_rotation(self, Quat target_rotation) @cname("b3SphericalJoint_SetTargetRotation");

<*
 The rotation of local frame B relative to local frame A the spring turns towards. It is what was
 stored, unit length or not — see set_target_rotation. The identity quaternion (0, 0, 0, 1) on a
 joint built from a default definition, which is the one field that default does not zero.
*>
extern fn Quat SphericalJointId.target_rotation(self) @cname("b3SphericalJoint_GetTargetRotation");

<*
 Enables or disables this joint's motor. This flag is the gate box3d's motor solve itself tests. A
 change to it discards the motor's accumulated impulse, so motor_torque() reads zero from the call
 onward rather than the torque the motor was applying before, and box3d's warm start — which
 re-applies that impulse every sub-step whether the motor is enabled or not — is left with nothing
 to re-apply, so a motor switched off releases body B rather than going on pushing it. A
 max_motor_torque() of 0 releases it too, by way of the clamp inside that solve rather than by
 skipping it. box3d asserts nothing here.
*>
extern fn void SphericalJointId.enable_motor(self, bool enable_motor) @cname("b3SphericalJoint_EnableMotor");

<*
 Whether this joint's motor is enabled. False on a joint built from a default definition.
*>
extern fn bool SphericalJointId.is_motor_enabled(self) @cname("b3SphericalJoint_IsMotorEnabled");

<*
 Sets the angular velocity in radians per second the motor drives body B towards relative to body
 A, about the world axes. box3d subtracts this vector from the difference of the two bodies'
 angular velocities, rotating it into no frame and projecting it onto no axis, so a velocity of
 (0, 0, 1) turns body B about world z however the two local frames are turned — where this same
 joint's cone_angle() and twist_angle() are read from those frames. It is a target the motor
 pursues only as far as max_motor_torque() lets it, not a velocity body B is made to hold.

 box3d asserts only that the vector is finite, an assertion this release build compiles out and
 the wrappers do not restore. The value is stored as handed and the motor's accumulated impulse is
 left standing rather than discarded, so a motor retargeted mid-run works towards the new velocity
 from the torque it was already applying. The constructor copies a definition's motor_velocity the
 same way.
*>
extern fn void SphericalJointId.set_motor_velocity(self, Vec3 motor_velocity) @cname("b3SphericalJoint_SetMotorVelocity");

<*
 The angular velocity the motor drives body B towards relative to body A, in radians per second
 about the world axes. What was set, not what body B is turning at. Zero on a joint built from a
 default definition.
*>
extern fn Vec3 SphericalJointId.motor_velocity(self) @cname("b3SphericalJoint_GetMotorVelocity");

<*
 The torque the motor applied over the last step, in newton-metres about the world axes. It is a
 whole vector, not the single number the revolute joint's motor_torque() reports, because this
 motor drives all three rotational degrees of freedom at once rather than one hinge axis: box3d
 divides the motor's accumulated angular impulse vector by the sub-step, and the components are
 that vector's, about world x, y and z. It is the length of the vector that max_motor_torque()
 bounds, not any single component.

 This is the motor's own share, and it is the honest reading of the two available. The shared
 constraint_torque() sums this vector with the spring's and with the two limits' along axes it
 recomputes from the bodies' current rotations, so on a joint whose spring and limits are all
 silent the two accessors report the same vector, and on one whose spring is working the shared
 accessor is their sum with neither counted twice and no axis permuted. The two limits are what
 break it, and each breaks it in its own way. The cone's impulse enters that sum with the sign
 opposite to the one box3d applies it with, so a cone holding a motor still means the two torques
 add there instead of cancelling, and the shared accessor reports twice what the motor is applying
 rather than the nothing the two come to. The twist's impulse is laid along local frame B's z
 axis, where the solve and the warm start drive it along a jacobian box3d builds instead from
 local frame A's cone axis and the swing between the two frames. Those two are the same vector
 only while the swing angle is 0, which is why a joint that only twists reads correctly. So a ball
 that is both swung and twisted is wrong on the twist channel as well as on the cone, by no fixed
 factor: correcting the cone's sign alone would still not make the shared reading the joint's.
*>
extern fn Vec3 SphericalJointId.motor_torque(self) @cname("b3SphericalJoint_GetMotorTorque");

<*
 Sets the largest torque in newton-metres the motor may apply. It bounds the length of the motor's
 angular impulse rather than any one component of it, so it is a ceiling on the whole three-axis
 torque motor_torque() reports. 0 on a joint built from a default definition, which leaves an
 enabled motor unable to turn anything, and dropping it to 0 on a motor that has been working
 releases what that motor was holding rather than leaving it standing.

 box3d asserts the value is finite and non-negative, an assertion this release build compiles out
 and the wrappers do not restore, and it stores the value as handed without flooring it — the
 constructor copies a definition's max_motor_torque the same way, so a negative ceiling is
 reachable through either path. A negative one is not read as zero: box3d rescales the motor's
 impulse by the ratio of the ceiling to that impulse's own length, so the negative sign reverses
 the impulse and the motor drives body B away from motor_velocity() at the ceiling's magnitude,
 accelerating past that velocity instead of settling on it.
*>
extern fn void SphericalJointId.set_max_motor_torque(self, float torque) @cname("b3SphericalJoint_SetMaxMotorTorque");

<*
 The largest torque in newton-metres the motor may apply. What was set. 0 on a joint built from a
 default definition.
*>
extern fn float SphericalJointId.max_motor_torque(self) @cname("b3SphericalJoint_GetMaxMotorTorque");

<*
 A joint known to be a wheel joint. box3d resolves every per-type accessor through a joint-type
 assertion this release build compiles out, so a wheel accessor reaching a joint of another type
 reinterprets that joint's solver union instead: a getter hands back nonsense and a setter writes
 over the other type's state. The distinct handle moves that check to the one place the type is
 genuinely in question. A WheelJointId converts to a JointId on its own, so every shared joint
 accessor reaches it uncast; the way back is JointId.as_wheel(), which checks.
*>
typedef WheelJointId = inline JointId;

<*
 A wheel joint definition. Body A is the chassis and body B is the wheel: the wheel spins about
 local frame B's z axis, its suspension travels along local frame A's x axis, and its steering
 turns about that same x axis of frame A. Three channels, each with its own enable flag and its
 own optional limit — a suspension spring, a spin motor, and a steering spring.

 Must come from default_wheel_joint_def(), and that default is the only one in this package that
 hands back an enable flag already set. enable_suspension_spring is true, with suspension_hertz 1
 and suspension_damping_ratio 0.7, and steering_hertz 1 and steering_damping_ratio 0.7 sit
 alongside them. So a wheel arrives already sprung along its suspension axis where every other
 joint type arrives inert. The other twelve fields are zero or false, which leaves the spin motor,
 the steering and both limits off until the definition turns them on — the steering spring is
 tuned but not solved at all until enable_steering is set.

 spin_speed is what this definition calls the speed the spin motor drives at, while the accessors
 for the same quantity are set_spin_motor_speed() and spin_motor_speed(). box3d names the field
 and the accessors differently and each side of the binding follows its own name, so a reader
 expecting the two to agree is reading two different names for one value.

 The shared JointId.angular_separation() reports nothing meaningful on a joint of this type.
 box3d's switch over the joint types carries no implementation for the wheel case — only an
 assertion this release build compiles out and a bare return of 0 — so it reads 0 on every wheel
 joint because that code was never written, not because the joint is aligned.
*>
struct WheelJointDef {
    inline JointDef base;
    bool enable_suspension_spring;
    float suspension_hertz;
    float suspension_damping_ratio;
    bool enable_suspension_limit;
    float lower_suspension_limit;
    float upper_suspension_limit;
    bool enable_spin_motor;
    float max_spin_torque;
    float spin_speed;
    bool enable_steering;
    float steering_hertz;
    float steering_damping_ratio;
    float target_steering_angle;
    float max_steering_torque;
    bool enable_steering_limit;
    float lower_steering_limit;
    float upper_steering_limit;
}

extern fn WheelJointDef default_wheel_joint_def() @cname("b3DefaultWheelJointDef");

<*
 Raw wheel joint constructor. Bypasses WorldId.create_wheel_joint's definition guard and hands
 back a joint of no particular type, so it is private to the module — box3d_joint_wheel.c3's
 WorldId.create_wheel_joint is the only caller and is the only public way to a live wheel joint.
*>
extern fn JointId create_wheel_joint_raw(
  WorldId world_id,
  WheelJointDef* def,
) @cname("b3CreateWheelJoint") @private;
