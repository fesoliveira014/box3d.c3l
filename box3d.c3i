struct Filter {
    ulong category_bits;
    ulong mask_bits;
    int group_index;
}

extern fn Filter default_filter() @cname("b3DefaultFilter");

struct SurfaceMaterial {
    float friction;
    float restitution;
    float rolling_resistance;
    Vec3 tangent_velocity;
    ulong user_material_id;
    uint custom_color;
    uint padding;
}

extern fn SurfaceMaterial default_surface_material() @cname("b3DefaultSurfaceMaterial");

enum ShapeType : int {
    CAPSULE,
    COMPOUND,
    HEIGHT_FIELD,
    HULL,
    MESH,
    SPHERE,
}

<*
 A shape definition. Must come from default_shape_def() — see BodyId.create_sphere_shape.
*>
struct ShapeDef {
    ZString name;
    void* user_data;
    SurfaceMaterial* materials;
    int material_count;
    SurfaceMaterial base_material;
    float density;
    float explosion_scale;
    Filter filter;
    bool enable_custom_filtering;
    bool is_sensor;
    bool enable_sensor_events;
    bool enable_contact_events;
    bool enable_hit_events;
    bool enable_pre_solve_events;
    bool invoke_contact_creation;
    bool update_body_mass;
    bool enable_speculative_contact;
    int internal_value;
}

extern fn ShapeDef default_shape_def() @cname("b3DefaultShapeDef");

struct Sphere {
    Vec3 center;
    float radius;
}

struct Capsule {
    Vec3 center1;
    Vec3 center2;
    float radius;
}

<*
 The mass, centre of mass and inertia of a solid ball of this radius at this density. The centre
 is the sphere's own and the tensor is about that centre, never about the shape frame's origin,
 so moving the sphere moves the centre and leaves the inertia where it was.

 box3d checks neither the radius nor the density. Both run straight into the volume, so a
 negative one of either yields a negative mass instead of a refusal.
*>
extern fn MassData Sphere.compute_mass_data(&self, float density) @cname("b3ComputeSphereMass");

<*
 The bounds of the sphere placed by this transform. Exact rather than conservative: box3d carries
 the centre through the transform and adds the radius on each axis, so a rotation moves the box
 without widening it. The hull, mesh, height field and compound bounds all rotate a cached box
 instead and do widen — see HullData.compute_aabb().
*>
extern fn Aabb Sphere.compute_aabb(&self, Transform transform) @cname("b3ComputeSphereAABB");

<*
 The mass, centre of mass and inertia of the capsule at this density: a cylinder between the two
 centres plus one ball's worth of end caps. The centre is the midpoint of the two, and the tensor
 is rotated so its axial column follows the segment rather than the y axis it is built on.

 Two centres too close to leave a cylinder weigh the end caps alone — a ball, not a refusal — and
 neither the radius nor the density is checked, so a negative one yields a negative mass.
*>
extern fn MassData Capsule.compute_mass_data(&self, float density) @cname("b3ComputeCapsuleMass");

<*
 The bounds of the capsule placed by this transform. Exact for the reason Sphere.compute_aabb()
 is: box3d carries both centres through the transform and adds the radius to the box around them,
 so a rotation moves the box without widening it.
*>
extern fn Aabb Capsule.compute_aabb(&self, Transform transform) @cname("b3ComputeCapsuleAABB");

<*
 The ceiling create_hull() clamps max_vertex_count to. Mirrors B3_MAX_HULL_VERTICES in
 constants.h, which the C API does not expose as a function and no layout pin can see. box3d
 fixes it for performance: the hull's vertex, edge and face indices are all single bytes.
*>
const int MAX_HULL_VERTICES = 128;

<*
 The most ring steps create_cylinder() and create_cone() accept. Not box3d's number: the widest
 either builds is a cone with one radius at zero, at 64, and both refuse below that on their own
 edge and face ceilings. The bound exists because far above it box3d writes through an allocation
 that failed rather than refusing.
*>
const int MAX_HULL_RING_STEPS = 64;

struct HullVertex {
    char edge;
}

struct HullHalfEdge {
    char next;
    char twin;
    char origin;
    char face;
}

struct HullFace {
    char edge;
}

<*
 A convex hull. The arrays live past the end of the struct and are reached through the byte
 offsets it carries, so a bare HullData must never be copied — only a BoxHull, which embeds
 one together with its storage, copies correctly.

 create_hull() and its siblings in box3d_hull.c3 allocate one the caller owns and must destroy()
 exactly once; byte_count() carries it until then. A BoxHull owns its storage instead, so calling
 destroy() on its base frees a pointer box3d never allocated.
*>
struct HullData {
    ulong version;
    ulong hash;
    Aabb aabb;
    float surface_area;
    float volume;
    float inner_radius;
    Vec3 center;
    Matrix3 central_inertia;
    int vertex_count;
    int vertex_offset;
    int point_offset;
    int edge_count;
    int edge_offset;
    int face_count;
    int plane_offset;
    int face_offset;
    int soa_vertex_offset;
    int soa_normal_offset;
    int byte_count;
}

struct BoxHull {
    HullData base;
    HullVertex[8] box_vertices;
    Vec3[8] box_points;
    HullHalfEdge[24] box_edges;
    Plane[6] box_planes;
    HullFace[6] box_faces;
    char[2] padding;
    float[8] vx;
    float[8] vy;
    float[8] vz;
    float[8] nx;
    float[8] ny;
    float[8] nz;
}

extern fn BoxHull make_cube_hull(float half_width) @cname("b3MakeCubeHull");
extern fn BoxHull make_box_hull(float hx, float hy, float hz) @cname("b3MakeBoxHull");
extern fn BoxHull make_offset_box_hull(float hx, float hy, float hz, Vec3 offset) @cname("b3MakeOffsetBoxHull");
extern fn BoxHull make_transformed_box_hull(float hx, float hy, float hz, Transform transform) @cname("b3MakeTransformedBoxHull");
extern fn BoxHull make_scaled_box_hull(Vec3 half_widths, Transform transform, Vec3 post_scale) @cname("b3MakeScaledBoxHull");

<*
 A box with a post scale resolved into it, as scale_box() reports one. A C3 type with no C
 counterpart: box3d rewrites the half widths and the placement it was handed, through two in-out
 pointers.
*>
struct ScaledBox {
    Vec3 half_widths;
    Transform transform;
}

<*
 Raw box scaler. Rewrites both of the arguments it is handed, so box3d_hull.c3's scale_box is the
 only public way in.
*>
extern fn void scale_box_raw(Vec3* half_widths, Transform* transform, Vec3 post_scale, float min_half_width) @cname("b3ScaleBox") @private;

<*
 Raw hull constructors, whose null returns the wrappers in box3d_hull.c3 turn into faults; those
 wrappers are the only public way in. The cylinder, cone and rock end in b3CreateHull and answer
 null for a point set it will not close. The two clones do not: they allocate and copy, and answer
 null for an absent hull or, when transformed, for a volume the rebake underflows.
*>
extern fn HullData* create_hull_raw(Vec3* points, int point_count, int max_vertex_count) @cname("b3CreateHull") @private;
extern fn HullData* create_cylinder_raw(float height, float radius, float y_offset, int sides) @cname("b3CreateCylinder") @private;
extern fn HullData* create_cone_raw(float height, float radius1, float radius2, int slices) @cname("b3CreateCone") @private;
extern fn HullData* create_rock_raw(float radius) @cname("b3CreateRock") @private;
extern fn HullData* clone_hull_raw(HullData* hull) @cname("b3CloneHull") @private;
extern fn HullData* clone_and_transform_hull_raw(HullData* hull, Transform transform, Vec3 scale) @cname("b3CloneAndTransformHull") @private;

<*
 Releases a hull box3d_hull.c3 returned, exactly once.

 Only those. A BoxHull's base, a compound's hull child and the hull a shape reports are all owned
 by something else and abort the process or corrupt it here — see HullData.
*>
extern fn void HullData.destroy(&self) @cname("b3DestroyHull");

<*
 The mass and inertia of the hull at this density, both linear in it, about the hull's own
 centroid — which box3d hands back unscaled, having baked all three at build time rather than
 integrating again. HullData.clone_and_transform() re-bakes them for a placed or scaled copy.

 The density is unchecked, so a negative one yields a negative mass and tensor, not a refusal.
*>
extern fn MassData HullData.compute_mass_data(&self, float density) @cname("b3ComputeHullMass");

<*
 The box in HullData.aabb carried through this transform, never a refit of the points. box3d
 widens it by the absolute of the rotation matrix, which is exact only where the rotation carries
 the coordinate axes onto coordinate axes — a quarter turn about one of them, but a half turn
 about a face diagonal and a third turn about a body diagonal too. Anything else, an eighth turn
 included, answers wider. clone_and_transform() bakes the rotation in and its aabb is tight.
*>
extern fn Aabb HullData.compute_aabb(&self, Transform transform) @cname("b3ComputeHullAABB");

<*
 The collision data behind a triangle mesh shape. box3d allocates it and the caller owns it: call
 destroy() exactly once, and hold the pointer until every shape built on it is gone. byte_count()
 carries the allocation, so a mesh never destroyed shifts that count for the rest of the process
 exactly as a leaked world does. The triangles, vertices and hierarchy hang off the end of that
 one allocation at byte offsets from its own address, so the mesh is opaque here and could not be
 copied anyway. Build one with create_grid_mesh() and its siblings in box3d_mesh.c3.
*>
typedef MeshData = void;

<*
 The geometry create_mesh() builds a mesh from. box3d copies everything it reads, so none of
 these arrays has to outlive the call. There is no default_mesh_def() upstream and no cookie,
 so a definition carries no mark of being well formed and is written field by field.

 vertices must hold vertex_count points and indices 3 * triangle_count indices, wound
 counter-clockwise. material_indices is optional and holds one index per triangle.
*>
struct MeshDef {
    Vec3* vertices;
    int* indices;
    char* material_indices;
    float weld_tolerance;
    int vertex_count;
    int triangle_count;
    bool weld_vertices;
    bool use_median_split;
    bool identify_edges;
}

<*
 A mesh shape's geometry as the shape holds it: the mesh it borrows and the scale it reads that
 mesh through. ShapeId.mesh() hands back a copy of the pair, never of the geometry — data is the
 caller's own mesh pointer, still the caller's to destroy and still bound to outlive the shape.

 That ownership belongs to ShapeId.mesh() alone. The same struct is the mesh arm of ChildShape,
 where data addresses the compound's own allocation instead and destroying it aborts the process.
*>
struct Mesh {
    MeshData* data;
    Vec3 scale;
}

<*
 The collision data behind a height field shape. Ownership, the byte count and the trailing
 arrays all work exactly as they do for MeshData — see there.

 Build one with create_height_field_grid() and its siblings in box3d_mesh.c3.
*>
typedef HeightFieldData = void;

<*
 The grid create_height_field() builds a height field from. box3d copies everything it reads,
 so neither array has to outlive the call, and there is no default definition or cookie.

 heights must hold count_x * count_z samples, one per grid point, in units the scale is applied
 to afterwards; heights outside the global range are clamped to it before being quantised into
 16 bits. material_indices is optional and holds one index per cell, where 0xFF marks a hole.
*>
struct HeightFieldDef {
    float* heights;
    char* material_indices;
    Vec3 scale;
    int count_x;
    int count_z;
    float global_minimum_height;
    float global_maximum_height;
    bool clockwise_winding;
}

<*
 Raw mesh constructors. Every one of them builds a b3MeshDef and hands it to b3CreateMesh, so
 every one returns a null pointer for geometry box3d cannot use; the wrappers in box3d_mesh.c3
 turn that into a fault and are the only public way in.
*>
extern fn MeshData* create_grid_mesh_raw(int x_count, int z_count, float cell_width, int material_count, bool identify_edges) @cname("b3CreateGridMesh") @private;
extern fn MeshData* create_wave_mesh_raw(int x_count, int z_count, float cell_width, float amplitude, float row_frequency, float column_frequency) @cname("b3CreateWaveMesh") @private;
extern fn MeshData* create_torus_mesh_raw(int radial_resolution, int tubular_resolution, float radius, float thickness) @cname("b3CreateTorusMesh") @private;
extern fn MeshData* create_box_mesh_raw(Vec3 center, Vec3 extent, bool identify_edges) @cname("b3CreateBoxMesh") @private;
extern fn MeshData* create_hollow_box_mesh_raw(Vec3 center, Vec3 extent) @cname("b3CreateHollowBoxMesh") @private;
extern fn MeshData* create_platform_mesh_raw(Vec3 center, float height, float top_width, float bottom_width) @cname("b3CreatePlatformMesh") @private;
extern fn MeshData* create_mesh_raw(MeshDef* def, int* degenerate_triangle_indices, int degenerate_capacity) @cname("b3CreateMesh") @private;

<*
 Releases the mesh. The caller owns it and must call this exactly once — see MeshData.
*>
extern fn void MeshData.destroy(&self) @cname("b3DestroyMesh");

<*
 The height of the mesh's bounding volume hierarchy, not any dimension of the mesh itself: it
 is the number of levels below the root, so a mesh small enough to fit in one leaf reports 0.
*>
extern fn int MeshData.tree_height(&self) @cname("b3GetHeight");

<*
 The bounds of the mesh scaled and then placed by this transform. The scale multiplies the mesh's
 cached bounds component by component in mesh space and box3d re-orders the corners afterwards,
 so a negative component mirrors the box rather than turning it inside out, and a zero one
 flattens it. The placement then widens the box under rotation exactly as
 HullData.compute_aabb() does.
*>
extern fn Aabb MeshData.compute_aabb(&self, Transform transform, Vec3 scale) @cname("b3ComputeMeshAABB");

<*
 Raw height field constructors. None of them can return a null pointer — box3d allocates
 whatever it is asked for, including a grid with no cells at all — so the wrappers in
 box3d_mesh.c3 carry the guards instead and are the only public way in.
*>
extern fn HeightFieldData* create_height_field_raw(HeightFieldDef* def) @cname("b3CreateHeightField") @private;
extern fn HeightFieldData* create_grid_raw(int row_count, int column_count, Vec3 scale, bool make_holes) @cname("b3CreateGrid") @private;
extern fn HeightFieldData* create_wave_raw(int row_count, int column_count, Vec3 scale, float row_frequency, float column_frequency, bool make_holes) @cname("b3CreateWave") @private;

<*
 Releases the height field. The caller owns it and must call this exactly once — see MeshData.
*>
extern fn void HeightFieldData.destroy(&self) @cname("b3DestroyHeightField");

<*
 The bounds of the height field placed by this transform. The scale the field was built with is
 already inside the cached box this carries through, which is why there is no scale argument
 here and MeshData.compute_aabb() has one. The placement widens the box under rotation exactly
 as HullData.compute_aabb() does.
*>
extern fn Aabb HeightFieldData.compute_aabb(&self, Transform transform) @cname("b3ComputeHeightFieldAABB");

<*
 The two children of an internal tree node, as indices into the tree's own node array. box3d
 writes -1 in either of them where there is no child.
*>
struct TreeNodeChildren {
    int child1;
    int child2;
}

<*
 A tree node's flags. box3d sets LEAF with ALLOCATED when a proxy is created and clears the word
 when the slot is freed; nothing else in the tree writes either bit, so LEAF is an exact test for
 whether a node index names a live proxy. ENLARGED is box3d's own rebuild bookkeeping.
*>
const ushort TREE_NODE_ALLOCATED = 0x0001;
const ushort TREE_NODE_ENLARGED = 0x0002;
const ushort TREE_NODE_LEAF = 0x0004;

<*
 One node of a dynamic tree, declared because the tree's two proxy accessors are inline in box3d's
 header rather than exported, so box3d_tree.c3 reimplements them over these fields.

 A node is a leaf, an internal node or a free slot: the shared eight bytes are a proxy's user
 data, two child indices, or the next free slot. flags says which — TREE_NODE_LEAF is the only
 reading under which user_data and aabb mean anything.
*>
struct TreeNode {
    Aabb aabb;
    ulong category_bits;
    union {
        TreeNodeChildren children;
        ulong user_data;
    }
    union {
        int parent;
        int next;
    }
    ushort height;
    ushort flags;
}

<*
 A bounding volume hierarchy over proxies, held by value: 80 bytes pointing at a pool box3d
 allocated, so a copy leaves two structs sharing one pool and only one may be destroyed. Pass it
 on as &tree; the pool moves every node as it grows, so nodes is not a pointer to hold on to.

 A compound's tree is neither the caller's to destroy nor to modify: destroy() frees into the
 middle of the compound, and its free list points at live geometry, so create_proxy() overwrites
 a child and hides it from every query with nothing reporting the loss.
*>
struct DynamicTree {
    ulong version;
    TreeNode* nodes;
    int root;
    int node_count;
    int node_capacity;
    int proxy_count;
    int free_list;
    int* leaf_indices;
    Aabb* leaf_boxes;
    Vec3* leaf_centers;
    int* bin_indices;
    int rebuild_capacity;
}

<*
 Builds an empty tree and the node pool it inserts into.

 proxy_capacity is a starting size and never a ceiling: box3d raises anything below 16 — a
 negative argument included — to 16, so every argument from 16 down builds the same tree, and the
 pool grows past it as needed. The tree comes back by value and the caller owns it: destroy() it
 exactly once, and see DynamicTree for what a copy means. The 80-byte struct is the caller's own
 storage; the node pool is on byte_count(), as a world or a mesh is.
*>
extern fn DynamicTree create_tree(int proxy_capacity) @cname("b3DynamicTree_Create");

<*
 Releases the node pool and the rebuild arrays, then zeroes the tree, so a second call on the
 same struct frees nothing. That protects no copy: a copy still holds the freed pointer. See
 DynamicTree, which also covers the tree a compound owns.

 The zero it leaves is not the empty-tree state — box3d marks an empty root with -1, so height(),
 area_ratio() and root_bounds() read a freed pool afterwards and crash. Everything else here is
 safe on it: the rest test the node count, which the zeroing sets to 0.
*>
extern fn void DynamicTree.destroy(&self) @cname("b3DynamicTree_Destroy");

extern fn int create_proxy_raw(
  DynamicTree* tree,
  Aabb aabb,
  ulong category_bits,
  ulong user_data,
) @cname("b3DynamicTree_CreateProxy") @private;

<*
 Raw proxy calls that index the node array on an id the caller supplies, under assertions this
 build compiles out. box3d_tree.c3 carries the guards and is the only public way in.
*>
extern fn void destroy_proxy_raw(DynamicTree* tree, int proxy_id) @cname("b3DynamicTree_DestroyProxy") @private;
extern fn void move_proxy_raw(DynamicTree* tree, int proxy_id, Aabb aabb) @cname("b3DynamicTree_MoveProxy") @private;
extern fn void enlarge_proxy_raw(DynamicTree* tree, int proxy_id, Aabb aabb) @cname("b3DynamicTree_EnlargeProxy") @private;
extern fn void set_category_bits_raw(DynamicTree* tree, int proxy_id, ulong category_bits) @cname("b3DynamicTree_SetCategoryBits") @private;
extern fn ulong category_bits_raw(DynamicTree* tree, int proxy_id) @cname("b3DynamicTree_GetCategoryBits") @private;

<*
 The number of levels below the root, so a tree holding a single proxy reports 0 and so does an
 empty one.
*>
extern fn int DynamicTree.height(&self) @cname("b3DynamicTree_GetHeight");

<*
 The summed perimeter of the internal nodes over the root's. Leaves and the root are skipped, so
 a tree whose only internal node is the root reports 0 — two proxies or fewer, not an empty tree.
 A root with no volume, which proxies holding the zero box give at any count, divides by zero and
 reports NaN rather than 0.
*>
extern fn float DynamicTree.area_ratio(&self) @cname("b3DynamicTree_GetAreaRatio");

<*
 The box containing every proxy. An empty tree reports the type's zero rather than an inverted or
 otherwise marked box, so a caller cannot tell it from a degenerate box at the origin.
*>
extern fn Aabb DynamicTree.root_bounds(&self) @cname("b3DynamicTree_GetRootBounds");

<*
 Arithmetic over the capacities rather than a reading of the heap: it counts the caller's own
 80-byte struct, which is not on the heap, and after a rebuild two arrays box3d's median split
 never allocates. The module's byte_count() is the number the allocator agrees with.
*>
extern fn int DynamicTree.byte_count(&self) @cname("b3DynamicTree_GetByteCount");

<*
 Rebalances the tree and returns the number of boxes it sorted. A partial build keeps every
 subtree box3d has not marked enlarged and so sorts far fewer boxes than a full one — but any
 enlarge_proxy() marks the whole ancestor chain, so one of those undoes the saving. Either build
 allocates the rebuild arrays when it has something to sort, and byte_count() carries them.
*>
extern fn int DynamicTree.rebuild(&self, bool full_build) @cname("b3DynamicTree_Rebuild");

<*
 Called once for each proxy a query finds. Returning false ends the traversal, and the tree must
 not be modified from inside the call: the traversal carries node indices across it, and a proxy
 created or destroyed there makes them name something else.
*>
alias TreeQueryFn = fn bool(int proxy_id, ulong user_data, void* context);

<*
 Called once for each proxy a closest query reaches, given the search bound as it stands. Only a
 return value below that bound takes effect, so the callback is what measures anything — see
 DynamicTree.query_closest(). TreeQueryFn's rule against modifying the tree holds here too, and
 for the same reason.
*>
alias TreeClosestFn = fn float(float search_bound, int proxy_id, ulong user_data, void* context);

<*
 Reports proxies whose box overlaps aabb, calling fcn once for each until it returns false — every
 one, unless the tree exhausts box3d's 1024-entry traversal stack, which drops a whole subtree and
 reports the short answer as a normal one. Only a degenerate tree of nested boxes reaches that.

 The mask flags do not refine each other: loosely a node passes on any bit in common, strictly on
 every bit of the mask, and only a single-bit mask agrees for every proxy. A zero mask reports
 nothing loosely and everything strictly.
*>
extern fn TreeStats DynamicTree.query(
  &self,
  Aabb aabb,
  ulong mask_bits,
  bool require_all_bits,
  TreeQueryFn fcn,
  void* context,
) @cname("b3DynamicTree_Query");

<*
 The closest traversal, whose in-out float box3d calls minDistanceSqr. box3d_tree.c3 takes that
 bound by value and is the only public way in.
*>
extern fn TreeStats query_closest_raw(
  DynamicTree* tree,
  Vec3 point,
  ulong mask_bits,
  bool require_all_bits,
  TreeClosestFn fcn,
  void* context,
  float* search_bound,
) @cname("b3DynamicTree_QueryClosest") @private;

<*
 What a closest query ended with: box3d's traversal counters and the bound the callback left,
 which is the bound the query started with when nothing returned anything smaller. A C3 type with
 no C counterpart — box3d passes the bound back through the in-out float it was given.
*>
struct ClosestSearch {
    TreeStats stats;
    float search_bound;
}

<*
 An axis-aligned box swept along translation, in the tree's own frame. The box never rotates, and
 what travels is its centre: DynamicTree.box_cast() grows each node box by this one's half-extents
 on all three axes and runs the centre's line through that, so the box enters the sweep only as a
 centre and a size.
*>
struct BoxCastInput {
    Aabb box;
    Vec3 translation;
    float max_fraction;
}

<*
 Called once for each proxy a ray cast reaches, given the input with max_fraction narrowed to the
 bound the cast currently holds. Returning 0 ends the traversal, a value between 0 and that bound
 clips the ray to it, and the bound itself continues unclipped; anything negative does neither,
 which is how box3d skips a proxy. TreeQueryFn's rule against modifying the tree holds here too.
*>
alias TreeRayCastFn = fn float(RayCastInput* input, int proxy_id, ulong user_data, void* context);

<*
 The box cast's counterpart to TreeRayCastFn, over a BoxCastInput and with the same return
 contract and the same rule against modifying the tree.
*>
alias TreeBoxCastFn = fn float(BoxCastInput* input, int proxy_id, ulong user_data, void* context);

<*
 Reports the proxies whose box the ray crosses, calling fcn once for each. This is the broad phase
 alone — a proxy is offered because the ray met its box, and the exact cast against whatever that
 box holds is the callback's work. query() gives the mask flags and the traversal stack's limit,
 which apply here too, and TreeRayCastFn gives what fcn's return does.
*>
extern fn TreeStats DynamicTree.ray_cast(
  &self,
  RayCastInput* input,
  ulong mask_bits,
  bool require_all_bits,
  TreeRayCastFn fcn,
  void* context,
) @cname("b3DynamicTree_RayCast");

<*
 Sweeps the input's box along its translation and reports the proxies it reaches, on the terms
 ray_cast() states and with TreeBoxCastFn in place of TreeRayCastFn. See BoxCastInput for what
 box3d sweeps, which is not the box itself.
*>
extern fn TreeStats DynamicTree.box_cast(
  &self,
  BoxCastInput* input,
  ulong mask_bits,
  bool require_all_bits,
  TreeBoxCastFn fcn,
  void* context,
) @cname("b3DynamicTree_BoxCast");

<*
 The ceiling on a compound's children, which is one more than the number it can hold: box3d
 refuses a definition naming this many. Mirrors B3_MAX_CHILD_SHAPES in constants.h, which the C
 API does not expose as a function and no layout pin can see, so a change to B3_SHAPE_POWER
 upstream moves the real ceiling without moving this.
*>
const int MAX_CHILD_SHAPES = 1048576;

<*
 The number of surface materials one mesh child of a compound can carry. Mirrors
 B3_MAX_COMPOUND_MESH_MATERIALS in types.h, which the C API does not expose as a function. A mesh
 with more materials than this has to be used outside a compound.
*>
const int MAX_COMPOUND_MESH_MATERIALS = 4;

<*
 The baked collision data behind a compound shape: spheres, capsules, hulls and meshes flattened
 into one tree a world populates as a single shape. Ownership and the byte count are MeshData's;
 this type is declared in full because its counts are reachable nowhere else. The children live
 past the end of the struct at byte offsets, so a bare CompoundData must never be copied, and the
 accessors trust the counts — assigning to one moves the bound they check. shared_hull_count and
 shared_mesh_count count distinct geometry, not children.
*>
struct CompoundData {
    ulong version;
    int byte_count;
    int node_offset;
    DynamicTree tree;
    int material_offset;
    int material_count;
    int capsule_offset;
    int capsule_count;
    int hull_offset;
    int hull_count;
    int shared_hull_count;
    int mesh_offset;
    int mesh_count;
    int shared_mesh_count;
    int sphere_offset;
    int sphere_count;
}

<*
 A sphere child of a compound. The sphere carries its own centre in compound local space, so
 there is no separate transform.
*>
struct CompoundSphereDef {
    Sphere sphere;
    SurfaceMaterial material;
}

<*
 A capsule child of a compound. The capsule carries its own two centres in compound local space,
 so there is no separate transform.
*>
struct CompoundCapsuleDef {
    Capsule capsule;
    SurfaceMaterial material;
}

<*
 A hull child of a compound. The hull is cloned into the compound, so it does not have to outlive
 create_compound(), and children naming the same hull store it once between them.
*>
struct CompoundHullDef {
    HullData* hull;
    Transform transform;
    SurfaceMaterial material;
}

<*
 A mesh child of a compound. The mesh is cloned in, so it need not outlive create_compound(), and
 children naming the same mesh store it once between them. material_count must equal the mesh's
 own material count, not merely be compatible: box3d asserts that and this build compiles the
 assertion out, so naming fewer silently folds every triangle material above the last named onto
 entry 0. It is capped at MAX_COMPOUND_MESH_MATERIALS too. scale is stored as given — unlike a
 mesh shape's it is not pushed away from zero.
*>
struct CompoundMeshDef {
    MeshData* mesh_data;
    Transform transform;
    Vec3 scale;
    SurfaceMaterial* materials;
    int material_count;
}

<*
 The children create_compound() bakes into a compound, a pointer and a count per kind. box3d
 clones everything it reads, so none of the arrays has to outlive the call. There is no
 default_compound_def() upstream and no cookie, so a definition is written field by field, and an
 all-zero one is a legal request for a compound with no children rather than a malformed one.
*>
struct CompoundDef {
    CompoundCapsuleDef* capsules;
    int capsule_count;
    CompoundHullDef* hulls;
    int hull_count;
    CompoundMeshDef* meshes;
    int mesh_count;
    CompoundSphereDef* spheres;
    int sphere_count;
}

<*
 A capsule child as the compound holds it. The capsule is in compound local space and carries its
 own two centres, so there is no transform to go with it, and material_index selects one entry of
 CompoundData.materials().
*>
struct CompoundCapsule {
    Capsule capsule;
    int material_index;
}

<*
 A hull child as the compound holds it. The hull points inside the compound's own allocation and
 is shared by every child that named the same hull, so it lives and dies with the compound and
 must not be destroyed on its own. transform places it in compound local space and material_index
 selects one entry of CompoundData.materials().
*>
struct CompoundHull {
    HullData* hull;
    Transform transform;
    int material_index;
}

<*
 A mesh child as the compound holds it. mesh_data points inside the compound's own allocation, not
 at the mesh create_compound() was given, so it dies with the compound and must not be destroyed
 on its own. material_indices is a second indirection: a triangle's material index, clamped to
 MAX_COMPOUND_MESH_MATERIALS, selects a slot here, which selects an entry of
 CompoundData.materials(). Unused slots read 0, a real index rather than a marker, so the struct
 cannot say how many are meaningful.
*>
struct CompoundMesh {
    MeshData* mesh_data;
    Transform transform;
    Vec3 scale;
    int[MAX_COMPOUND_MESH_MATERIALS] material_indices;
}

<*
 A sphere child as the compound holds it. The sphere is in compound local space and carries its
 own centre, so there is no transform to go with it, and material_index selects one entry of
 CompoundData.materials().
*>
struct CompoundSphere {
    Sphere sphere;
    int material_index;
}

<*
 One child of a compound in the flat form CompoundData.child() reports, whatever kind it is.

 type is the union's tag; reading another arm yields plausible geometry rather than an error, so a
 caller that knows the kind it wants should reach for capsule(), hull(), mesh() or sphere().
 transform is identity for a capsule and a sphere, which carry their own placement.
 material_indices reads as on CompoundMesh, and the hull and mesh arms borrow the compound's
 allocation: destroying either frees a pointer never separately allocated and aborts.
*>
struct ChildShape {
    union {
        Capsule capsule;
        HullData* hull;
        Mesh mesh;
        Sphere sphere;
    }
    Transform transform;
    int[MAX_COMPOUND_MESH_MATERIALS] material_indices;
    ShapeType type;
}

<*
 Raw compound constructor. Exactly one definition makes it return a null pointer — one naming
 MAX_CHILD_SHAPES children or more — and it reads the four child arrays, and the hull and mesh
 each child names, without testing any of them for null. The wrapper in box3d_compound.c3 carries
 the guards for all of it and is the only public way in.
*>
extern fn CompoundData* create_compound_raw(CompoundDef* def) @cname("b3CreateCompound") @private;

<*
 Releases the compound. The caller owns it and must call this exactly once — see MeshData.
*>
extern fn void CompoundData.destroy(&self) @cname("b3DestroyCompound");

<*
 Raw child accessors. Every one of them asserts its index and this release build compiles the
 assertion out, so each reads its array unconditionally and an index outside the count reaches
 memory that is not a child. The wrappers in box3d_compound.c3 restore the bound and are the only
 public way in.
*>
extern fn ChildShape compound_child_raw(CompoundData* compound, int child_index) @cname("b3GetCompoundChild") @private;
extern fn CompoundCapsule compound_capsule_raw(CompoundData* compound, int index) @cname("b3GetCompoundCapsule") @private;
extern fn CompoundHull compound_hull_raw(CompoundData* compound, int index) @cname("b3GetCompoundHull") @private;
extern fn CompoundMesh compound_mesh_raw(CompoundData* compound, int index) @cname("b3GetCompoundMesh") @private;
extern fn CompoundSphere compound_sphere_raw(CompoundData* compound, int index) @cname("b3GetCompoundSphere") @private;

<*
 Raw material accessor. It carries no count, and the pointer it returns is non-null even for a
 compound with no materials at all — it then addresses the first byte past the allocation — so the
 wrapper in box3d_compound.c3 pairs it with the count and is the only public way in.
*>
extern fn SurfaceMaterial* compound_materials_raw(CompoundData* compound) @cname("b3GetCompoundMaterials") @private;

<*
 Raw compound bounds. box3d indexes the compound's node array at the tree's root without testing
 it, and a compound with no children carries the root -1, so the wrapper in box3d_compound.c3
 refuses that one case and is the only public way in.
*>
extern fn Aabb compute_compound_aabb_raw(CompoundData* compound, Transform transform) @cname("b3ComputeCompoundAABB") @private;

<*
 Raw shape constructors. Each bypasses the definition-cookie guard its wrapper in
 box3d_shape.c3 applies, so they are private to the module.
*>
extern fn ShapeId create_sphere_shape_raw(BodyId body_id, ShapeDef* def, Sphere* sphere) @cname("b3CreateSphereShape") @private;
extern fn ShapeId create_capsule_shape_raw(BodyId body_id, ShapeDef* def, Capsule* capsule) @cname("b3CreateCapsuleShape") @private;
extern fn ShapeId create_hull_shape_raw(BodyId body_id, ShapeDef* def, HullData* hull) @cname("b3CreateHullShape") @private;
extern fn ShapeId create_transformed_hull_shape_raw(BodyId body_id, ShapeDef* def, HullData* hull, Transform transform, Vec3 scale) @cname("b3CreateTransformedHullShape") @private;

<*
 Raw mesh and height field shape constructors, private because they bypass the null-geometry guard
 their wrappers in box3d_mesh.c3 apply — box3d reads a version field through the pointer before it
 tests anything.
*>
extern fn ShapeId create_mesh_shape_raw(
  BodyId body_id,
  ShapeDef* def,
  MeshData* mesh,
  Vec3 scale,
) @cname("b3CreateMeshShape") @private;

extern fn ShapeId create_height_field_shape_raw(
  BodyId body_id,
  ShapeDef* def,
  HeightFieldData* height_field,
) @cname("b3CreateHeightFieldShape") @private;

<*
 Raw baked compound shape constructor. It reads the compound's version field before it tests
 anything, so it shares the null hazard of the two above, and the wrapper in box3d_compound.c3
 carries the same guards. Private for that reason.
*>
extern fn ShapeId create_baked_compound_shape_raw(
  BodyId body_id,
  ShapeDef* def,
  CompoundData* compound,
) @cname("b3CreateBakedCompoundShape") @private;

extern fn void ShapeId.destroy(self, bool update_body_mass) @cname("b3DestroyShape");
extern fn bool ShapeId.is_valid(self) @cname("b3Shape_IsValid");
extern fn ShapeType ShapeId.type(self) @cname("b3Shape_GetType");
extern fn BodyId ShapeId.body(self) @cname("b3Shape_GetBody");
extern fn WorldId ShapeId.world(self) @cname("b3Shape_GetWorld");
extern fn bool ShapeId.is_sensor(self) @cname("b3Shape_IsSensor");
extern fn void ShapeId.enable_sensor_events(self, bool flag) @cname("b3Shape_EnableSensorEvents");
extern fn bool ShapeId.are_sensor_events_enabled(self) @cname("b3Shape_AreSensorEventsEnabled");
extern fn void ShapeId.set_name(self, ZString name) @cname("b3Shape_SetName");
extern fn ZString ShapeId.name(self) @cname("b3Shape_GetName");
extern fn void ShapeId.set_user_data(self, void* user_data) @cname("b3Shape_SetUserData");
extern fn void* ShapeId.user_data(self) @cname("b3Shape_GetUserData");
extern fn void ShapeId.set_density(self, float density, bool update_body_mass) @cname("b3Shape_SetDensity");
extern fn float ShapeId.density(self) @cname("b3Shape_GetDensity");
extern fn void ShapeId.set_friction(self, float friction) @cname("b3Shape_SetFriction");
extern fn void ShapeId.set_restitution(self, float restitution) @cname("b3Shape_SetRestitution");
extern fn void ShapeId.set_surface_material(self, SurfaceMaterial surface_material) @cname("b3Shape_SetSurfaceMaterial");

<*
 The shape's surface material, and the two of its fields that have accessors of their own; all
 three read the shape's first material. A shape whose mesh_material_count() is 0 has none to read
 and answers with an inline one box3d never assigned — in a recycled slot, the previous shape's
 material, not the definition's base_material. Only a shape built from an empty compound reports
 0, and mesh_surface_material() refuses every index on it instead.
*>
extern fn float ShapeId.friction(self) @cname("b3Shape_GetFriction");
extern fn float ShapeId.restitution(self) @cname("b3Shape_GetRestitution");
extern fn SurfaceMaterial ShapeId.surface_material(self) @cname("b3Shape_GetSurfaceMaterial");

<*
 How many surface materials this shape holds — not a mesh-only count despite the name. A
 definition naming fewer than two keeps one inline and reports 1 whatever the type; a shape built
 from a compound answers from the compound's distinct child materials, so an empty compound gives
 0.

 The count is fixed at creation, so such a shape still reports 0 once set_sphere() has made it a
 sphere. It says nothing about the geometry the shape holds now.
*>
extern fn int ShapeId.mesh_material_count(self) @cname("b3Shape_GetMeshMaterialCount");

<*
 Raw indexed material accessors. box3d asserts the index is in range and this release build
 compiles that assertion out, leaving a read and a write past the end of the shape's material
 array, so the wrappers in box3d_shape.c3 are the only public way in.
*>
extern fn SurfaceMaterial mesh_surface_material_raw(ShapeId shape_id, int index) @cname("b3Shape_GetMeshSurfaceMaterial") @private;
extern fn void set_mesh_material_raw(ShapeId shape_id, SurfaceMaterial surface_material, int index) @cname("b3Shape_SetMeshMaterial") @private;

extern fn Filter ShapeId.filter(self) @cname("b3Shape_GetFilter");
extern fn void ShapeId.set_filter(self, Filter filter, bool invoke_contacts) @cname("b3Shape_SetFilter");
extern fn void ShapeId.enable_contact_events(self, bool flag) @cname("b3Shape_EnableContactEvents");
extern fn bool ShapeId.are_contact_events_enabled(self) @cname("b3Shape_AreContactEventsEnabled");
extern fn void ShapeId.enable_pre_solve_events(self, bool flag) @cname("b3Shape_EnablePreSolveEvents");
extern fn bool ShapeId.are_pre_solve_events_enabled(self) @cname("b3Shape_ArePreSolveEventsEnabled");
extern fn void ShapeId.enable_hit_events(self, bool flag) @cname("b3Shape_EnableHitEvents");
extern fn bool ShapeId.are_hit_events_enabled(self) @cname("b3Shape_AreHitEventsEnabled");

<*
 Raw geometry accessors. Each reads a union member box3d selects by shape type and asserts, in a
 debug build, that the type matches; that assertion is compiled out here, so the checked getters
 in box3d_shape.c3 are the only public way in.
*>
extern fn Sphere sphere_raw(ShapeId shape_id) @cname("b3Shape_GetSphere") @private;
extern fn Capsule capsule_raw(ShapeId shape_id) @cname("b3Shape_GetCapsule") @private;
extern fn HullData* hull_raw(ShapeId shape_id) @cname("b3Shape_GetHull") @private;
extern fn Mesh mesh_raw(ShapeId shape_id) @cname("b3Shape_GetMesh") @private;
extern fn HeightFieldData* height_field_raw(ShapeId shape_id) @cname("b3Shape_GetHeightField") @private;

<*
 Sets the shape's geometry and, with it, its type — a capsule handed a sphere becomes a sphere.
 The body's mass is not recomputed until BodyId.apply_mass_from_shapes() is called.
*>
extern fn void ShapeId.set_sphere(self, Sphere* sphere) @cname("b3Shape_SetSphere");
extern fn void ShapeId.set_capsule(self, Capsule* capsule) @cname("b3Shape_SetCapsule");
extern fn void ShapeId.set_hull(self, HullData* hull) @cname("b3Shape_SetHull");

<*
 Raw mesh setter. Private because a null mesh here is a segmentation fault rather than a refusal —
 box3d recomputes the shape's bounds through the pointer as part of the change — so the wrapper in
 box3d_shape.c3 is the only public way in.
*>
extern fn void set_mesh_raw(ShapeId shape_id, MeshData* mesh, Vec3 scale) @cname("b3Shape_SetMesh") @private;

<*
 The geometry box widened by box3d's fixed speculative distance — neither the tight box the
 compute_aabb() functions answer nor the larger, body-type-dependent box the broad phase indexes
 and tests before moving a proxy.
*>
extern fn Aabb ShapeId.aabb(self) @cname("b3Shape_GetAABB");
extern fn MassData ShapeId.compute_mass_data(self) @cname("b3Shape_ComputeMassData");
extern fn Vec3 ShapeId.closest_point(self, Vec3 target) @cname("b3Shape_GetClosestPoint");
extern fn void ShapeId.apply_wind(self, Vec3 wind, float drag, float lift, float max_speed, bool wake) @cname("b3Shape_ApplyWind");

<*
 A shape began overlapping a sensor shape during the last step. Both shapes must have asked for
 sensor events in their definition — the visitor as well as the sensor.
*>
struct SensorBeginTouchEvent {
    ShapeId sensor_shape_id;
    ShapeId visitor_shape_id;
}

<*
 A shape stopped overlapping a sensor shape. Either identifier may already be dead: destroying a
 body or shape, moving it, or changing its filter all end an overlap, so check them with
 ShapeId.is_valid() before use.
*>
struct SensorEndTouchEvent {
    ShapeId sensor_shape_id;
    ShapeId visitor_shape_id;
}

struct SensorEvents @private {
    SensorBeginTouchEvent* begin_events;
    SensorEndTouchEvent* end_events;
    int begin_count;
    int end_count;
}

<*
 Two shapes began touching during the last step.
*>
struct ContactBeginTouchEvent {
    ShapeId shape_id_a;
    ShapeId shape_id_b;
    ContactId contact_id;
}

<*
 Two shapes stopped touching. Every identifier here may already be dead — see
 SensorEndTouchEvent — and the contact itself is checked with ContactId.is_valid().
*>
struct ContactEndTouchEvent {
    ShapeId shape_id_a;
    ShapeId shape_id_b;
    ContactId contact_id;
}

<*
 Two shapes collided faster than the world's hit event threshold. The normal points from shape A
 to shape B, and the point is the mid-point between the two surfaces at the start of the step,
 which may be a speculative point at which the shapes were not yet touching.
*>
struct ContactHitEvent {
    ShapeId shape_id_a;
    ShapeId shape_id_b;
    ContactId contact_id;
    Pos point;
    Vec3 normal;
    float approach_speed;
    ulong user_material_id_a;
    ulong user_material_id_b;
}

struct ContactEvents @private {
    ContactBeginTouchEvent* begin_events;
    ContactEndTouchEvent* end_events;
    ContactHitEvent* hit_events;
    int begin_count;
    int end_count;
    int hit_count;
}

<*
 A body moved under simulation during the last step. Bodies the caller moved itself are not
 reported. The transform is the pose the body ended the step at, so a caller updating render
 transforms reads it here instead of calling BodyId.transform() per body, and the user data is
 the pointer BodyId.set_user_data() wrote on that body.
*>
struct BodyMoveEvent {
    void* user_data;
    WorldTransform transform;
    BodyId body_id;
    bool fell_asleep;
}

struct BodyEvents @private {
    BodyMoveEvent* move_events;
    int move_count;
}

<*
 An awake joint whose force or torque exceeded its threshold. The forces themselves are not
 reported, and the user data is the pointer JointId.set_user_data() wrote on that joint.
*>
struct JointEvent {
    JointId joint_id;
    void* user_data;
}

struct JointEvents @private {
    JointEvent* joint_events;
    int count;
}

<*
 Raw contact-event accessor. The three slice wrappers in box3d_event.c3 are the public way to
 these arrays, so this stays private: it hands back three pointer-and-count pairs a caller would
 otherwise have to pair up correctly by hand.
*>
extern fn ContactEvents contact_events_raw(WorldId world_id) @cname("b3World_GetContactEvents") @private;

extern fn bool ContactId.is_valid(self) @cname("b3Contact_IsValid");

<*
 Raw sensor-event accessor. Private for the same reason as contact_events_raw: the two slice
 wrappers in box3d_event.c3 are the public way to these arrays.
*>
extern fn SensorEvents sensor_events_raw(WorldId world_id) @cname("b3World_GetSensorEvents") @private;

<*
 Raw body-event accessor. Private for the same reason as contact_events_raw.
*>
extern fn BodyEvents body_events_raw(WorldId world_id) @cname("b3World_GetBodyEvents") @private;

<*
 Raw joint-event accessor. Private for the same reason as contact_events_raw.
*>
extern fn JointEvents joint_events_raw(WorldId world_id) @cname("b3World_GetJointEvents") @private;

extern fn bool JointId.is_valid(self) @cname("b3Joint_IsValid");

<*
 Called for each contact point between two shapes, at least one of which asked for pre-solve
 events, before the solver runs. Returning false discards the contact for that step, so the two
 shapes pass through each other. box3d may call this from a worker thread, and the world must not
 be modified from inside it. The context pointer is stored in the world and dereferenced on every
 call, so it must outlive the world.
*>
alias PreSolveFn = fn bool(ShapeId shape_id_a, ShapeId shape_id_b, Pos point, Vec3 normal, void* context);

<*
 Called when two shapes whose definitions enabled custom filtering are about to begin colliding.
 Returning false stops the pair from colliding at all, and only one of the two shapes needs to have
 enabled it. The worker-thread and context rules are PreSolveFn's.
*>
alias CustomFilterFn = fn bool(ShapeId shape_id_a, ShapeId shape_id_b, void* context);

extern fn void WorldId.set_pre_solve_callback(self, PreSolveFn pre_solve_fn, void* context) @cname("b3World_SetPreSolveCallback");
extern fn void WorldId.set_custom_filter_callback(self, CustomFilterFn custom_filter_fn, void* context) @cname("b3World_SetCustomFilterCallback");

const int MAX_MANIFOLD_POINTS = 4;
const int MAX_SHAPE_CAST_POINTS = 128;

<*
 Filters which shapes a query considers. A shape is considered when the query's mask_bits
 overlap the shape's category_bits and the shape's mask_bits overlap the query's category_bits.
 default_query_filter() sets every bit in both, so an unmodified filter considers everything.
 The id and name fields are recording metadata and are ignored when not recording; name must
 outlive the query if it is set.
*>
struct QueryFilter {
    ulong category_bits;
    ulong mask_bits;
    ulong id;
    ZString name;
}

<*
 The closest hit from WorldId.cast_ray_closest(). node_visits and leaf_visits are traversal
 diagnostics. When hit is false every other field is undefined, which is why the wrapper faults
 instead of returning this struct.
*>
struct RayResult {
    ShapeId shape_id;
    Pos point;
    Vec3 normal;
    ulong user_material_id;
    float fraction;
    int triangle_index;
    int child_index;
    int node_visits;
    int leaf_visits;
    bool hit;
}

<*
 A convex point cloud with an external radius, used as the swept shape of a shape cast or the
 probe of an overlap query. The points are borrowed: box3d reads them during the call and does
 not copy them, so they must outlive it — a stack array is fine, a temporary is not. count must
 not exceed MAX_SHAPE_CAST_POINTS.
*>
struct ShapeProxy {
    Vec3* points;
    int count;
    float radius;
}

<*
 The result of a ray or shape cast. When hit is false every other field is undefined. A cast
 against one shape leaves material_index at -1 where that shape carries no material, while the
 proxy pair shape_cast() sweeps writes neither child_index nor material_index, so both read zero.
*>
struct CastOutput {
    Vec3 normal;
    Vec3 point;
    float fraction;
    int iterations;
    int triangle_index;
    int child_index;
    int material_index;
    bool hit;
}

<*
 The same layout as CastOutput in this build. box3d widens the hit point to a double-precision
 position under BOX3D_DOUBLE_PRECISION, which this package never compiles; the alias keeps the
 two names distinct so a future double-precision variant changes one declaration.
*>
alias WorldCastOutput = CastOutput;

<*
 The result of casting at one specific body. When hit is false every other field is undefined.
*>
struct BodyCastResult {
    ShapeId shape_id;
    Pos point;
    Vec3 normal;
    float fraction;
    int triangle_index;
    ulong user_material_id;
    int iterations;
    bool hit;
}

<*
 Broad-phase traversal counters returned by the callback queries. Diagnostic only.
*>
struct TreeStats {
    int node_visits;
    int leaf_visits;
}

<*
 One contact point of a manifold. box3d uses speculative collision, so a point may be separated:
 separation is negative only when the shapes actually overlap, and total_normal_impulse is what
 distinguishes a point that carried an interaction from one that merely existed.
*>
struct ManifoldPoint {
    Vec3 anchor_a;
    Vec3 anchor_b;
    float separation;
    float base_separation;
    float normal_impulse;
    float total_normal_impulse;
    float normal_velocity;
    uint feature_id;
    int triangle_index;
    bool persisted;
}

<*
 The contact points between two colliding shapes. Only the first point_count entries of points
 are valid — contact_points() returns exactly that prefix. The normal is a unit vector pointing
 from shape A to shape B.
*>
struct Manifold {
    ManifoldPoint[MAX_MANIFOLD_POINTS] points;
    Vec3 normal;
    float twist_impulse;
    Vec3 friction_impulse;
    Vec3 rolling_impulse;
    int point_count;
}

<*
 One touching contact. The manifolds pointer and its count keep box3d's own layout because this
 struct is written by box3d into a caller-supplied buffer and cannot hold a C3 slice; read them
 through contact_manifolds(), which carries the borrow in its docstring.
*>
struct ContactData {
    ContactId contact_id;
    ShapeId shape_id_a;
    ShapeId shape_id_b;
    Manifold* manifolds;
    int manifold_count;
}

<*
 A point on a body and the distance to it. box3d measures both against the shapes' core points
 with their radii excluded, so for a sphere or a capsule the point is the centre line and the
 distance overshoots the surface by the radius.
*>
struct ClosestPoint {
    Vec3 point;
    float distance;
}

extern fn QueryFilter default_query_filter() @cname("b3DefaultQueryFilter");

<*
 Raw closest-hit accessor. Private because a miss comes back as a struct whose point, normal and
 fraction are undefined; WorldId.cast_ray_closest() turns that into a fault.
*>
extern fn RayResult cast_ray_closest_raw(
  WorldId world_id,
  Pos origin,
  Vec3 translation,
  QueryFilter filter,
) @cname("b3World_CastRayClosest") @private;

<*
 Raw single-shape ray cast. Private because a miss comes back as a struct of undefined fields.
*>
extern fn WorldCastOutput shape_ray_cast_raw(
  ShapeId shape_id,
  Pos origin,
  Vec3 translation,
) @cname("b3Shape_RayCast") @private;

<*
 Raw single-body ray cast. Private for the same reason as shape_ray_cast_raw.
*>
extern fn BodyCastResult body_cast_ray_raw(
  BodyId body_id,
  Pos origin,
  Vec3 translation,
  QueryFilter filter,
  float max_fraction,
  WorldTransform body_transform,
) @cname("b3Body_CastRay") @private;

<*
 Raw single-body shape cast. Private for the same reason as shape_ray_cast_raw.
*>
extern fn BodyCastResult body_cast_shape_raw(
  BodyId body_id,
  Pos origin,
  ShapeProxy* proxy,
  Vec3 translation,
  QueryFilter filter,
  float max_fraction,
  bool can_encroach,
  WorldTransform body_transform,
) @cname("b3Body_CastShape") @private;

<*
 True when any shape on this body overlaps the proxy placed at origin. A compound shape on a body
 far from origin is missed without a signal — see CompoundData.overlaps for why.
*>
extern fn bool BodyId.overlap_shape(
  self,
  Pos origin,
  ShapeProxy* proxy,
  QueryFilter filter,
  WorldTransform body_transform,
) @cname("b3Body_OverlapShape");

<*
 Raw closest-point accessor. Private because it reports the point through an out-parameter and
 the distance through its return value; BodyId.closest_point() returns both together.
*>
extern fn float body_closest_point_raw(
  BodyId body_id,
  Vec3* result,
  Vec3 target,
) @cname("b3Body_GetClosestPoint") @private;

<*
 Called once for each shape a cast finds along its path, in no particular order. The return value
 steers the cast: -1 rejects this shape and continues, 0 ends the cast, 1 continues without
 clipping, and any fraction between them clips the cast to that point so later shapes are only
 reported if they are nearer. The query runs synchronously on the calling thread, and the world
 must not be modified from inside it.
*>
alias CastResultFn = fn float(
  ShapeId shape_id,
  Pos point,
  Vec3 normal,
  float fraction,
  ulong user_material_id,
  int triangle_index,
  int child_index,
  void* context,
);

<*
 Called once for each shape an overlap query finds. Returning false ends the query. The query
 runs synchronously on the calling thread, and the world must not be modified from inside it.
*>
alias OverlapResultFn = fn bool(ShapeId shape_id, void* context);

<*
 Fires a ray from origin to origin + translation and calls fcn once per shape found along it, in
 no particular order. The callback's return value steers the cast — see CastResultFn. Returns the
 broad-phase traversal counters.
*>
extern fn TreeStats WorldId.cast_ray(
  self,
  Pos origin,
  Vec3 translation,
  QueryFilter filter,
  CastResultFn fcn,
  void* context,
) @cname("b3World_CastRay");

<*
 Sweeps a convex proxy instead of a point, calling fcn once per shape it reaches. The proxy's
 points are borrowed for the call and its count must not exceed MAX_SHAPE_CAST_POINTS.

 box3d closes at a core separation of one linear slop or the two radii less that slop, whichever
 is greater, so the stop lands short of the geometric touch below a total radius of one slop, on
 it at one, and past above — a full slop past from two.
*>
extern fn TreeStats WorldId.cast_shape(
  self,
  Pos origin,
  ShapeProxy* proxy,
  Vec3 translation,
  QueryFilter filter,
  CastResultFn fcn,
  void* context,
) @cname("b3World_CastShape");

<*
 Reports shapes whose broad-phase bounds potentially overlap the query box; it is not an exact
 test against the shape's actual geometry.
*>
extern fn TreeStats WorldId.overlap_aabb(
  self,
  Aabb aabb,
  QueryFilter filter,
  OverlapResultFn fcn,
  void* context,
) @cname("b3World_OverlapAABB");

<*
 Calls fcn once per shape overlapping a convex proxy placed at origin. The proxy's points are
 borrowed for the duration of the call and its count must not exceed MAX_SHAPE_CAST_POINTS.

 A compound-shaped body far from origin is missed without a signal: box3d culls the compound's
 own tree with a box it never carried into the compound's frame — see CompoundData.overlaps.
*>
extern fn TreeStats WorldId.overlap_shape(
  self,
  Pos origin,
  ShapeProxy* proxy,
  QueryFilter filter,
  OverlapResultFn fcn,
  void* context,
) @cname("b3World_OverlapShape");

<*
 One shape a collecting cast found, carrying exactly what the cast callback is given. This is a
 C3 type with no C counterpart: RayResult is the closest-hit result and its traversal counters
 and hit flag mean nothing for a collected hit.
*>
struct CastHit {
    ShapeId shape_id;
    Pos point;
    Vec3 normal;
    float fraction;
    ulong user_material_id;
    int triangle_index;
    int child_index;
}

<*
 The touching contact behind a contact id. The manifolds it carries point into live internal
 state — read them through ContactData.contact_manifolds() and do not hold the result.
*>
extern fn ContactData ContactId.data(self) @cname("b3Contact_GetData");

<*
 An upper bound on the contacts BodyId.contact_data() will write. It counts every contact on the
 body, including ones that are not touching and so never appear in the data, and it reports zero
 while the world is locked.
*>
extern fn int BodyId.contact_capacity(self) @cname("b3Body_GetContactCapacity");

<*
 Raw body contact filler. Private because it reports its count through a return value;
 BodyId.contact_data() returns the filled prefix instead.
*>
extern fn int body_contact_data_raw(
  BodyId body_id,
  ContactData* contact_data,
  int capacity,
) @cname("b3Body_GetContactData") @private;

<*
 An upper bound on the contacts ShapeId.contact_data() will write. It is the whole body's contact
 count, not this shape's, so it over-reports for a body carrying several shapes. It is zero for a
 sensor and zero while the world is locked.
*>
extern fn int ShapeId.contact_capacity(self) @cname("b3Shape_GetContactCapacity");

<*
 Raw shape contact filler. Private for the same reason as body_contact_data_raw.
*>
extern fn int shape_contact_data_raw(
  ShapeId shape_id,
  ContactData* contact_data,
  int capacity,
) @cname("b3Shape_GetContactData") @private;

<*
 The number of shapes attached to this body. Exact, unlike the contact capacities.
*>
extern fn int BodyId.shape_count(self) @cname("b3Body_GetShapeCount");

<*
 Raw body shape filler. Private because it reports its count through a return value;
 BodyId.shapes() returns the filled prefix instead.
*>
extern fn int body_shapes_raw(
  BodyId body_id,
  ShapeId* shape_array,
  int capacity,
) @cname("b3Body_GetShapes") @private;

<*
 The number of shapes currently overlapping this sensor. Exact, unlike the contact capacities,
 but zero for a shape that is not a sensor and zero while the world is locked.
*>
extern fn int ShapeId.sensor_capacity(self) @cname("b3Shape_GetSensorCapacity");

<*
 Raw sensor overlap filler. Private for the same reason as body_shapes_raw.
*>
extern fn int shape_sensor_data_raw(
  ShapeId shape_id,
  ShapeId* visitor_ids,
  int capacity,
) @cname("b3Shape_GetSensorData") @private;

<*
 A ray in a shape's own frame, running from origin along translation, with max_fraction bounding
 how far along the cast looks. What that bound is measured in belongs to each cast: the solid and
 hollow sphere casts do not agree on it.
*>
struct RayCastInput {
    Vec3 origin;
    Vec3 translation;
    float max_fraction;
}

<*
 A convex proxy swept along translation in a shape's own frame, the shape cast's counterpart to
 RayCastInput. The proxy's points are borrowed for the duration of the call — see ShapeProxy.

 can_encroach is read only on box3d's first iteration, and takes effect only past two and three
 quarter linear slops of total radius. A sphere and a capsule lend their own radius to that sum
 where a hull, a mesh and a height field lend none.
*>
struct ShapeCastInput {
    ShapeProxy proxy;
    Vec3 translation;
    float max_fraction;
    bool can_encroach;
}

<*
 Whether every component is finite and max_fraction is at least zero and below box3d's huge bound,
 which scales with the length unit. It says nothing about whether the ray reaches anything: a zero
 translation passes, and so does a ray starting inside the shape it is cast at. The sphere,
 capsule and hull casts assert it, and this build compiles all three assertions out.
*>
extern fn bool RayCastInput.is_valid(&self) @cname("b3IsValidRay");

<*
 Raw local-space ray casts. Private because a miss comes back as a struct whose remaining fields
 are undefined — the mesh returns the input's own max_fraction in one of them — and the wrappers
 in box3d_cast.c3 turn a miss into a fault.
*>
extern fn CastOutput sphere_ray_cast_raw(Sphere* shape, RayCastInput* input) @cname("b3RayCastSphere") @private;
extern fn CastOutput hollow_sphere_ray_cast_raw(Sphere* shape, RayCastInput* input) @cname("b3RayCastHollowSphere") @private;
extern fn CastOutput capsule_ray_cast_raw(Capsule* shape, RayCastInput* input) @cname("b3RayCastCapsule") @private;
extern fn CastOutput compound_ray_cast_raw(CompoundData* shape, RayCastInput* input) @cname("b3RayCastCompound") @private;
extern fn CastOutput hull_ray_cast_raw(HullData* shape, RayCastInput* input) @cname("b3RayCastHull") @private;
extern fn CastOutput mesh_ray_cast_raw(Mesh* shape, RayCastInput* input) @cname("b3RayCastMesh") @private;
extern fn CastOutput height_field_ray_cast_raw(HeightFieldData* shape, RayCastInput* input) @cname("b3RayCastHeightField") @private;

<*
 Raw local-space shape casts. Private for the reason the raw ray casts are, and for one more: a
 proxy holding no points is read as though it held its first point rather than refused, so the
 answer looks ordinary while describing geometry the caller never named. The wrappers in
 box3d_cast.c3 check the proxy first.
*>
extern fn CastOutput sphere_shape_cast_raw(Sphere* shape, ShapeCastInput* input) @cname("b3ShapeCastSphere") @private;
extern fn CastOutput capsule_shape_cast_raw(Capsule* shape, ShapeCastInput* input) @cname("b3ShapeCastCapsule") @private;
extern fn CastOutput compound_shape_cast_raw(CompoundData* shape, ShapeCastInput* input) @cname("b3ShapeCastCompound") @private;
extern fn CastOutput hull_shape_cast_raw(HullData* shape, ShapeCastInput* input) @cname("b3ShapeCastHull") @private;
extern fn CastOutput mesh_shape_cast_raw(Mesh* shape, ShapeCastInput* input) @cname("b3ShapeCastMesh") @private;
extern fn CastOutput height_field_shape_cast_raw(HeightFieldData* shape, ShapeCastInput* input) @cname("b3ShapeCastHeightField") @private;

<*
 Raw overlap predicates. Private because a proxy holding no points is not refused: four kinds read
 it as though it held its first point, and the mesh and the height field answer from a stack buffer
 nothing wrote, so the result follows the caller's stray memory. The wrappers refuse it.
*>
extern fn bool sphere_overlap_raw(Sphere* shape, Transform transform, ShapeProxy* proxy) @cname("b3OverlapSphere") @private;
extern fn bool capsule_overlap_raw(Capsule* shape, Transform transform, ShapeProxy* proxy) @cname("b3OverlapCapsule") @private;
extern fn bool compound_overlap_raw(CompoundData* shape, Transform transform, ShapeProxy* proxy) @cname("b3OverlapCompound") @private;
extern fn bool hull_overlap_raw(HullData* shape, Transform transform, ShapeProxy* proxy) @cname("b3OverlapHull") @private;
extern fn bool mesh_overlap_raw(Mesh* shape, Transform transform, ShapeProxy* proxy) @cname("b3OverlapMesh") @private;
extern fn bool height_field_overlap_raw(HeightFieldData* shape, Transform transform, ShapeProxy* proxy) @cname("b3OverlapHeightField") @private;

<*
 Called once for each triangle a mesh or height field query finds, with the triangle's vertices
 in the shape's own frame and the index a cast on that shape reports. Returning false ends a
 Mesh.query; HeightFieldData.query reads nothing back and cannot be stopped.
*>
alias MeshQueryFn = fn bool(Vec3 a, Vec3 b, Vec3 c, int triangle_index, void* context);

<*
 Called once for each child a compound query finds, given the compound queried and the index
 CompoundData.child() takes. Returning false ends the query.
*>
alias CompoundQueryFn = fn bool(CompoundData* compound, int child_index, void* context);

<*
 Reports every triangle of this mesh that meets bounds, a box in the mesh's own frame with the
 mesh's scale already applied — the frame the vertices arrive in. Each triangle is tested against
 the box itself rather than against the node holding it.

 An inverted box is repaired into the box it spans rather than answering nothing, and a mirroring
 scale swaps the second and third vertex so the scaled triangle keeps its winding.
*>
extern fn void Mesh.query(&self, Aabb bounds, MeshQueryFn fcn, void* context) @cname("b3QueryMesh");

<*
 Reports the triangles whose cell meets bounds, a box in the field's own frame and scale. The test
 is per cell — a cell meeting bounds reports both its triangles, a hole cell neither — and what fcn
 returns is discarded, so nothing stops the traversal.

 The work follows the box, not the field: box3d spans it in unclamped cell indices, so a billion
 cells costs seconds and a span past a signed int reports nothing. Intersect with compute_aabb().
*>
extern fn void HeightFieldData.query(&self, Aabb bounds, MeshQueryFn fcn, void* context) @cname("b3QueryHeightField");

<*
 Reports the children of this compound whose bounds meet aabb, a box in the compound's own frame:
 box3d applies no transform, so a placed compound wants the box carried into that frame first.
 The test is a child's box rather than its geometry, so a reported child need not meet aabb.

 The order is the compound's own tree order, which is neither the index CompoundData.child()
 takes nor the order create_compound() was given the children in.
*>
extern fn void CompoundData.query(&self, Aabb aabb, CompoundQueryFn fcn, void* context) @cname("b3QueryCompound");

<*
 Three vertices in the frame of whatever they are collided against — these entry points apply no
 transform. The plane normal is the cross product of the second and third vertices about the first,
 and each pair culls what lies behind it, though the point tested and the tolerance differ per pair.

 A triangle with no area has no plane, so nothing is culled and a contact can carry a NaN point.
 The wrappers refuse one.
*>
typedef Triangle = Vec3[3];

<*
 Which feature of a triangle produced a manifold. Written only by the collide entry points that
 take a triangle, and private with the LocalManifold field that holds it.
*>
enum TriangleFeature : int @private {
    NONE,
    TRIANGLE_FACE,
    HULL_FACE,
    EDGE_1,
    EDGE_2,
    EDGE_3,
    VERTEX_1,
    VERTEX_2,
    VERTEX_3,
}

<*
 box3d's GJK warm start, holding vertex indices into the pair of shapes it was filled from. It
 belongs to that pair alone: box3d reads those indices against the next pair's arrays before the
 metric that would discard them is computed, under a bounds assertion this build compiles out.
 Private for that reason — a wrapper that needs one keeps its own and zeroes it at every call.
*>
struct SimplexCache @private {
    float metric;
    ushort count;
    char[4] index_a;
    char[4] index_b;
}

<*
 box3d's separating-axis warm start: the last axis it tested and what that test gave, whether the
 two were separated or overlapping — the separation is negative for an overlap, and hit is the only
 field reporting re-use. The hull pair always replaces the entry; the triangle and hull pair zeroes
 it instead on its fallback path, so an empty one is observable there.
*>
struct SatCache @private {
    float separation;
    char type;
    char index_a;
    char index_b;
    char hit;
}

<*
 The incoming and outgoing edges a contact point lies between, each named by the shape that owns
 it and its index in that shape's own array. box3d matches these across steps to warm start a
 contact, so two points of one manifold that differ here name distinct features.
*>
struct FeaturePair {
    char owner1;
    char index1;
    char owner2;
    char index2;
}

<*
 One contact point of a manifold, in shape A's frame. A separation is zero where the surfaces
 exactly meet, negative for an overlap, and positive for a point the two have not reached — which
 only some pairs report at all.
 triangle_index names the triangle a mesh or height field contributed and is left alone by every
 collide pair bound here, the triangle pairs included.
*>
struct LocalManifoldPoint {
    Vec3 point;
    float separation;
    FeaturePair pair;
    int triangle_index;
}

<*
 box3d's own manifold, whose points borrow a buffer the caller supplies. A call that finds nothing
 leaves the normal standing, and the sphere pair leaves the point count standing too, so one reused
 across calls reports the previous contact as this one's. Private for that reason: the wrappers
 build one over storage they own and hand back a CollisionManifold instead.
*>
struct LocalManifold @private {
    Vec3 normal;
    Vec3 triangle_normal;
    LocalManifoldPoint* points;
    int point_count;
    int triangle_index;
    int i1;
    int i2;
    int i3;
    float squared_distance;
    TriangleFeature feature;
    int triangle_flags;
}

<*
 The manifold a pair of shapes produces, in shape A's frame, owning its points instead of
 borrowing them, so nothing a previous call left behind can be read as this one's. Only the first
 point_count entries are valid and contact_points() returns that prefix. The capacity handed to
 box3d is fixed at MAX_MANIFOLD_POINTS, its own manifold size, because a capacity under what a
 pair needs costs the whole manifold rather than its tail and reads exactly like no contact.
*>
struct CollisionManifold {
    Vec3 normal;
    int point_count;
    LocalManifoldPoint[MAX_MANIFOLD_POINTS] points;
}

<*
 The manifold of the one pair whose point count the caller's buffer is the only bound on, in
 shape A's frame. The points borrow that buffer and live exactly as long as it does; a count equal
 to its length may mean more was clipped away, or that the clip landed on exactly that many.
 box3d writes only the point, the separation and the feature pair, so the rest is the buffer's.
*>
struct CollisionManifoldView {
    Vec3 normal;
    LocalManifoldPoint[] points;
}

<*
 Raw local collide entry points. Private because each writes through a manifold that borrows the
 caller's point buffer and takes a capacity below which it reports nothing rather than less. They
 belong to box3d_collide.c3, whose wrappers are the only way in.
*>
extern fn void collide_spheres_raw(
  LocalManifold* manifold,
  int capacity,
  Sphere* sphere_a,
  Sphere* sphere_b,
  Transform transform_b_to_a,
) @cname("b3CollideSpheres") @private;

extern fn void collide_capsule_and_sphere_raw(
  LocalManifold* manifold,
  int capacity,
  Capsule* capsule_a,
  Sphere* sphere_b,
  Transform transform_b_to_a,
) @cname("b3CollideCapsuleAndSphere") @private;

extern fn void collide_hull_and_sphere_raw(
  LocalManifold* manifold,
  int capacity,
  HullData* hull_a,
  Sphere* sphere_b,
  Transform transform_b_to_a,
  SimplexCache* cache,
) @cname("b3CollideHullAndSphere") @private;

extern fn void collide_capsules_raw(
  LocalManifold* manifold,
  int capacity,
  Capsule* capsule_a,
  Capsule* capsule_b,
  Transform transform_b_to_a,
) @cname("b3CollideCapsules") @private;

extern fn void collide_hull_and_capsule_raw(
  LocalManifold* manifold,
  int capacity,
  HullData* hull_a,
  Capsule* capsule_b,
  Transform transform_b_to_a,
  SimplexCache* cache,
) @cname("b3CollideHullAndCapsule") @private;

extern fn void collide_hulls_raw(
  LocalManifold* manifold,
  int capacity,
  HullData* hull_a,
  HullData* hull_b,
  Transform transform_b_to_a,
  SatCache* cache,
) @cname("b3CollideHulls") @private;

extern fn void collide_triangle_and_capsule_raw(
  LocalManifold* manifold,
  int capacity,
  Vec3* triangle_a,
  Capsule* capsule_b,
  SimplexCache* cache,
) @cname("b3CollideTriangleAndCapsule") @private;

extern fn void collide_triangle_and_hull_raw(
  LocalManifold* manifold,
  int capacity,
  Vec3 v1,
  Vec3 v2,
  Vec3 v3,
  int triangle_flags,
  HullData* hull_b,
  SatCache* cache,
  bool enable_speculative,
) @cname("b3CollideTriangleAndHull") @private;

extern fn void collide_triangle_and_sphere_raw(
  LocalManifold* manifold,
  int capacity,
  Vec3* triangle_a,
  Sphere* sphere_b,
) @cname("b3CollideTriangleAndSphere") @private;

<*
 Two convex proxies and the pose of B in A's frame. The query runs in A's frame and is origin
 independent, so each proxy keeps its points in its own shape's frame and transform alone relates
 the two. use_radii subtracts both radii from the distance and moves each witness point out onto
 its own proxy's perimeter; without it the answer is between the two cores.
*>
struct DistanceInput {
    ShapeProxy proxy_a;
    ShapeProxy proxy_b;
    Transform transform;
    bool use_radii;
}

<*
 The closest points between two proxies, in shape A's frame, with distance clamped at zero. normal
 runs from A to B and is zero where the cores overlap or box3d's search degenerates, which a
 caller normalising it turns into a NaN. Where use_radii alone drove the distance to zero the
 normal is real and the two points have crossed, point_b sitting behind point_a along it. Both
 counters are diagnostics of a separated answer: see shape_distance() for what each reads when not.
*>
struct DistanceOutput {
    Vec3 point_a;
    Vec3 point_b;
    Vec3 normal;
    float distance;
    int iterations;
    int simplex_count;
}

<*
 Two convex proxies, the pose of B in A's frame and B's translation in that frame — what
 shape_cast() sweeps, each proxy keeping its points in its own shape's frame. can_encroach is read
 only on box3d's first pass and takes effect only past two and three quarter linear slops of total
 radius, where it lets a pair that begins overlapped close a further slop rather than answer zero.
*>
struct ShapeCastPairInput {
    ShapeProxy proxy_a;
    ShapeProxy proxy_b;
    Transform transform;
    Vec3 translation_b;
    float max_fraction;
    bool can_encroach;
}

<*
 Raw proxy-pair distance. Private because box3d's warm-start cache and its diagnostic simplex
 array are both the caller's to supply, and reusing a cache across pairs reads one pair's vertex
 indices against another's arrays. shape_distance() owns both.
*>
extern fn DistanceOutput shape_distance_raw(
  DistanceInput* input,
  SimplexCache* cache,
  void* simplexes,
  int simplex_capacity,
) @cname("b3ShapeDistance") @private;

<*
 Raw proxy-pair shape cast. Private for the reason the single-shape casts are — a miss comes back
 as a struct whose remaining fields are undefined — and because a proxy of no points is read as
 though it held its first. shape_cast() checks both proxies and turns a miss into a fault.
*>
extern fn CastOutput shape_cast_pair_raw(ShapeCastPairInput* input) @cname("b3ShapeCast") @private;

<*
 The motion of one shape over a time-of-impact interval. The centre of mass runs c1 to c2 and the
 rotation q1 to q2, while local_center places the shape's own origin against that centre — so the
 proxy points swept against this stay in the shape's frame and the sweep carries them.
*>
struct Sweep {
    Vec3 local_center;
    Vec3 c1;
    Vec3 c2;
    Quat q1;
    Quat q2;
}

<*
 Raw sweep evaluation. Private because box3d asserts the time lies inside the interval and this
 build compiles that out, extrapolating both the centre and the rotation past either end instead.
 Sweep.transform_at() restores the range.
*>
extern fn Transform sweep_transform_raw(Sweep* sweep, float time) @cname("b3GetSweepTransform") @private;

struct ToiInput {
    ShapeProxy proxy_a;
    ShapeProxy proxy_b;
    Sweep sweep_a;
    Sweep sweep_b;
    float max_fraction;
}

<*
 How a time-of-impact query ended. HIT reports where the two first touch under a measured point and
 normal; OVERLAPPED means the cores were found overlapping and answers fraction zero under a point
 and normal of exactly zero; SEPARATED never reached the other and answers max_fraction over the
 last witness pair; FAILED gave up — after twenty-five distance passes, or with the root finder's
 bracket lost — and answers the last time it advanced to. UNKNOWN is overwritten before it returns.
*>
enum ToiState : int {
    UNKNOWN,
    FAILED,
    OVERLAPPED,
    HIT,
    SEPARATED,
}

<*
 What a time-of-impact query found. used_fallback is not written by the query at all — box3d's own
 continuous solver sets it after re-running a zero-fraction result against a sphere around the fast
 shape's centroid, so a call made here always reads it false. The three counts are diagnostics.
*>
struct ToiOutput {
    ToiState state;
    Vec3 point;
    Vec3 normal;
    float fraction;
    float distance;
    int distance_iterations;
    int push_back_iterations;
    int root_iterations;
    bool used_fallback;
}

<*
 Raw swept-pair time of impact. Private because a proxy of no points is read as though it held its
 first, and because a max_fraction outside the interval is extrapolated or answered with a negative
 fraction rather than refused. time_of_impact() checks both.
*>
extern fn ToiOutput time_of_impact_raw(ToiInput* input) @cname("b3TimeOfImpact") @private;

<*
 The plane between a mover and one shape it touches. offset is how far the mover's surface reaches
 past the shape's, and point sits on the shape's core rather than its surface — the sphere's centre,
 the capsule's segment, the hull's own face. The normal points out of the shape towards the mover
 unless the mover's core has closed within a linear slop of that same core, when box3d substitutes
 a perpendicular of the mover's axis and the direction means nothing.
*>
struct PlaneResult {
    Plane plane;
    Vec3 point;
}

<*
 One plane a mover is solved against. push_limit caps how far this plane may move the mover, and
 push is the solve's own output, zeroed on entry rather than read. A velocity clip passes over a
 plane whose clip_velocity is false, and over one whose push is zero whatever that flag says, so a
 plane the solve never leaned on is skipped either way.
*>
struct CollisionPlane {
    Plane plane;
    float push_limit;
    float push;
    bool clip_velocity;
}

struct PlaneSolverResult {
    Vec3 delta;
    int iteration_count;
}

<*
 Raw plane solve and velocity clip. Private because each takes a pointer and a count where
 box3d_mover.c3's wrappers take a slice, and because the solve writes push back through its array
 while the clip only reads it.
*>
extern fn PlaneSolverResult solve_planes_raw(Vec3 target_delta, CollisionPlane* planes, int count) @cname("b3SolvePlanes") @private;
extern fn Vec3 clip_vector_raw(Vec3 vector, CollisionPlane* planes, int count) @cname("b3ClipVector") @private;

<*
 One plane a body-local mover collide produced, naming the shape on that body it came from.
*>
struct BodyPlaneResult {
    ShapeId shape_id;
    PlaneResult result;
}

<*
 Called once per shape a mover touches, handed that shape's planes up to box3d's own 64. The
 array points at box3d's stack and dies with the call, so a plane kept is copied out. Returning false ends
 the traversal of the tree that shape sits in and leaves the other two reporting. The query runs
 synchronously on the calling thread, and the world must not be modified from inside it.
*>
alias PlaneResultFn = fn bool(ShapeId shape_id, PlaneResult* planes, int plane_count, void* context);

<*
 Called once per shape a mover cast reaches, before the sweep against that shape runs. Returning
 false drops the shape from the cast. The query runs synchronously on the calling thread, and the
 world must not be modified from inside it.
*>
alias MoverFilterFn = fn bool(ShapeId shape_id, void* context);

<*
 Collides a capsule mover with the world, calling fcn once per shape it touches, static through
 dynamic; fcn is required and the planes are relative to origin. A sphere, capsule or hull gives
 one plane, a mesh, height field or compound up to 64, cut silently past that. A hull or triangle
 stops reporting once the mover's core reaches its surface, so a mover sunk past its own radius has
 nothing to solve on. A locked world, or an origin past a compiled-out assertion, gives none.
*>
extern fn void WorldId.collide_mover(
  self,
  Pos origin,
  Capsule* mover,
  QueryFilter filter,
  PlaneResultFn fcn,
  void* context,
) @cname("b3World_CollideMover");

<*
 Sweeps a capsule mover through the world and reports what fraction of translation it may take, the
 mover being relative to origin. The closing band is one linear slop or the mover and shape radii
 less that slop, whichever is greater, so the stop lands short of the geometric touch below a total
 radius of one slop, on it at one, and past above — a full slop past from two. A locked world
 answers 1, as does an origin or translation past the assertion this build compiles out.

 @param fcn : "an optional per-shape filter; null accepts every shape the query filter passed"
 @return "the fraction of translation the mover may take, above zero because a shape whose surface the mover's core starts within one slop or the two radii less a slop of is dropped from the sweep — which for a mover thinner than about a slop reaches past its own surface — and at most 1"
*>
extern fn float WorldId.cast_mover(
  self,
  Pos origin,
  Capsule* mover,
  Vec3 translation,
  QueryFilter filter,
  MoverFilterFn fcn,
  void* context,
) @cname("b3World_CastMover");

<*
 Raw body-local mover collide. Private because it takes a pointer and a capacity where
 BodyId.collide_mover() hands back the filled prefix of the caller's buffer as a slice.
*>
extern fn int body_collide_mover_raw(
  BodyId body_id,
  BodyPlaneResult* body_planes,
  int plane_capacity,
  Pos origin,
  Capsule* mover,
  QueryFilter filter,
  WorldTransform body_transform,
) @cname("b3Body_CollideMover") @private;

enum JointType : int {
    PARALLEL,
    DISTANCE,
    FILTER,
    MOTOR,
    PRISMATIC,
    REVOLUTE,
    SPHERICAL,
    WELD,
    WHEEL,
}

<*
 The definition every joint type builds on. Must come from default_filter_joint_def(), or from
 another type's default — see WorldId.create_filter_joint. Both local frames are measured from
 their body's origin rather than its centre of mass, so recomputing a body's mass leaves the
 joint where it was. default_filter_joint_def() sets force_threshold and torque_threshold to
 float::max, and a joint whose thresholds both keep that value is never checked at all: either one
 below it arms the check, and being armed is not being reported — see set_force_threshold.
*>
struct JointDef {
    void* user_data;
    BodyId body_id_a;
    BodyId body_id_b;
    Transform local_frame_a;
    Transform local_frame_b;
    float force_threshold;
    float torque_threshold;
    float constraint_hertz;
    float constraint_damping_ratio;
    float draw_scale;
    bool collide_connected;
    int internal_value;
}

<*
 A filter joint definition. A filter joint constrains nothing: it exists so the two bodies it
 links stop colliding, and that suppression lasts only while collide_connected stays false.
*>
struct FilterJointDef {
    inline JointDef base;
}

extern fn FilterJointDef default_filter_joint_def() @cname("b3DefaultFilterJointDef");

<*
 The soft-constraint tuning a joint solves with. This is a C3 type with no C counterpart: box3d
 reports the pair through two out-parameters.
*>
struct ConstraintTuning {
    float hertz;
    float damping_ratio;
}

<*
 Raw filter joint constructor. Bypasses WorldId.create_filter_joint's definition guard, so it is
 private to the module — box3d_joint.c3's WorldId.create_filter_joint is the only caller and is the
 only public way to a live filter joint.
*>
extern fn JointId create_filter_joint_raw(
  WorldId world_id,
  FilterJointDef* def,
) @cname("b3CreateFilterJoint") @private;

<*
 Removes this joint from its world, dropping whatever it constrained between the two bodies. A
 collision the joint was suppressing does not return the way set_collide_connected(true) returns
 one: nothing re-offers the pair to the broad phase, so two settled bodies regain no contact until
 one of them moves.

 @param wake_attached : "false leaves two sleeping attached bodies asleep; true wakes both"
*>
extern fn void JointId.destroy(self, bool wake_attached) @cname("b3DestroyJoint");

<*
 This joint's type, which box3d fixes when the joint is created and offers no way to change.
*>
extern fn JointType JointId.type(self) @cname("b3Joint_GetType");

<*
 The body this joint's definition named as body_id_a.
*>
extern fn BodyId JointId.body_a(self) @cname("b3Joint_GetBodyA");

<*
 The body this joint's definition named as body_id_b.
*>
extern fn BodyId JointId.body_b(self) @cname("b3Joint_GetBodyB");

<*
 The world that owns this joint.
*>
extern fn WorldId JointId.world(self) @cname("b3Joint_GetWorld");

<*
 Moves this joint's anchor on body A. The frame is measured from that body's origin rather than
 its centre of mass, so recomputing the body's mass leaves the anchor where it was.
*>
extern fn void JointId.set_local_frame_a(self, Transform local_frame) @cname("b3Joint_SetLocalFrameA");

<*
 This joint's anchor on body A, measured from that body's origin.
*>
extern fn Transform JointId.local_frame_a(self) @cname("b3Joint_GetLocalFrameA");

<*
 Moves this joint's anchor on body B, measured from that body's origin like set_local_frame_a.
*>
extern fn void JointId.set_local_frame_b(self, Transform local_frame) @cname("b3Joint_SetLocalFrameB");

<*
 This joint's anchor on body B, measured from that body's origin.
*>
extern fn Transform JointId.local_frame_b(self) @cname("b3Joint_GetLocalFrameB");

<*
 Lets the two linked bodies collide again, or stops them colliding.

 This flag, not the joint's type, suppresses the collision, and only while one of the bodies is
 dynamic. Turning it on has them colliding from the next step; turning it off ends the collision
 at once and drops their contacts, and each dropped contact whose shapes asked for contact events
 pushes an end-touch event into the batch the next step() fills, not the one
 contact_end_touch_events() returns beforehand. Silently does nothing while the world is locked.
*>
extern fn void JointId.set_collide_connected(self, bool should_collide) @cname("b3Joint_SetCollideConnected");

<*
 Whether the two linked bodies are allowed to collide. False on a joint built from a default
 definition, and that false is what suppresses the collision — see set_collide_connected.
*>
extern fn bool JointId.collide_connected(self) @cname("b3Joint_GetCollideConnected");

extern fn void JointId.set_user_data(self, void* user_data) @cname("b3Joint_SetUserData");
extern fn void* JointId.user_data(self) @cname("b3Joint_GetUserData");

<*
 Wakes both bodies this joint links, not only one — though two dynamic bodies a joint links share
 one island, so waking either of them wakes the other anyway. Silently does nothing while the
 world is locked, mid WorldId.step or inside a callback box3d runs during one.
*>
extern fn void JointId.wake_bodies(self) @cname("b3Joint_WakeBodies");

<*
 The force this joint is applying to hold its constraint, in newtons. box3d branches on the
 joint's own type, so a zero says nothing until read against that type: the joint may be unloaded,
 the channel may be one the type never measures, or one it measures only in some states.

 A non-zero can be wrong too — the prismatic and wheel readings are permuted, and the wheel's
 axial term sums a stored suspension limit in metres into the impulse, so it carries a length
 whatever the permutation. Prefer the per-type accessor.
*>
extern fn Vec3 JointId.constraint_force(self) @cname("b3Joint_GetConstraintForce");

<*
 The torque this joint is applying to hold its constraint, in newton-metres. A zero is read
 against the joint's type rather than taken for an idle joint — see constraint_force. A non-zero
 needs care too: some types double-count an axis here, the revolute hinge axis among them, so a
 per-type getter such as RevoluteJointId.motor_torque() is the honest reading where one exists.
 Nor is it a pure getter on a revolute joint, where box3d writes the joint's two perpendicular
 warm-starting axes on the way past.
*>
extern fn Vec3 JointId.constraint_torque(self) @cname("b3Joint_GetConstraintTorque");

<*
 How far this joint is from the placement it holds its two bodies in, usually in metres. Some
 types measure the world-space distance between the two anchors, others the error left in the
 translation they constrain. A zero is read against the joint's type rather than taken for a
 joint resting where it wants to be — see constraint_force.
*>
extern fn float JointId.linear_separation(self) @cname("b3Joint_GetLinearSeparation");

<*
 How far this joint's two bodies have turned out of the relative orientation it holds them in,
 usually in radians. box3d builds this from the two body rotations and never reads the joint's
 anchors, so moving an anchor does not move the reading. A zero is read against the joint's type
 rather than taken for two bodies in alignment — see constraint_force.
*>
extern fn float JointId.angular_separation(self) @cname("b3Joint_GetAngularSeparation");

<*
 Retunes the soft constraint this joint is solved with, which box3d calls an advanced feature. A
 joint built from a default definition carries 60 hertz and a damping ratio of 2. box3d asserts
 both values are finite and non-negative; this package links a release build where that assertion
 is compiled out, and the wrappers do not restore it.

 @param hertz : "the stiffness in cycles per second"
 @param damping_ratio : "the non-dimensional damping ratio, one for critical damping"
*>
extern fn void JointId.set_constraint_tuning(self, float hertz, float damping_ratio) @cname("b3Joint_SetConstraintTuning");

<*
 Raw constraint tuning accessor. Private because it reports the pair through two out-parameters;
 box3d_joint.c3's JointId.constraint_tuning() returns them as one value.
*>
extern fn void constraint_tuning_raw(
  JointId joint_id,
  float* hertz,
  float* damping_ratio,
) @cname("b3Joint_GetConstraintTuning") @private;

<*
 Sets the force at which this joint starts appearing in WorldId.joint_events(), in newtons.

 One check covers both thresholds, armed only while one is below float::max, so a joint keeping
 both defaults is never checked; an armed joint is reported on the steps where its force or its
 torque reaches its own threshold, and a zero threshold reports it every awake step. The compared
 force is a reaction force from the solve, not constraint_force()'s per-type value, and box3d's
 finite non-negative assertion is compiled out here.
*>
extern fn void JointId.set_force_threshold(self, float threshold) @cname("b3Joint_SetForceThreshold");

<*
 The force at which this joint starts appearing in WorldId.joint_events(), float::max on a joint
 built from a default definition.
*>
extern fn float JointId.force_threshold(self) @cname("b3Joint_GetForceThreshold");

<*
 Sets the torque at which this joint starts appearing in WorldId.joint_events(), in
 newton-metres. It shares one check with the force threshold, so the arming rule and the
 compiled-out assertion described on set_force_threshold govern this one too.
*>
extern fn void JointId.set_torque_threshold(self, float threshold) @cname("b3Joint_SetTorqueThreshold");

<*
 The torque at which this joint starts appearing in WorldId.joint_events(), float::max on a joint
 built from a default definition.
*>
extern fn float JointId.torque_threshold(self) @cname("b3Joint_GetTorqueThreshold");

<*
 The number of joints linked to this body. Exact, unlike the contact capacities, and it keeps
 counting while the world is locked: box3d reaches the world here without the locked check, the
 same exception shape_count() is, rather than reporting zero the way the contact and sensor
 capacities do.
*>
extern fn int BodyId.joint_count(self) @cname("b3Body_GetJointCount");

<*
 Raw body joint filler. Private because it reports its count through a return value;
 BodyId.joints() returns the filled prefix instead.
*>
extern fn int body_joints_raw(
  BodyId body_id,
  JointId* joint_array,
  int capacity,
) @cname("b3Body_GetJoints") @private;

<*
 A joint known to be revolute, so its per-type accessors need no check at each call. It converts
 to a JointId on its own, so every shared accessor reaches it uncast; the way back is
 JointId.as_revolute(), which checks — see there for what a wrong-typed accessor does.
*>
typedef RevoluteJointId = inline JointId;

<*
 A revolute joint definition: a hinge about the frames' z axis, with an optional spring, limit and
 motor. Must come from default_revolute_joint_def(), which zeroes every field it adds to the base
 — hertz, damping_ratio and max_motor_torque included, not the base's float::max — so a default
 revolute joint is a bare hinge. Three angles are then corrected on the way in, so limits need not
 read back as set: target_angle is clamped into [-pi, pi], and lower_angle and upper_angle are
 swapped into order and clamped into [-0.99 pi, 0.99 pi].
*>
struct RevoluteJointDef {
    inline JointDef base;
    float target_angle;
    bool enable_spring;
    float hertz;
    float damping_ratio;
    bool enable_limit;
    float lower_angle;
    float upper_angle;
    bool enable_motor;
    float max_motor_torque;
    float motor_speed;
}

extern fn RevoluteJointDef default_revolute_joint_def() @cname("b3DefaultRevoluteJointDef");

<*
 Raw revolute joint constructor. Bypasses WorldId.create_revolute_joint's definition guard and
 hands back a joint of no particular type, so it is private to the module —
 box3d_joint_revolute.c3's WorldId.create_revolute_joint is the only caller and is the only public
 way to a live revolute joint.
*>
extern fn JointId create_revolute_joint_raw(
  WorldId world_id,
  RevoluteJointDef* def,
) @cname("b3CreateRevoluteJoint") @private;

<*
 Enables or disables this joint's motor. A change to the flag discards the motor's accumulated
 impulse, so motor_torque() reads zero until the next step rather than the torque the motor was
 applying before.
*>
extern fn void RevoluteJointId.enable_motor(self, bool enable_motor) @cname("b3RevoluteJoint_EnableMotor");

<*
 Whether this joint's motor is enabled. False on a joint built from a default definition.
*>
extern fn bool RevoluteJointId.is_motor_enabled(self) @cname("b3RevoluteJoint_IsMotorEnabled");

<*
 Sets the speed the motor drives the hinge at, in radians per second about the z axis of the two
 local frames. It is a target the motor pursues only as far as max_motor_torque() lets it, not a
 speed the hinge is made to hold. box3d asserts the value is finite and nothing further — a
 negative speed drives the hinge the other way; this package links a release build where that
 assertion is compiled out, and the wrappers do not restore it.
*>
extern fn void RevoluteJointId.set_motor_speed(self, float motor_speed) @cname("b3RevoluteJoint_SetMotorSpeed");

<*
 The speed the motor drives the hinge at, in radians per second. What was set, not what the hinge
 is turning at.
*>
extern fn float RevoluteJointId.motor_speed(self) @cname("b3RevoluteJoint_GetMotorSpeed");

<*
 The torque the motor applied over the last step, in newton-metres, bounded by max_motor_torque(),
 and the honest reading of the two available. The shared constraint_torque() double-counts the
 hinge axis — box3d adds the joint's axial impulse along the frame z axis and then adds the same
 quantity along that axis a second time — so on a joint with no spring and no limit it reports
 exactly twice this value about the hinge.
*>
extern fn float RevoluteJointId.motor_torque(self) @cname("b3RevoluteJoint_GetMotorTorque");

<*
 Sets the largest torque the motor may apply, in newton-metres. 0 on a joint built from a default
 definition, which leaves an enabled motor unable to turn anything. box3d asserts the value is
 finite and non-negative; this package links a release build where that assertion is compiled
 out, and the wrappers do not restore it.
*>
extern fn void RevoluteJointId.set_max_motor_torque(self, float torque) @cname("b3RevoluteJoint_SetMaxMotorTorque");

<*
 The largest torque the motor may apply, in newton-metres.
*>
extern fn float RevoluteJointId.max_motor_torque(self) @cname("b3RevoluteJoint_GetMaxMotorTorque");

<*
 The hinge angle in radians: the twist about the frames' z axis of body B's local frame relative
 to body A's, kept in [-pi, pi]. It is measured from the alignment of those two frames and from
 nothing else — not from target_angle, and not from any reference angle, whatever box3d's header
 comment on this function says. The sign follows the frame z axis, so a positive motor speed
 drives the angle positive.
*>
extern fn float RevoluteJointId.angle(self) @cname("b3RevoluteJoint_GetAngle");

<*
 Enables or disables this joint's limit. A change to the flag discards the limit's accumulated
 impulses, so a limit switched back on rebuilds its hold over the following steps rather than
 resuming the one it had.
*>
extern fn void RevoluteJointId.enable_limit(self, bool enable_limit) @cname("b3RevoluteJoint_EnableLimit");

<*
 Whether this joint's limit is enabled. False on a joint built from a default definition.

 While it is off — and while it is on but not exceeded — the shared angular_separation() strips
 the hinge angle out of the relative rotation and reports what is left of the misalignment: zero
 for a hinge whose perpendicular constraint is holding, non-zero for one bent off its axis under
 load. Once the limit is on and the angle is past it the full relative rotation is reported
 instead, the state-dependent zero JointId.constraint_force describes rather than a permanent one.
*>
extern fn bool RevoluteJointId.is_limit_enabled(self) @cname("b3RevoluteJoint_IsLimitEnabled");

<*
 The low end of the angle the limit holds the hinge above, in radians about the frames' z axis. It
 is what box3d stored, not what it was handed: see set_limits. 0 on a joint built from a default
 definition.
*>
extern fn float RevoluteJointId.lower_limit(self) @cname("b3RevoluteJoint_GetLowerLimit");

<*
 The high end of the angle the limit holds the hinge below, in radians about the frames' z axis. It
 is what box3d stored, not what it was handed: see set_limits. 0 on a joint built from a default
 definition.
*>
extern fn float RevoluteJointId.upper_limit(self) @cname("b3RevoluteJoint_GetUpperLimit");

<*
 Sets the two angles in radians the limit holds the hinge between. box3d takes the smaller of the
 pair as the lower and the larger as the upper, so a reversed pair is quietly corrected rather
 than refused, and then clamps both into [-0.99 pi, 0.99 pi]. The limit acts only while
 enable_limit() is on. box3d asserts both values are finite — order and range it corrects rather
 than asserts — and that assertion is compiled out of this release build and not restored.
*>
extern fn void RevoluteJointId.set_limits(self, float lower_radians, float upper_radians) @cname("b3RevoluteJoint_SetLimits");

<*
 Enables or disables this joint's angular spring. A change to the flag discards the spring's
 accumulated impulse, so a spring switched back on rebuilds its pull over the following steps
 rather than resuming the one it had.
*>
extern fn void RevoluteJointId.enable_spring(self, bool enable_spring) @cname("b3RevoluteJoint_EnableSpring");

<*
 Whether this joint's angular spring is enabled. False on a joint built from a default definition.
*>
extern fn bool RevoluteJointId.is_spring_enabled(self) @cname("b3RevoluteJoint_IsSpringEnabled");

<*
 Sets the spring's stiffness in hertz. 0 on a joint built from a default definition, which leaves
 an enabled spring pulling on nothing. box3d asserts the value is finite and non-negative; this
 package links a release build where that assertion is compiled out, and the wrappers do not
 restore it.
*>
extern fn void RevoluteJointId.set_spring_hertz(self, float hertz) @cname("b3RevoluteJoint_SetSpringHertz");

<*
 The spring's stiffness in hertz.
*>
extern fn float RevoluteJointId.spring_hertz(self) @cname("b3RevoluteJoint_GetSpringHertz");

<*
 Sets the spring's damping ratio, non-dimensional: 1 settles the hinge on its target without
 overshooting it. box3d asserts the value is finite and non-negative under the same compiled-out
 assertion set_spring_hertz describes.
*>
extern fn void RevoluteJointId.set_spring_damping_ratio(self, float damping_ratio) @cname("b3RevoluteJoint_SetSpringDampingRatio");

<*
 The spring's damping ratio, non-dimensional.
*>
extern fn float RevoluteJointId.spring_damping_ratio(self) @cname("b3RevoluteJoint_GetSpringDampingRatio");

<*
 Sets the spring's rest angle in radians about the frames' z axis, the angle the spring pulls the
 hinge toward while enable_spring() is on. The spring is the only thing box3d reads it for:
 angle() is the twist between the two local frames and carries no target term, so a hinge settled
 on a target of 0.7 reads 0.7. The value is stored as handed — the constructor clamps a
 definition's target_angle into [-pi, pi], but this setter only asserts the range, and that
 assertion is compiled out here.
*>
extern fn void RevoluteJointId.set_target_angle(self, float target_radians) @cname("b3RevoluteJoint_SetTargetAngle");

<*
 The spring's rest angle in radians. 0 on a joint built from a default definition. What box3d
 stored, which is the definition's value clamped into [-pi, pi] or the setter's value unclamped:
 see set_target_angle.
*>
extern fn float RevoluteJointId.target_angle(self) @cname("b3RevoluteJoint_GetTargetAngle");

<*
 A joint known to be a distance joint, so its per-type accessors need no check at each call. It
 converts to a JointId on its own, so every shared accessor reaches it uncast; the way back is
 JointId.as_distance(), which checks — see there for what a wrong-typed accessor does.
*>
typedef DistanceJointId = inline JointId;

<*
 A distance joint definition: two anchors held at length by a segment, with an optional spring,
 limit and motor. Must come from default_distance_joint_def(), which — unlike the revolute default
 — does not zero what it adds: length is 1, the spring force range is -float::max to float::max,
 and max_length is 1.0e5 scaled by the length unit. box3d solves the spring, limit and motor
 together only while enable_spring && (min_length < max_length || enable_limit == false), and
 otherwise solves one rigid constraint, skipping the limit and the motor.
*>
struct DistanceJointDef {
    inline JointDef base;
    float length;
    bool enable_spring;
    float lower_spring_force;
    float upper_spring_force;
    float hertz;
    float damping_ratio;
    bool enable_limit;
    float min_length;
    float max_length;
    bool enable_motor;
    float max_motor_force;
    float motor_speed;
}

<*
 The range a distance joint's spring force is held between. This is a C3 type with no C
 counterpart: box3d reports the pair through two out-parameters.
*>
struct SpringForceRange {
    float lower;
    float upper;
}

extern fn DistanceJointDef default_distance_joint_def() @cname("b3DefaultDistanceJointDef");

<*
 Raw distance joint constructor. Bypasses WorldId.create_distance_joint's definition guard and
 hands back a joint of no particular type, so it is private to the module —
 box3d_joint_distance.c3's WorldId.create_distance_joint is the only caller and is the only public
 way to a live distance joint.
*>
extern fn JointId create_distance_joint_raw(
  WorldId world_id,
  DistanceJointDef* def,
) @cname("b3CreateDistanceJoint") @private;

<*
 Sets the rest length this joint holds its two anchors at, not the distance they are at now, which
 current_length() reads.

 The value is clamped between box3d's linear slop and its huge value, neither a fixed number:
 0.005 and 1.0e5 length units, so the floor is 0.010 once the length unit is 2. The clamp is
 silent — length() reports what was stored, not what was asked for. Setting the length also zeroes
 the joint's three accumulated impulses, so it rebuilds its hold over the following steps.
*>
extern fn void DistanceJointId.set_length(self, float length) @cname("b3DistanceJoint_SetLength");

<*
 The rest length this joint holds its two anchors at, not the distance the anchors are at now,
 which current_length() reads — even a rigid joint sits a little off its rest length, and both are
 plain floats, so either compiles where the other is meant. The two paths that store it disagree
 at both ends: construction raises a definition's length to the linear slop and gives it no
 ceiling, so a 0 arrives as 0.005 length units and a 1.0e7 untouched, while set_length clamps
 between that floor and 1.0e5.
*>
extern fn float DistanceJointId.length(self) @cname("b3DistanceJoint_GetLength");

<*
 The distance between this joint's two anchors as they stand now, measured from the two bodies'
 current transforms. Not the rest length the joint holds them at, which is what length() reads.

 It is meaningful whether the joint is rigid or sprung, and is how the two are told apart: a rigid
 joint keeps this within a hair of its rest length and a sprung one does not, and which a joint is
 follows the compound condition DistanceJointDef describes, not the spring flag alone. Zero while
 the world is locked.
*>
extern fn float DistanceJointId.current_length(self) @cname("b3DistanceJoint_GetCurrentLength");

<*
 Enables or disables this joint's limit, which holds the anchors' separation between min_length
 and max_length. box3d reaches the limit only inside the branch it solves the spring in, so the
 flag acts under the compound condition DistanceJointDef describes rather than on its own:
 enabling it on a joint whose spring is off changes nothing, and enabling it with min_length equal
 to max_length turns the joint rigid rather than tightening it. Unlike the revolute joint's flag
 of the same name, this one leaves the accumulated impulses alone.
*>
extern fn void DistanceJointId.enable_limit(self, bool enable_limit) @cname("b3DistanceJoint_EnableLimit");

<*
 Whether this joint's limit is enabled. False on a joint built from a default definition. The flag
 is stored whatever the rest of the joint is set to, so a true reading says the limit was asked
 for and not that it is acting: whether the solver reaches the limit at all follows the compound
 condition DistanceJointDef describes.
*>
extern fn bool DistanceJointId.is_limit_enabled(self) @cname("b3DistanceJoint_IsLimitEnabled");

<*
 Sets the two lengths the limit holds the anchors' separation between. box3d clamps each of the
 pair between 0.005 and 1.0e5 length units — so the floor is 0.010 once the length unit is 2 — and
 then stores the smaller of the clamped pair as the minimum and the larger as the maximum. Both
 corrections are silent: min_length() and max_length() report what was stored, and a pair under
 the floor comes back as two equal lengths. Setting the range also zeroes the joint's three
 accumulated impulses, so it rebuilds its hold over the following steps.
*>
extern fn void DistanceJointId.set_length_range(self, float min_length, float max_length) @cname("b3DistanceJoint_SetLengthRange");

<*
 The low end of the separation the limit holds the anchors above. It is what box3d stored, not
 what it was handed: see set_length_range. On a joint fresh from its definition it is neither,
 because construction is its own path — it raises the definition's min_length to the linear slop
 and applies none of the setter's ceiling, so a default definition's 0 arrives as 0.005 length
 units.
*>
extern fn float DistanceJointId.min_length(self) @cname("b3DistanceJoint_GetMinLength");

<*
 The high end of the separation the limit holds the anchors below. It is what box3d stored, not
 what it was handed: see set_length_range. On a joint fresh from its definition it is the larger
 of the definition's two lengths and nothing else — no floor, no ceiling — so a default
 definition's max_length, box3d's huge value of 1.0e5 scaled by the length unit, arrives
 unchanged, while a definition whose max_length is under the slop leaves this reading below
 min_length().
*>
extern fn float DistanceJointId.max_length(self) @cname("b3DistanceJoint_GetMaxLength");

<*
 Enables or disables this joint's spring, and with it the limit and the motor: box3d solves all
 three in one branch whose other half is a single rigid constraint. So this is the joint's master
 switch rather than the spring's alone — enabling the limit or the motor on a joint whose spring
 is off changes nothing — and it is not the only way into the rigid half, whose whole condition
 DistanceJointDef describes. Unlike the revolute joint's flag of the same name, this one leaves
 the accumulated impulses alone.
*>
extern fn void DistanceJointId.enable_spring(self, bool enable_spring) @cname("b3DistanceJoint_EnableSpring");

<*
 Whether this joint's spring is enabled. False on a joint built from a default definition. The
 flag is stored whatever the rest of the joint is set to, so a true reading says the spring was
 asked for and not that the joint is sprung: the other half of the condition DistanceJointDef
 describes can still send it down the rigid branch.
*>
extern fn bool DistanceJointId.is_spring_enabled(self) @cname("b3DistanceJoint_IsSpringEnabled");

<*
 Sets the spring's stiffness in hertz. 0 on a joint built from a default definition, and box3d
 solves the spring only while this is above 0, so an enabled spring left at the default pulls on
 nothing — the joint still takes the sprung branch and its limit and motor still act, but the
 spring itself contributes no impulse.

 Unlike the revolute joint's setter of the same name, this one asserts nothing at all, so a
 negative or non-finite stiffness is not even checked in a build that keeps box3d's assertions.
*>
extern fn void DistanceJointId.set_spring_hertz(self, float hertz) @cname("b3DistanceJoint_SetSpringHertz");

<*
 The spring's stiffness in hertz.
*>
extern fn float DistanceJointId.spring_hertz(self) @cname("b3DistanceJoint_GetSpringHertz");

<*
 Sets the spring's damping ratio, non-dimensional: 1 settles the joint on its rest length without
 overshooting it. 0 on a joint built from a default definition. Asserts nothing, the same absence
 set_spring_hertz describes.
*>
extern fn void DistanceJointId.set_spring_damping_ratio(self, float damping_ratio) @cname("b3DistanceJoint_SetSpringDampingRatio");

<*
 The spring's damping ratio, non-dimensional.
*>
extern fn float DistanceJointId.spring_damping_ratio(self) @cname("b3DistanceJoint_GetSpringDampingRatio");

<*
 Sets the two forces the spring's pull is held between, in newtons; -float::max and float::max on
 a joint built from a default definition. The range acts under the compound condition
 DistanceJointDef describes and only while spring_hertz() is above 0.

 This setter neither clamps its pair nor orders it: box3d's assertion that the lower does not
 exceed the upper is compiled out here, so an inverted pair is stored, reported back verbatim, and
 clamped against as stored. set_length_range, one accessor away, does both — neither carries over.
*>
extern fn void DistanceJointId.set_spring_force_range(self, float lower_force, float upper_force) @cname("b3DistanceJoint_SetSpringForceRange");

<*
 Raw spring force range accessor. Private because it reports the pair through two out-parameters;
 box3d_joint_distance.c3's DistanceJointId.spring_force_range() returns them as one value.
*>
extern fn void spring_force_range_raw(
  DistanceJointId joint_id,
  float* lower_force,
  float* upper_force,
) @cname("b3DistanceJoint_GetSpringForceRange") @private;

<*
 Enables or disables this joint's motor, which drives the two anchors apart at motor_speed() with
 at most max_motor_force() behind it. box3d reaches the motor only inside the branch it solves the
 spring in, so the flag acts under the compound condition DistanceJointDef describes: on a joint
 whose spring is off an enabled motor drives nothing at all.

 A change to the flag discards the motor's accumulated impulse, so motor_force() reads zero until
 the next step; storing the value the flag already holds discards nothing.
*>
extern fn void DistanceJointId.enable_motor(self, bool enable_motor) @cname("b3DistanceJoint_EnableMotor");

<*
 Whether this joint's motor is enabled. False on a joint built from a default definition. The flag
 is stored whatever the rest of the joint is set to, so a true reading says the motor was asked
 for and not that it is driving anything: whether the solver reaches the motor at all follows the
 compound condition DistanceJointDef describes.
*>
extern fn bool DistanceJointId.is_motor_enabled(self) @cname("b3DistanceJoint_IsMotorEnabled");

<*
 Sets the speed the motor drives the two anchors apart at, in metres per second along the segment
 between them: positive lengthens the joint, negative shortens it. It is a target the motor
 pursues only as far as max_motor_force() lets it, and only under the compound condition
 DistanceJointDef describes. Unlike the revolute joint's setter of the same name it asserts
 nothing at all, and it leaves the motor's accumulated impulse as it stands.
*>
extern fn void DistanceJointId.set_motor_speed(self, float motor_speed) @cname("b3DistanceJoint_SetMotorSpeed");

<*
 The speed the motor drives the two anchors apart at, in metres per second. What was set, not what
 the anchors are separating at.
*>
extern fn float DistanceJointId.motor_speed(self) @cname("b3DistanceJoint_GetMotorSpeed");

<*
 Sets the largest force the motor may apply, in newtons; 0 on a joint built from a default
 definition, which leaves an enabled motor unable to move anything. box3d holds the motor's
 impulse between this force scaled by the sub-step, so a motor asked for more speed than it buys
 settles at exactly this reading. Unlike the revolute joint's setter of the same shape it asserts
 nothing, and it leaves the accumulated impulse alone, so motor_force() reports the last step's
 force until another is taken under the new ceiling.
*>
extern fn void DistanceJointId.set_max_motor_force(self, float force) @cname("b3DistanceJoint_SetMaxMotorForce");

<*
 The largest force the motor may apply, in newtons.
*>
extern fn float DistanceJointId.max_motor_force(self) @cname("b3DistanceJoint_GetMaxMotorForce");

<*
 The force the motor applied over the last step, in newtons, bounded by max_motor_force(). Zero on
 a joint the solver has only ever taken the rigid branch for, though that branch leaves the
 impulse untouched, so a joint driven while sprung goes on reporting its last force once made
 rigid. This is the motor's own share where the shared constraint_force() is the whole joint's,
 which carries it exactly once — not twice the way revolute's constraint_torque() does — and
 agrees only while the spring and the limit contribute nothing.
*>
extern fn float DistanceJointId.motor_force(self) @cname("b3DistanceJoint_GetMotorForce");

<*
 A joint known to be prismatic, so its per-type accessors need no check at each call. It converts
 to a JointId on its own, so every shared accessor reaches it uncast; the way back is
 JointId.as_prismatic(), which checks — see there for what a wrong-typed accessor does.
*>
typedef PrismaticJointId = inline JointId;

<*
 A prismatic joint definition: a slider letting body B move along local frame A's x axis alone,
 with an optional spring, limit and motor. The translation it measures is zero where the two local
 frame origins coincide in world space. Must come from default_prismatic_joint_def(), which zeroes
 what it adds to the base — hertz, damping_ratio and max_motor_force included, not the base's
 float::max — so a default prismatic joint is a bare slider. The two translations are stored as
 written: box3d asserts the pair is ordered, and that assertion is compiled out.
*>
struct PrismaticJointDef {
    inline JointDef base;
    bool enable_spring;
    float hertz;
    float damping_ratio;
    float target_translation;
    bool enable_limit;
    float lower_translation;
    float upper_translation;
    bool enable_motor;
    float max_motor_force;
    float motor_speed;
}

extern fn PrismaticJointDef default_prismatic_joint_def() @cname("b3DefaultPrismaticJointDef");

<*
 Raw prismatic joint constructor. Bypasses WorldId.create_prismatic_joint's definition guard and
 hands back a joint of no particular type, so it is private to the module —
 box3d_joint_prismatic.c3's WorldId.create_prismatic_joint is the only caller and is the only
 public way to a live prismatic joint.
*>
extern fn JointId create_prismatic_joint_raw(
  WorldId world_id,
  PrismaticJointDef* def,
) @cname("b3CreatePrismaticJoint") @private;

<*
 The slider's translation in metres: the offset between the two local frame origins in world
 space, resolved onto local frame A's x axis. Zero where those two origins coincide, whatever
 the bodies' own positions are. box3d's comment on this joint's constraint derivation names the
 z axis instead; the code rotates the x axis, and the joint follows the code.
*>
extern fn float PrismaticJointId.translation(self) @cname("b3PrismaticJoint_GetTranslation");

<*
 The rate of change of translation(), in metres per second: the two bodies' relative velocity at
 the joint anchors resolved onto the same axis, plus the term for that axis turning with body A.
 A body with no solver state — a static one, or a sleeping one — contributes zero velocity
 rather than being left out, so against a static anchor this is body B's own speed along the axis.
*>
extern fn float PrismaticJointId.speed(self) @cname("b3PrismaticJoint_GetSpeed");

<*
 Enables or disables this joint's limit. A change to the flag discards the limit's accumulated
 impulses, so a limit switched back on rebuilds its hold over the following steps rather than
 resuming the one it had. set_limits discards nothing.
*>
extern fn void PrismaticJointId.enable_limit(self, bool enable_limit) @cname("b3PrismaticJoint_EnableLimit");

<*
 Whether this joint's limit is enabled. False on a joint built from a default definition. The two
 translations are stored either way; they hold the slider only while this is on.
*>
extern fn bool PrismaticJointId.is_limit_enabled(self) @cname("b3PrismaticJoint_IsLimitEnabled");

<*
 The low end of the translation the limit holds the slider above, in metres along local frame A's
 x axis. It is what box3d stored, and which of the two paths stored it matters: see set_limits.
 0 on a joint built from a default definition.
*>
extern fn float PrismaticJointId.lower_limit(self) @cname("b3PrismaticJoint_GetLowerLimit");

<*
 The high end of the translation the limit holds the slider below, in metres along local frame A's
 x axis. It is what box3d stored, and which of the two paths stored it matters: see set_limits.
 0 on a joint built from a default definition.
*>
extern fn float PrismaticJointId.upper_limit(self) @cname("b3PrismaticJoint_GetUpperLimit");

<*
 Sets the two translations in metres the limit holds the slider between, both asserted finite
 under an assertion this build compiles out. box3d takes the smaller as the lower, so a reversed
 pair is quietly corrected rather than refused, and it stops there — neither end is bounded, where
 the revolute set_limits also clamps. This is where the setter and the constructor part company:
 PrismaticJointDef stores its pair as written. The limit acts only while enable_limit() is on.
*>
extern fn void PrismaticJointId.set_limits(self, float lower, float upper) @cname("b3PrismaticJoint_SetLimits");

<*
 Enables or disables this joint's spring. A change to the flag discards the spring's accumulated
 impulse, so a spring switched back on rebuilds its pull over the following steps rather than
 resuming the one it had. This joint's enable_limit does the same to its own two impulses, where
 the distance joint's two identically named flags discard nothing.
*>
extern fn void PrismaticJointId.enable_spring(self, bool enable_spring) @cname("b3PrismaticJoint_EnableSpring");

<*
 Whether this joint's spring is enabled. False on a joint built from a default definition.
*>
extern fn bool PrismaticJointId.is_spring_enabled(self) @cname("b3PrismaticJoint_IsSpringEnabled");

<*
 Sets the spring's stiffness in hertz. 0 on a joint built from a default definition, which leaves
 an enabled spring pulling on nothing. box3d asserts the value is finite and non-negative; this
 package links a release build where that assertion is compiled out, and the wrappers do not
 restore it.
*>
extern fn void PrismaticJointId.set_spring_hertz(self, float hertz) @cname("b3PrismaticJoint_SetSpringHertz");

<*
 The spring's stiffness in hertz.
*>
extern fn float PrismaticJointId.spring_hertz(self) @cname("b3PrismaticJoint_GetSpringHertz");

<*
 Sets the spring's damping ratio, non-dimensional: 1 settles the slider on its target without
 overshooting it. box3d asserts the value is finite and non-negative under the same compiled-out
 assertion set_spring_hertz describes.
*>
extern fn void PrismaticJointId.set_spring_damping_ratio(self, float damping_ratio) @cname("b3PrismaticJoint_SetSpringDampingRatio");

<*
 The spring's damping ratio, non-dimensional.
*>
extern fn float PrismaticJointId.spring_damping_ratio(self) @cname("b3PrismaticJoint_GetSpringDampingRatio");

<*
 Sets the spring's rest translation in metres along local frame A's x axis, the translation the
 spring pulls the slider toward while enable_spring() is on. translation() is not measured against
 it — that is the offset between the two local frame origins and carries no target term, so a
 slider settled on a target of 0.7 reads 0.7. The value is stored as handed, and the limit if it
 is on still holds the slider inside its own pair, so a target outside that pair is pulled toward
 rather than reached. box3d's finiteness assertion is compiled out here.
*>
extern fn void PrismaticJointId.set_target_translation(self, float target_translation) @cname("b3PrismaticJoint_SetTargetTranslation");

<*
 The spring's rest translation in metres. 0 on a joint built from a default definition. What the
 definition or the setter handed box3d, neither path having bounded it.
*>
extern fn float PrismaticJointId.target_translation(self) @cname("b3PrismaticJoint_GetTargetTranslation");

<*
 Enables or disables this joint's motor. A change to the flag discards the motor's accumulated
 impulse, so motor_force() reads zero until the next step rather than the force the motor was
 applying before.
*>
extern fn void PrismaticJointId.enable_motor(self, bool enable_motor) @cname("b3PrismaticJoint_EnableMotor");

<*
 Whether this joint's motor is enabled. False on a joint built from a default definition.
*>
extern fn bool PrismaticJointId.is_motor_enabled(self) @cname("b3PrismaticJoint_IsMotorEnabled");

<*
 Sets the speed the motor drives the slider at, in metres per second along local frame A's x
 axis. It is a target the motor pursues only as far as max_motor_force() lets it, not a speed the
 slider is made to hold. box3d asserts the value is finite and nothing further — a negative speed
 drives the slider the other way; this package links a release build where that assertion is
 compiled out, and the wrappers do not restore it.
*>
extern fn void PrismaticJointId.set_motor_speed(self, float motor_speed) @cname("b3PrismaticJoint_SetMotorSpeed");

<*
 The speed the motor drives the slider at, in metres per second. What was set, not what the
 slider is moving at: speed() is that.
*>
extern fn float PrismaticJointId.motor_speed(self) @cname("b3PrismaticJoint_GetMotorSpeed");

<*
 Sets the largest force the motor may apply, in newtons. 0 on a joint built from a default
 definition, which leaves an enabled motor unable to move anything. box3d asserts the value is
 finite and non-negative; this package links a release build where that assertion is compiled
 out, and the wrappers do not restore it.
*>
extern fn void PrismaticJointId.set_max_motor_force(self, float force) @cname("b3PrismaticJoint_SetMaxMotorForce");

<*
 The largest force the motor may apply, in newtons.
*>
extern fn float PrismaticJointId.max_motor_force(self) @cname("b3PrismaticJoint_GetMaxMotorForce");

<*
 The force the motor applied over the last step, in newtons, bounded by max_motor_force(), and the
 only sound reading on this type. The shared constraint_force() permutes its components
 cyclically, so the transverse reaction comes back along the frame's free x axis, and it adds an
 opposed limit and motor where the solver subtracts them; the shared constraint_torque() is
 rotated twice, so only its magnitude survives.
*>
extern fn float PrismaticJointId.motor_force(self) @cname("b3PrismaticJoint_GetMotorForce");

<*
 A joint known to be a weld joint, so its per-type accessors need no check at each call. It
 converts to a JointId on its own, so every shared accessor reaches it uncast; the way back is
 JointId.as_weld(), which checks — see there for what a wrong-typed accessor does.
*>
typedef WeldJointId = inline JointId;

<*
 A weld joint definition: the two bodies held at the relative transform their local frames
 describe, with one spring over the translation and another over the rotation. Must come from
 default_weld_joint_def(), which zeroes all four fields it adds to the base.

 Zero hertz means rigid here rather than "no spring", inverting the reading every other sprung
 type invites — raising linear_hertz off 0 makes the weld sag — and the two channels are tested
 separately. box3d's assertion that all four fields are at or above 0 is compiled out here.
*>
struct WeldJointDef {
    inline JointDef base;
    float linear_hertz;
    float angular_hertz;
    float linear_damping_ratio;
    float angular_damping_ratio;
}

extern fn WeldJointDef default_weld_joint_def() @cname("b3DefaultWeldJointDef");

<*
 Raw weld joint constructor. Bypasses WorldId.create_weld_joint's definition guard and hands back
 a joint of no particular type, so it is private to the module — box3d_joint_weld.c3's
 WorldId.create_weld_joint is the only caller and is the only public way to a live weld joint.
*>
extern fn JointId create_weld_joint_raw(
  WorldId world_id,
  WeldJointDef* def,
) @cname("b3CreateWeldJoint") @private;

<*
 Sets the stiffness in hertz of the spring over the two bodies' relative translation. 0 on a joint
 built from a default definition, where it asks for a rigid channel rather than an absent spring,
 as WeldJointDef describes. Nothing is clamped and the accumulated impulses stand.

 box3d's assertion that the value is finite and non-negative is compiled out, and a negative
 splits the solver: prepare tests for exactly 0 and builds a spring from it, while the solve
 engages it only above 0.
*>
extern fn void WeldJointId.set_linear_hertz(self, float hertz) @cname("b3WeldJoint_SetLinearHertz");

<*
 The stiffness in hertz of the spring over the two bodies' relative translation. 0 on a joint built
 from a default definition, and 0 is this joint's rigid setting rather than its softest.
*>
extern fn float WeldJointId.linear_hertz(self) @cname("b3WeldJoint_GetLinearHertz");

<*
 Sets the damping ratio of the spring over the two bodies' relative translation, non-dimensional.
 box3d reads it only while linear_hertz() is away from 0, the channel otherwise being solved with
 the joint's own constraint tuning, which carries a damping ratio of its own. Asserted finite and
 at or above 0 under the same compiled-out assertion set_linear_hertz describes, and stored as
 handed.
*>
extern fn void WeldJointId.set_linear_damping_ratio(self, float damping_ratio) @cname("b3WeldJoint_SetLinearDampingRatio");

<*
 The damping ratio of the spring over the two bodies' relative translation, non-dimensional. 0 on
 a joint built from a default definition.
*>
extern fn float WeldJointId.linear_damping_ratio(self) @cname("b3WeldJoint_GetLinearDampingRatio");

<*
 Sets the stiffness in hertz of the spring over the two bodies' relative rotation. This is the
 joint's other channel and box3d tests the two separately, so the rotation may be rigid at 0 while
 the translation is soft, or the other way about. Everything set_linear_hertz describes holds here
 too, the disagreement over a negative value included.
*>
extern fn void WeldJointId.set_angular_hertz(self, float hertz) @cname("b3WeldJoint_SetAngularHertz");

<*
 The stiffness in hertz of the spring over the two bodies' relative rotation. 0 on a joint built
 from a default definition, and 0 is this joint's rigid setting rather than its softest.
*>
extern fn float WeldJointId.angular_hertz(self) @cname("b3WeldJoint_GetAngularHertz");

<*
 Sets the damping ratio of the spring over the two bodies' relative rotation, non-dimensional.
 Read only while angular_hertz() is away from 0, on the terms set_linear_damping_ratio describes.
*>
extern fn void WeldJointId.set_angular_damping_ratio(self, float damping_ratio) @cname("b3WeldJoint_SetAngularDampingRatio");

<*
 The damping ratio of the spring over the two bodies' relative rotation, non-dimensional. 0 on a
 joint built from a default definition.
*>
extern fn float WeldJointId.angular_damping_ratio(self) @cname("b3WeldJoint_GetAngularDampingRatio");

<*
 A joint known to be a parallel joint, so its per-type accessors need no check at each call. It
 converts to a JointId on its own, so every shared accessor reaches it uncast; the way back is
 JointId.as_parallel(), which checks — see there for what a wrong-typed accessor does.
*>
typedef ParallelJointId = inline JointId;

<*
 A parallel joint definition: a spring holding local frame A's z axis parallel to local frame B's
 and holding nothing else, so the bodies stay free to translate and to spin about that axis —
 which is what keeps a body upright. Must come from default_parallel_joint_def(), which unlike the
 prismatic and weld defaults zeroes nothing it adds: hertz 1, damping_ratio 1, max_torque
 float::max, so a default parallel joint is already sprung. The spring is gated on max_torque
 rather than bounded by it, so a max_torque of 0 stops the joint constraining anything.
*>
struct ParallelJointDef {
    inline JointDef base;
    float hertz;
    float damping_ratio;
    float max_torque;
}

extern fn ParallelJointDef default_parallel_joint_def() @cname("b3DefaultParallelJointDef");

<*
 Raw parallel joint constructor. Bypasses WorldId.create_parallel_joint's definition guard and
 hands back a joint of no particular type, so it is private to the module —
 box3d_joint_parallel.c3's WorldId.create_parallel_joint is the only caller and is the only
 public way to a live parallel joint.
*>
extern fn JointId create_parallel_joint_raw(
  WorldId world_id,
  ParallelJointDef* def,
) @cname("b3CreateParallelJoint") @private;

<*
 Sets the spring's stiffness in hertz, asserted finite and at or above 0 under an assertion this
 build compiles out. 1 by default, and 0 means the opposite of the weld joint's: box3d's softness
 for a zero hertz carries a zero mass scale, so a parallel spring at 0 stops solving, not goes rigid.

 That frees the frames only on a joint silenced before it accumulated an impulse — the warm start
 re-applies the impulse the spring holds every substep, gated on neither hertz nor ceiling, so one
 silenced after working goes on pushing with it.
*>
extern fn void ParallelJointId.set_spring_hertz(self, float hertz) @cname("b3ParallelJoint_SetSpringHertz");

<*
 The spring's stiffness in hertz. 1 on a joint built from a default definition.
*>
extern fn float ParallelJointId.spring_hertz(self) @cname("b3ParallelJoint_GetSpringHertz");

<*
 Sets the spring's damping ratio, non-dimensional. 1 on a joint built from a default definition.
 Asserted finite and at or above 0 under the same compiled-out assertion set_spring_hertz
 describes, and stored as handed.
*>
extern fn void ParallelJointId.set_spring_damping_ratio(self, float damping_ratio) @cname("b3ParallelJoint_SetSpringDampingRatio");

<*
 The spring's damping ratio, non-dimensional. 1 on a joint built from a default definition.
*>
extern fn float ParallelJointId.spring_damping_ratio(self) @cname("b3ParallelJoint_GetSpringDampingRatio");

<*
 Sets the ceiling in newton-metres on the torque the spring may apply, asserted finite and at or
 above 0 under an assertion this build compiles out. float::max by default. The ceiling gates the
 constraint as well as bounding it, so set_max_torque(0) leaves the joint solving nothing at all.
 Upstream names the parameter a force; what it stores and everything reading it is a torque.
 Silencing a spring that has already worked does not undo the impulse it holds — see
 set_spring_hertz.
*>
extern fn void ParallelJointId.set_max_torque(self, float torque) @cname("b3ParallelJoint_SetMaxTorque");

<*
 The ceiling in newton-metres on the torque the spring may apply. float::max on a joint built from
 a default definition.
*>
extern fn float ParallelJointId.max_torque(self) @cname("b3ParallelJoint_GetMaxTorque");

<*
 A joint known to be a motor joint, so its per-type accessors need no check at each call. It
 converts to a JointId on its own, so every shared accessor reaches it uncast; the way back is
 JointId.as_motor(), which checks — see there for what a wrong-typed accessor does.
*>
typedef MotorJointId = inline JointId;

<*
 A motor joint definition: body B driven towards a relative linear and angular velocity, and
 pulled towards the transform the two local frames describe by a linear and an angular spring. The
 type has no enable flags — each of the four channels is switched by its own ceiling, so a ceiling
 of 0 is the channel turned off, and default_motor_joint_def(), which it must come from, zeroes
 all of them. The constructor copies all ten fields verbatim: nothing is validated, clamped or
 reordered.
*>
struct MotorJointDef {
    inline JointDef base;
    Vec3 linear_velocity;
    float max_velocity_force;
    Vec3 angular_velocity;
    float max_velocity_torque;
    float linear_hertz;
    float linear_damping_ratio;
    float max_spring_force;
    float angular_hertz;
    float angular_damping_ratio;
    float max_spring_torque;
}

extern fn MotorJointDef default_motor_joint_def() @cname("b3DefaultMotorJointDef");

<*
 Raw motor joint constructor. Bypasses WorldId.create_motor_joint's definition guard and hands
 back a joint of no particular type, so it is private to the module — box3d_joint_motor.c3's
 WorldId.create_motor_joint is the only caller and is the only public way to a live motor joint.
*>
extern fn JointId create_motor_joint_raw(
  WorldId world_id,
  MotorJointDef* def,
) @cname("b3CreateMotorJoint") @private;

<*
 Sets the velocity the joint drives body B towards relative to body A, in metres per second along
 the world axes: box3d subtracts it from the bodies' relative velocity, rotating it into no frame
 and projecting it onto no axis, so (1, 0, 0) drives along world x however the local frames are
 turned. The drive acts only while max_velocity_force() is above 0, the whole switch on a type
 with no enable flags. Nothing is asserted or clamped, and the drive's accumulated impulse stands,
 so a joint retargeted mid-run works from the force it was already applying.
*>
extern fn void MotorJointId.set_linear_velocity(self, Vec3 velocity) @cname("b3MotorJoint_SetLinearVelocity");

<*
 The velocity the joint drives body B towards relative to body A, in metres per second along the
 world axes. What was set, not what the two bodies are doing. Zero on a joint built from a default
 definition.
*>
extern fn Vec3 MotorJointId.linear_velocity(self) @cname("b3MotorJoint_GetLinearVelocity");

<*
 Sets the ceiling in newtons on the force the linear drive may apply — the drive's switch as well
 as its bound, since box3d solves it only while this is above 0. So a ceiling of 0, which is a
 default definition's, drives nothing at all rather than driving weakly, and a negative silences
 it the same way. Dropping a ceiling on a channel that has already worked does not undo the
 impulse it holds: the warm start re-applies it every substep, gated on nothing. Nothing is
 asserted or clamped here, where this joint's two spring ceilings do floor at 0.
*>
extern fn void MotorJointId.set_max_velocity_force(self, float force) @cname("b3MotorJoint_SetMaxVelocityForce");

<*
 The ceiling in newtons on the force the linear drive may apply, and the switch deciding whether
 the drive is solved at all — see set_max_velocity_force. 0 on a default definition, and otherwise
 whatever was stored, negatives included.

 The shared JointId.constraint_force() is sound here, this type having no force getter of its own:
 box3d divides the summed drive and spring impulses by the sub-step, each counted once, with
 neither a double count nor a permutation. With one channel silent it is the other's alone.
*>
extern fn float MotorJointId.max_velocity_force(self) @cname("b3MotorJoint_GetMaxVelocityForce");

<*
 Sets the angular velocity the joint drives body B towards relative to body A, in radians per
 second about the world axes. box3d subtracts this vector from the difference of the two bodies'
 angular velocities and rotates it into no frame, so a velocity of (1, 0, 0) turns the body about
 world x however the two local frames are turned.

 The drive acts only while max_velocity_torque() is above 0. box3d asserts nothing here and clamps
 nothing; the value is stored as handed and the drive's accumulated impulse stands.
*>
extern fn void MotorJointId.set_angular_velocity(self, Vec3 velocity) @cname("b3MotorJoint_SetAngularVelocity");

<*
 The angular velocity the joint drives body B towards relative to body A, in radians per second
 about the world axes. What was set, not what the two bodies are doing. Zero on a joint built from
 a default definition.
*>
extern fn Vec3 MotorJointId.angular_velocity(self) @cname("b3MotorJoint_GetAngularVelocity");

<*
 Sets the ceiling in newton-metres on the torque the angular drive may apply. It is that drive's
 switch as well as its bound, for the reason and with the warm-start consequence
 set_max_velocity_force describes: 0 — what a default definition gives it — turns the angular
 drive off rather than weakening it, and a negative does the same.

 box3d asserts nothing here and clamps nothing, so a negative ceiling reads back negative.
*>
extern fn void MotorJointId.set_max_velocity_torque(self, float torque) @cname("b3MotorJoint_SetMaxVelocityTorque");

<*
 The ceiling in newton-metres on the torque the angular drive may apply, and the switch deciding
 whether that drive is solved at all — see set_max_velocity_torque. 0 on a joint built from a
 default definition, and otherwise whatever was stored, negatives included.

 This type has no torque getter of its own, and the shared JointId.constraint_torque() is sound
 here: box3d divides the summed angular drive and spring impulses by the sub-step, each counted
 once. With one channel silent it is the other's alone.
*>
extern fn float MotorJointId.max_velocity_torque(self) @cname("b3MotorJoint_GetMaxVelocityTorque");

<*
 Sets the linear spring's stiffness in hertz. The spring pulls local frame B's origin onto local
 frame A's, and box3d solves it only while this and max_spring_force() are both above 0 — either
 at 0 silences it, both are 0 on a default definition, and a negative silences it as 0 does — so
 this is half a switch and not only a stiffness. Stiffness and damping become solver coefficients
 at the top of each step, so a change lands on the next step, not the one in progress. Nothing is
 asserted or clamped.
*>
extern fn void MotorJointId.set_linear_hertz(self, float hertz) @cname("b3MotorJoint_SetLinearHertz");

<*
 The linear spring's stiffness in hertz, and half the switch deciding whether that spring is solved
 at all — see set_linear_hertz. 0 on a joint built from a default definition.
*>
extern fn float MotorJointId.linear_hertz(self) @cname("b3MotorJoint_GetLinearHertz");

<*
 Sets the linear spring's damping ratio, non-dimensional: 1 settles body B on local frame A's
 origin without overshooting it. Unlike the stiffness beside it this decides nothing about whether
 the spring is solved, which follows linear_hertz() and max_spring_force() alone. box3d asserts
 nothing here and clamps nothing.
*>
extern fn void MotorJointId.set_linear_damping_ratio(self, float damping_ratio) @cname("b3MotorJoint_SetLinearDampingRatio");

<*
 The linear spring's damping ratio, non-dimensional. 0 on a joint built from a default definition.
*>
extern fn float MotorJointId.linear_damping_ratio(self) @cname("b3MotorJoint_GetLinearDampingRatio");

<*
 Sets the ceiling in newtons on the force the linear spring may apply, and the other half of that
 spring's switch: box3d solves it only while this and linear_hertz() are both above 0, so a
 ceiling of 0 — a default definition's — leaves the spring holding nothing. This one floors at 0
 where the joint's two velocity ceilings store a negative as handed, so only construction can
 leave this joint reporting a negative. Silencing a working spring by dropping the ceiling leaves
 the impulse it holds standing — see set_max_velocity_force.
*>
extern fn void MotorJointId.set_max_spring_force(self, float force) @cname("b3MotorJoint_SetMaxSpringForce");

<*
 The ceiling in newtons on the force the linear spring may apply, and the other half of the switch
 deciding whether that spring is solved at all — see set_max_spring_force. 0 on a joint built from
 a default definition. Negative only on a joint whose definition carried one, never through the
 setter. The force the spring actually applied is read through the shared
 JointId.constraint_force(), which max_velocity_force describes.
*>
extern fn float MotorJointId.max_spring_force(self) @cname("b3MotorJoint_GetMaxSpringForce");

<*
 Sets the angular spring's stiffness in hertz. The spring turns local frame B onto local frame A's
 orientation, and box3d solves it only while this and max_spring_torque() are both above 0 — either
 one at 0 silences it, and both are 0 on a joint built from a default definition. A negative
 stiffness silences it the same way 0 does. box3d asserts nothing here and clamps nothing, and a
 change lands on the next step for the reason set_linear_hertz gives.
*>
extern fn void MotorJointId.set_angular_hertz(self, float hertz) @cname("b3MotorJoint_SetAngularHertz");

<*
 The angular spring's stiffness in hertz, and half the switch deciding whether that spring is
 solved at all — see set_angular_hertz. 0 on a joint built from a default definition.
*>
extern fn float MotorJointId.angular_hertz(self) @cname("b3MotorJoint_GetAngularHertz");

<*
 Sets the angular spring's damping ratio, non-dimensional: 1 settles local frame B on local frame
 A's orientation without overshooting it. It decides nothing about whether the spring is solved,
 which follows angular_hertz() and max_spring_torque() alone. box3d asserts nothing here and clamps
 nothing.
*>
extern fn void MotorJointId.set_angular_damping_ratio(self, float damping_ratio) @cname("b3MotorJoint_SetAngularDampingRatio");

<*
 The angular spring's damping ratio, non-dimensional. 0 on a joint built from a default definition.
*>
extern fn float MotorJointId.angular_damping_ratio(self) @cname("b3MotorJoint_GetAngularDampingRatio");

<*
 Sets the ceiling in newton-metres on the torque the angular spring may apply, and the other half
 of that spring's switch: box3d solves it only while this and angular_hertz() are both above 0, so
 a ceiling of 0 — a default definition's — leaves the spring turning nothing. Like
 max_spring_force it floors at 0, so only construction can leave this joint reporting a negative
 one, and silencing a working spring by dropping the ceiling leaves the impulse it holds standing.
*>
extern fn void MotorJointId.set_max_spring_torque(self, float torque) @cname("b3MotorJoint_SetMaxSpringTorque");

<*
 The ceiling in newton-metres on the torque the angular spring may apply, and the other half of the
 switch deciding whether that spring is solved at all — see set_max_spring_torque. 0 on a joint
 built from a default definition. Negative only on a joint whose definition carried one, never
 through the setter. The torque the spring actually applied is read through the shared
 JointId.constraint_torque(), which max_velocity_torque describes.
*>
extern fn float MotorJointId.max_spring_torque(self) @cname("b3MotorJoint_GetMaxSpringTorque");

<*
 A joint known to be a spherical joint, so its per-type accessors need no check at each call. It
 converts to a JointId on its own, so every shared accessor reaches it uncast; the way back is
 JointId.as_spherical(), which checks — see there for what a wrong-typed accessor does.
*>
typedef SphericalJointId = inline JointId;

<*
 A spherical joint definition: local frame B's origin pinned to local frame A's, the orientation
 about it bounded only by an optional cone limit, twist limit, spring and motor. Both limited
 angles measure the frames' relative orientation, never position, so a pendulum swing leaves them
 at 0. Must come from default_spherical_joint_def(), which zeroes what it adds except
 target_rotation, the identity quaternion. The constructor clamps cone_angle into [0, pi/2] — half
 the range the field's prose gives — and orders the twist pair before clamping each to ±0.99 pi.
*>
struct SphericalJointDef {
    inline JointDef base;
    bool enable_spring;
    float hertz;
    float damping_ratio;
    Quat target_rotation;
    bool enable_cone_limit;
    float cone_angle;
    bool enable_twist_limit;
    float lower_twist_angle;
    float upper_twist_angle;
    bool enable_motor;
    float max_motor_torque;
    Vec3 motor_velocity;
}

extern fn SphericalJointDef default_spherical_joint_def() @cname("b3DefaultSphericalJointDef");

<*
 Raw spherical joint constructor. Bypasses WorldId.create_spherical_joint's definition guard and
 hands back a joint of no particular type, so it is private to the module —
 box3d_joint_spherical.c3's WorldId.create_spherical_joint is the only caller and is the only
 public way to a live spherical joint.
*>
extern fn JointId create_spherical_joint_raw(
  WorldId world_id,
  SphericalJointDef* def,
) @cname("b3CreateSphericalJoint") @private;

<*
 Enables or disables this joint's cone limit, which bounds how far local frame B's z axis may tilt
 away from local frame A's. A change to the flag discards the cone's accumulated impulse, so a
 limit switched back on rebuilds its hold over the following steps rather than resuming the one it
 had.
*>
extern fn void SphericalJointId.enable_cone_limit(self, bool enable_limit) @cname("b3SphericalJoint_EnableConeLimit");

<*
 Whether this joint's cone limit is enabled. False on a joint built from a default definition.
*>
extern fn bool SphericalJointId.is_cone_limit_enabled(self) @cname("b3SphericalJoint_IsConeLimitEnabled");

<*
 Sets the angle in radians the cone limit holds the two frames' z axes within. box3d stores it as
 handed and clamps nothing, where the constructor clamps SphericalJointDef's cone_angle into [0,
 pi/2], so the two paths reach the solver with different cones. Its assertion that the value is
 finite and within [0, pi/2] is compiled out here, so a negative angle or one past pi/2 reaches
 the solver through this call and no other. The limit acts only while is_cone_limit_enabled() is
 on, and setting it leaves the cone's accumulated impulse standing.
*>
extern fn void SphericalJointId.set_cone_limit(self, float angle_radians) @cname("b3SphericalJoint_SetConeLimit");

<*
 The angle in radians the cone limit holds the two frames' z axes within. It is what box3d stored,
 which is what set_cone_limit was handed or what the constructor clamped the definition's
 cone_angle to — see set_cone_limit for why those differ. 0 on a joint built from a default
 definition.
*>
extern fn float SphericalJointId.cone_limit(self) @cname("b3SphericalJoint_GetConeLimit");

<*
 The current angle in radians between local frame A's z axis and local frame B's, kept in [0, pi].
 Read from the frames' relative orientation and never from the bodies' positions, as
 SphericalJointDef describes. It is reported whether or not the cone limit is enabled, and against
 the frames' current alignment rather than against cone_limit().
*>
extern fn float SphericalJointId.cone_angle(self) @cname("b3SphericalJoint_GetConeAngle");

<*
 Enables or disables this joint's twist limit, which bounds the rotation of local frame B about
 the frames' shared z axis. A change to the flag discards both of the twist's accumulated
 impulses, so a limit switched back on rebuilds its hold over the following steps rather than
 resuming the one it had.
*>
extern fn void SphericalJointId.enable_twist_limit(self, bool enable_limit) @cname("b3SphericalJoint_EnableTwistLimit");

<*
 Whether this joint's twist limit is enabled. False on a joint built from a default definition.
*>
extern fn bool SphericalJointId.is_twist_limit_enabled(self) @cname("b3SphericalJoint_IsTwistLimitEnabled");

<*
 The low end of the rotation about the frames' z axis the twist limit holds body B above, in
 radians. It is what box3d stored, not what it was handed: see set_twist_limits. 0 on a joint
 built from a default definition.
*>
extern fn float SphericalJointId.lower_twist_limit(self) @cname("b3SphericalJoint_GetLowerTwistLimit");

<*
 The high end of the rotation about the frames' z axis the twist limit holds body B below, in
 radians. It is what box3d stored, not what it was handed: see set_twist_limits. 0 on a joint
 built from a default definition.
*>
extern fn float SphericalJointId.upper_twist_limit(self) @cname("b3SphericalJoint_GetUpperTwistLimit");

<*
 Sets the two angles in radians the twist limit holds the rotation about the frames' z axis
 between. box3d takes the smaller of the pair as the lower and the larger as the upper, so a
 reversed pair is quietly corrected rather than refused, and then clamps both into [-0.99 pi, 0.99
 pi] — the same correction the constructor applies, so a twist limit arrives the same however it
 was asked for. Its finiteness assertion is compiled out here. The limit acts only while
 is_twist_limit_enabled() is on, and setting it leaves the accumulated impulses standing.
*>
extern fn void SphericalJointId.set_twist_limits(self, float lower_radians, float upper_radians) @cname("b3SphericalJoint_SetTwistLimits");

<*
 The current rotation in radians of local frame B about the frames' shared z axis, kept in
 [-pi, pi]. Read from the frames' relative orientation and never from the bodies' positions, as
 SphericalJointDef describes. It is reported whether or not the twist limit is enabled, and against
 the frames' current alignment rather than against the twist limit pair.
*>
extern fn float SphericalJointId.twist_angle(self) @cname("b3SphericalJoint_GetTwistAngle");

<*
 Enables or disables this joint's angular spring, which turns local frame B towards the rotation
 target_rotation() names relative to local frame A. A change to the flag discards the spring's
 accumulated impulse, so a spring switched back on rebuilds its pull over the following steps
 rather than resuming the one it had, and one switched off releases what it was holding rather
 than leaving it standing. box3d asserts nothing here.
*>
extern fn void SphericalJointId.enable_spring(self, bool enable_spring) @cname("b3SphericalJoint_EnableSpring");

<*
 Whether this joint's angular spring is enabled. False on a joint built from a default definition.
*>
extern fn bool SphericalJointId.is_spring_enabled(self) @cname("b3SphericalJoint_IsSpringEnabled");

<*
 Sets the spring's stiffness in hertz. 0 on a joint built from a default definition, which leaves
 an enabled spring pulling on nothing: box3d's softness for zero hertz has a zero mass scale, so
 the spring computes no impulse at all. box3d asserts the value is finite and non-negative, an
 assertion this release build compiles out and the wrappers do not restore, and it clamps nothing.
 The constructor copies a definition's hertz the same way, so the two paths agree.
*>
extern fn void SphericalJointId.set_spring_hertz(self, float hertz) @cname("b3SphericalJoint_SetSpringHertz");

<*
 The spring's stiffness in hertz. 0 on a joint built from a default definition.
*>
extern fn float SphericalJointId.spring_hertz(self) @cname("b3SphericalJoint_GetSpringHertz");

<*
 Sets the spring's damping ratio, non-dimensional. 0 on a joint built from a default definition.
 box3d reads it only while spring_hertz() is non-zero, under the same compiled-out assertion
 set_spring_hertz describes, and the constructor copies a definition's ratio the same way.
*>
extern fn void SphericalJointId.set_spring_damping_ratio(self, float damping_ratio) @cname("b3SphericalJoint_SetSpringDampingRatio");

<*
 The spring's damping ratio, non-dimensional. 0 on a joint built from a default definition.
*>
extern fn float SphericalJointId.spring_damping_ratio(self) @cname("b3SphericalJoint_GetSpringDampingRatio");

<*
 Sets the rotation of local frame B relative to local frame A the spring turns towards while
 is_spring_enabled() is on. The spring is the only thing box3d reads it for: cone_angle() and
 twist_angle() are measured against the frames' current alignment and carry no target term.

 box3d stores the quaternion as handed and neither normalises nor corrects it — its validity
 assertion is compiled out here — so a target that is not a unit quaternion is solved against as
 given, through this call and through the constructor alike.
*>
extern fn void SphericalJointId.set_target_rotation(self, Quat target_rotation) @cname("b3SphericalJoint_SetTargetRotation");

<*
 The rotation of local frame B relative to local frame A the spring turns towards. It is what was
 stored, unit length or not — see set_target_rotation. The identity quaternion (0, 0, 0, 1) on a
 joint built from a default definition, which is the one field that default does not zero.
*>
extern fn Quat SphericalJointId.target_rotation(self) @cname("b3SphericalJoint_GetTargetRotation");

<*
 Enables or disables this joint's motor; this flag is the gate box3d's motor solve itself tests. A
 change discards the motor's accumulated impulse, so motor_torque() reads zero from the call
 onward and box3d's warm start — which re-applies that impulse every sub-step whether the motor is
 enabled or not — is left with nothing to re-apply, so a motor switched off releases body B rather
 than going on pushing it. A max_motor_torque() of 0 releases it too, by the clamp inside that
 solve rather than by skipping it.
*>
extern fn void SphericalJointId.enable_motor(self, bool enable_motor) @cname("b3SphericalJoint_EnableMotor");

<*
 Whether this joint's motor is enabled. False on a joint built from a default definition.
*>
extern fn bool SphericalJointId.is_motor_enabled(self) @cname("b3SphericalJoint_IsMotorEnabled");

<*
 Sets the angular velocity in radians per second the motor drives body B towards relative to body
 A, about the world axes, asserted finite under an assertion this build compiles out. box3d
 subtracts it from the difference of the two bodies' angular velocities, rotating it into no frame
 and projecting it onto no axis, so (0, 0, 1) turns body B about world z however the local frames
 are turned. A target the motor pursues only as far as max_motor_torque() lets it, leaving the
 motor's accumulated impulse standing.
*>
extern fn void SphericalJointId.set_motor_velocity(self, Vec3 motor_velocity) @cname("b3SphericalJoint_SetMotorVelocity");

<*
 The angular velocity the motor drives body B towards relative to body A, in radians per second
 about the world axes. What was set, not what body B is turning at. Zero on a joint built from a
 default definition.
*>
extern fn Vec3 SphericalJointId.motor_velocity(self) @cname("b3SphericalJoint_GetMotorVelocity");

<*
 The torque the motor applied over the last step, in newton-metres about the world axes — a whole
 vector because this motor drives all three rotational degrees of freedom, and max_motor_torque()
 bounds its length rather than any one component.

 It is the honest reading of the two. The shared constraint_torque() sums it with the spring's and
 the limits', agreeing while both limits are silent; but the cone's impulse enters that sum with
 its sign reversed, and the twist's along the wrong axis unless the swing angle is 0.
*>
extern fn Vec3 SphericalJointId.motor_torque(self) @cname("b3SphericalJoint_GetMotorTorque");

<*
 Sets the largest torque in newton-metres the motor may apply, bounding the length of the motor's
 angular impulse rather than any one component. 0 on a default definition, which leaves an enabled
 motor unable to turn anything, and dropping it to 0 on a working motor releases what it held. The
 value is stored as handed and never floored — the finite, non-negative assertion is compiled out
 — and a negative is not read as zero: the rescale reverses the impulse, driving body B away from
 motor_velocity() at the ceiling's magnitude.
*>
extern fn void SphericalJointId.set_max_motor_torque(self, float torque) @cname("b3SphericalJoint_SetMaxMotorTorque");

<*
 The largest torque in newton-metres the motor may apply. What was set. 0 on a joint built from a
 default definition.
*>
extern fn float SphericalJointId.max_motor_torque(self) @cname("b3SphericalJoint_GetMaxMotorTorque");

<*
 A joint known to be a wheel joint, so its per-type accessors need no check at each call. It
 converts to a JointId on its own, so every shared accessor reaches it uncast; the way back is
 JointId.as_wheel(), which checks — see there for what a wrong-typed accessor does.
*>
typedef WheelJointId = inline JointId;

<*
 A wheel joint definition. Body A is the chassis and body B the wheel: it spins about local frame
 B's z axis, its suspension travels along local frame A's x axis, and its steering turns about
 that same axis. Must come from default_wheel_joint_def(), the only default here arriving with an
 enable flag set — enable_suspension_spring at hertz 1 and damping 0.7 — so a wheel is already
 sprung, where the steering carries the same pair unsolved until enable_steering is set.
 angular_separation() returns 0 on every wheel joint because box3d never wrote that case.
*>
struct WheelJointDef {
    inline JointDef base;
    bool enable_suspension_spring;
    float suspension_hertz;
    float suspension_damping_ratio;
    bool enable_suspension_limit;
    float lower_suspension_limit;
    float upper_suspension_limit;
    bool enable_spin_motor;
    float max_spin_torque;
    float spin_speed;
    bool enable_steering;
    float steering_hertz;
    float steering_damping_ratio;
    float target_steering_angle;
    float max_steering_torque;
    bool enable_steering_limit;
    float lower_steering_limit;
    float upper_steering_limit;
}

extern fn WheelJointDef default_wheel_joint_def() @cname("b3DefaultWheelJointDef");

<*
 Raw wheel joint constructor. Bypasses WorldId.create_wheel_joint's definition guard and hands
 back a joint of no particular type, so it is private to the module — box3d_joint_wheel.c3's
 WorldId.create_wheel_joint is the only caller and is the only public way to a live wheel joint.
*>
extern fn JointId create_wheel_joint_raw(
  WorldId world_id,
  WheelJointDef* def,
) @cname("b3CreateWheelJoint") @private;

<*
 Enables or disables this joint's suspension spring, which pulls the wheel back along local frame
 A's x axis towards the chassis anchor. A change to the flag discards the spring's accumulated
 impulse, so a spring switched back on rebuilds its push over the following steps rather than
 resuming the one it had, and setting the flag to what it already holds discards nothing. box3d
 asserts nothing here.
*>
extern fn void WheelJointId.enable_suspension(self, bool enable_spring) @cname("b3WheelJoint_EnableSuspension");

<*
 Whether this joint's suspension spring is enabled. True on a joint built from a default
 definition, which is the only enable flag any joint definition in this package starts set.
*>
extern fn bool WheelJointId.is_suspension_enabled(self) @cname("b3WheelJoint_IsSuspensionEnabled");

<*
 Sets the suspension spring's stiffness in hertz. 1 on a joint built from a default definition,
 where every other type's spring arrives at 0. box3d asserts nothing at all here — not even that
 the value is finite, which the prismatic and spherical springs' identically shaped setters do —
 clamps nothing, and discards no impulse.
*>
extern fn void WheelJointId.set_suspension_hertz(self, float hertz) @cname("b3WheelJoint_SetSuspensionHertz");

<*
 The suspension spring's stiffness in hertz. 1 on a joint built from a default definition.
*>
extern fn float WheelJointId.suspension_hertz(self) @cname("b3WheelJoint_GetSuspensionHertz");

<*
 Sets the suspension spring's damping ratio, non-dimensional: 1 settles the wheel on the chassis
 anchor without overshooting it. 0.7 on a joint built from a default definition. box3d asserts
 nothing and clamps nothing here either — see set_suspension_hertz.
*>
extern fn void WheelJointId.set_suspension_damping_ratio(self, float damping_ratio) @cname("b3WheelJoint_SetSuspensionDampingRatio");

<*
 The suspension spring's damping ratio, non-dimensional. 0.7 on a joint built from a default
 definition.
*>
extern fn float WheelJointId.suspension_damping_ratio(self) @cname("b3WheelJoint_GetSuspensionDampingRatio");

<*
 Enables or disables this joint's suspension limit, which bounds the travel along local frame A's
 x axis to lower_suspension_limit() and upper_suspension_limit(). A change to the flag discards
 both of the limit's accumulated impulses, so a limit switched back on rebuilds its hold over the
 following steps rather than resuming the one it had. The limit is solved whether or not the
 suspension spring is enabled. box3d asserts nothing here.
*>
extern fn void WheelJointId.enable_suspension_limit(self, bool enable_limit) @cname("b3WheelJoint_EnableSuspensionLimit");

<*
 Whether this joint's suspension limit is enabled. False on a joint built from a default
 definition. The two travels are stored either way; they hold the wheel only while this is on.
*>
extern fn bool WheelJointId.is_suspension_limit_enabled(self) @cname("b3WheelJoint_IsSuspensionLimitEnabled");

<*
 The low end of the travel the limit holds the wheel above, in metres along local frame A's x
 axis. It is what box3d stored, and box3d stores whatever it was handed: see set_suspension_limits
 for why that matters on this type. 0 on a joint built from a default definition.
*>
extern fn float WheelJointId.lower_suspension_limit(self) @cname("b3WheelJoint_GetLowerSuspensionLimit");

<*
 The high end of the travel the limit holds the wheel below, in metres along local frame A's x
 axis. It is what box3d stored, and box3d stores whatever it was handed: see set_suspension_limits
 for why that matters on this type. 0 on a joint built from a default definition.
*>
extern fn float WheelJointId.upper_suspension_limit(self) @cname("b3WheelJoint_GetUpperSuspensionLimit");

<*
 Sets the two travels in metres the limit holds the wheel between, along local frame A's x axis.
 box3d neither orders the pair nor bounds it: both values are stored as handed, so a reversed pair
 stays reversed and a travel far outside anything the wheel can reach stays where it was put. Its
 assertion that the lower is no greater than the upper is compiled out here, and WheelJointDef's
 pair reaches the solver the same way. A call that changes either value discards both of the
 limit's accumulated impulses. The limit acts only while is_suspension_limit_enabled() is on.
*>
extern fn void WheelJointId.set_suspension_limits(self, float lower, float upper) @cname("b3WheelJoint_SetSuspensionLimits");

<*
 Enables or disables this joint's spin motor, which turns the wheel about local frame B's z axis.
 A change to the flag discards the motor's accumulated impulse, so spin_torque() reads zero until
 the next step rather than the torque the motor was applying before. box3d asserts nothing here.
*>
extern fn void WheelJointId.enable_spin_motor(self, bool enable_motor) @cname("b3WheelJoint_EnableSpinMotor");

<*
 Whether this joint's spin motor is enabled. False on a joint built from a default definition.
*>
extern fn bool WheelJointId.is_spin_motor_enabled(self) @cname("b3WheelJoint_IsSpinMotorEnabled");

<*
 Sets the speed the spin motor drives the wheel at, in radians per second about local frame B's z
 axis. It is a target the motor pursues only as far as max_spin_torque() lets it, not a speed the
 wheel is made to hold, and a negative speed turns it the other way. box3d asserts nothing here
 and stores the value verbatim. spin_speed() is the rate the wheel is actually turning at, not this
 target, and WheelJointDef spells the target spin_speed as well — three names over two quantities.
*>
extern fn void WheelJointId.set_spin_motor_speed(self, float speed) @cname("b3WheelJoint_SetSpinMotorSpeed");

<*
 The speed the spin motor is driving the wheel towards, in radians per second. What was set, not
 what the wheel is turning at: spin_speed() is that. 0 on a joint built from a default definition.
*>
extern fn float WheelJointId.spin_motor_speed(self) @cname("b3WheelJoint_GetSpinMotorSpeed");

<*
 Sets the largest torque in newton-metres the spin motor may apply. 0 on a joint built from a
 default definition, which leaves an enabled motor unable to turn anything. box3d asserts nothing
 and floors nothing: the value is stored exactly as handed, where the motor joint's two spring
 ceilings floor theirs at zero in the setter.
*>
extern fn void WheelJointId.set_max_spin_torque(self, float torque) @cname("b3WheelJoint_SetMaxSpinTorque");

<*
 The largest torque the spin motor may apply, in newton-metres. What was set, neither path having
 floored it.
*>
extern fn float WheelJointId.max_spin_torque(self) @cname("b3WheelJoint_GetMaxSpinTorque");

<*
 The rate the wheel is turning at, in radians per second: the two bodies' relative angular
 velocity resolved onto local frame B's z axis. This is the measured rate, where
 spin_motor_speed() is the target the motor drives towards. A body with no solver state — a static
 one, or a sleeping one — contributes zero angular velocity rather than being left out, so against
 a static chassis this is the wheel's own rate about that axis. It is measured whether or not the
 spin motor is enabled.
*>
extern fn float WheelJointId.spin_speed(self) @cname("b3WheelJoint_GetSpinSpeed");

<*
 The spin channel's accumulated impulse divided by the last sub-step, in newton-metres, saturating
 at max_spin_torque() and signed about local frame B's z axis.

 It is a torque only while steering is enabled. With steering off — the default — box3d applies
 the spin impulse twice and this reports the correction for that, a number moving with the ceiling
 and doubling with the sub-step count. constraint_torque() lays the same impulse on frame A's z
 axis instead, and constraint_force() is wrong twice over — see there.
*>
extern fn float WheelJointId.spin_torque(self) @cname("b3WheelJoint_GetSpinTorque");

<*
 Enables or disables this joint's steering, which frees the wheel to turn about local frame A's x
 axis. While it is off box3d pins the steering angle at zero with an alignment row instead, so the
 wheel cannot steer at all and an angle already turned is driven back over the following steps. A
 change to the flag discards the alignment rows' accumulated impulse and nothing else: the
 spring's and the limit's two survive, and since none of the three is solved while this is off,
 steering_torque() goes on reporting the spring's last impulse.
*>
extern fn void WheelJointId.enable_steering(self, bool enable_steering) @cname("b3WheelJoint_EnableSteering");

<*
 Whether this joint's steering is enabled. False on a joint built from a default definition, which
 arrives with the steering spring tuned — steering_hertz 1 and steering_damping_ratio 0.7 — but
 with nothing solving it until this is set.
*>
extern fn bool WheelJointId.is_steering_enabled(self) @cname("b3WheelJoint_IsSteeringEnabled");

<*
 Sets the steering spring's stiffness in hertz. 1 on a joint built from a default definition. Zero
 leaves the spring inert rather than rigid: box3d builds the spring's softness from this value and
 a zero hertz yields a zero mass scale, so enabled steering with no hertz applies no torque
 towards the target at all. box3d asserts nothing at all here — not even that the value is finite,
 which the prismatic and spherical springs' identically shaped setters do — clamps nothing, and
 discards no impulse.
*>
extern fn void WheelJointId.set_steering_hertz(self, float hertz) @cname("b3WheelJoint_SetSteeringHertz");

<*
 The steering spring's stiffness in hertz. 1 on a joint built from a default definition.
*>
extern fn float WheelJointId.steering_hertz(self) @cname("b3WheelJoint_GetSteeringHertz");

<*
 Sets the steering spring's damping ratio, non-dimensional: 1 brings the wheel onto the target
 steering angle without overshooting it. 0.7 on a joint built from a default definition. box3d
 asserts nothing and clamps nothing here either — see set_steering_hertz.
*>
extern fn void WheelJointId.set_steering_damping_ratio(self, float damping_ratio) @cname("b3WheelJoint_SetSteeringDampingRatio");

<*
 The steering spring's damping ratio, non-dimensional. 0.7 on a joint built from a default
 definition.
*>
extern fn float WheelJointId.steering_damping_ratio(self) @cname("b3WheelJoint_GetSteeringDampingRatio");

<*
 Sets the largest torque in newton-metres the steering spring may apply. 0 on a joint built from a
 default definition, which leaves enabled steering unable to turn the wheel at all. box3d bounds
 the spring's impulse to this on both sides, so it is what steering_torque() saturates at. box3d
 asserts nothing and floors nothing: the value is stored exactly as handed, where the motor
 joint's two spring ceilings floor theirs at zero in the setter.
*>
extern fn void WheelJointId.set_max_steering_torque(self, float torque) @cname("b3WheelJoint_SetMaxSteeringTorque");

<*
 The largest torque the steering spring may apply, in newton-metres. What was set, neither path
 having floored it.
*>
extern fn float WheelJointId.max_steering_torque(self) @cname("b3WheelJoint_GetMaxSteeringTorque");

<*
 Enables or disables this joint's steering limit, which bounds the steering angle to
 lower_steering_limit() and upper_steering_limit(). A change discards both of the limit's
 accumulated impulses, so a limit switched back on rebuilds its hold over the following steps.
 box3d reaches this limit only inside the branch it solves the steering spring in, so it does
 nothing at all while is_steering_enabled() is false — where the suspension limit is solved
 whether or not its own spring is enabled.
*>
extern fn void WheelJointId.enable_steering_limit(self, bool enable_limit) @cname("b3WheelJoint_EnableSteeringLimit");

<*
 Whether this joint's steering limit is enabled. False on a joint built from a default definition.
 The two angles are stored either way; they hold the wheel only while this and
 is_steering_enabled() are both on.
*>
extern fn bool WheelJointId.is_steering_limit_enabled(self) @cname("b3WheelJoint_IsSteeringLimitEnabled");

<*
 The low end of the angle the limit holds the steering above, in radians about local frame A's x
 axis. It is what box3d stored, and box3d stores whatever it was handed: see set_steering_limits
 for why that matters on this type. 0 on a joint built from a default definition.
*>
extern fn float WheelJointId.lower_steering_limit(self) @cname("b3WheelJoint_GetLowerSteeringLimit");

<*
 The high end of the angle the limit holds the steering below, in radians about local frame A's x
 axis. It is what box3d stored, and box3d stores whatever it was handed: see set_steering_limits
 for why that matters on this type. 0 on a joint built from a default definition.
*>
extern fn float WheelJointId.upper_steering_limit(self) @cname("b3WheelJoint_GetUpperSteeringLimit");

<*
 Sets the two angles in radians the limit holds the steering between, about local frame A's x
 axis. box3d neither orders the pair nor bounds it: both are stored as handed, so a reversed pair
 stays reversed. Its assertion that the lower is no greater than the upper is compiled out here,
 and the constructor does not assert even that, so a definition's steering pair is unchecked on
 any build. This setter discards no impulse where its sibling set_suspension_limits discards both
 of the suspension limit's. The limit acts only while steering and its own flag are both on.
*>
extern fn void WheelJointId.set_steering_limits(self, float lower_radians, float upper_radians) @cname("b3WheelJoint_SetSteeringLimits");

<*
 Sets the angle in radians the steering spring pulls the wheel towards, about local frame A's x
 axis. box3d asserts nothing here, clamps nothing and discards no impulse, so a target several
 turns past anything the wheel can be held at stays where it was put — the revolute joint's
 folding of the same quantity into [-pi, pi] has no counterpart on this type through either path.
 The spring pursues the target only as far as max_steering_torque() allows, and only while
 is_steering_enabled() is on.
*>
extern fn void WheelJointId.set_target_steering_angle(self, float target_radians) @cname("b3WheelJoint_SetTargetSteeringAngle");

<*
 The angle the steering spring is pulling the wheel towards, in radians. What was set, not the
 angle the wheel is turned to: steering_angle() is that. 0 on a joint built from a default
 definition.
*>
extern fn float WheelJointId.target_steering_angle(self) @cname("b3WheelJoint_GetTargetSteeringAngle");

<*
 The angle the wheel is turned to, in radians about local frame A's x axis: box3d resolves local
 frame B's z axis onto frame A's z and y axes from the two bodies' current transforms and takes
 the arc tangent of the pair. This is the measured angle, where target_steering_angle() is the
 rest angle the spring pulls it towards. It is measured whether or not steering is enabled, and
 being an arc tangent it wraps into [-pi, pi], so an angle driven past a half turn comes back on
 the other side.
*>
extern fn float WheelJointId.steering_angle(self) @cname("b3WheelJoint_GetSteeringAngle");

<*
 The torque the steering spring applied over the last sub-step, in newton-metres, saturating at
 max_steering_torque(). The steering limit's two impulses are not in it, so a wheel stopped by its
 limit reports what its spring is doing and not the hold.

 It is signed about the steering axis, but the relation between that sign and the direction of
 travel inverts once the spring saturates: read the magnitude against max_steering_torque() and
 take the direction from steering_angle(). The shared accessors do not see this channel at all.
*>
extern fn float WheelJointId.steering_torque(self) @cname("b3WheelJoint_GetSteeringTorque");

<*
 A buffer of recorded world mutations: what a world writes between WorldId.start_recording() and
 WorldId.stop_recording(), and what create_player() and validate_replay() replay from. The caller
 owns it and must destroy() it exactly once; byte_count() carries it until then — 64 KiB at the
 default capacity — so a recording never destroyed shifts that count as a leaked world does.
*>
typedef Recording = void;

<*
 Creates a recording buffer. box3d takes 64 KiB when byte_capacity is zero or below, and grows the
 buffer on demand from wherever it starts, so the capacity is a starting size and not a bound.
 Nothing here is fallible — box3d has no refusal path. The caller owns it, and must destroy() it.
*>
extern fn Recording* create_recording(int byte_capacity) @cname("b3CreateRecording");

<*
 Releases the recording and its buffer. The caller owns it and must call this exactly once — see
 Recording. Any slice data() handed out dangles from here.
*>
extern fn void Recording.destroy(&self) @cname("b3DestroyRecording");

extern fn char* recording_data_raw(Recording* recording) @cname("b3Recording_GetData") @private;
extern fn int recording_size_raw(Recording* recording) @cname("b3Recording_GetSize") @private;
extern fn void start_recording_raw(WorldId world_id, Recording* recording) @cname("b3World_StartRecording") @private;

<*
 Ends the session, writing the trailing geometry registry and backpatching the header, which is
 what leaves the buffer self-contained. Inert on a world that is not recording, and
 WorldId.destroy() does this itself, so a world torn down mid-session still leaves playable bytes.
*>
extern fn void WorldId.stop_recording(self) @cname("b3World_StopRecording");

extern fn bool save_recording_raw(Recording* recording, ZString path) @cname("b3SaveRecordingToFile") @private;
extern fn Recording* load_recording_raw(ZString path) @cname("b3LoadRecordingFromFile") @private;
extern fn bool validate_replay_raw(void* data, int size, int worker_count) @cname("b3ValidateReplay") @private;

<*
 A recording being replayed frame by frame. box3d stands a private world up for it, so a live
 player adds one to world_count() and a leaked player leaks that world. Opaque upstream, so it
 could not be copied. Build one with create_player().
*>
typedef RecPlayer = void;

<*
 Releases the player, the replay world it stands up, its copy of the recorded bytes, and the
 length unit it took over — see create_player(). The caller owns the player and must call this
 exactly once.
*>
extern fn void RecPlayer.destroy(&self) @cname("b3DestroyPlayer");

extern fn RecPlayer* create_player_raw(void* data, int size, int worker_count) @cname("b3CreatePlayer") @private;
