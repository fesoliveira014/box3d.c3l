module b3;

import std::math::quaternion;

alias Vec3 = float[<3>];
alias Quat = Quaternionf;
<*
 A three by three matrix held as its three columns, which is how box3d multiplies it: b3MulMV
 reads cx * a.x + cy * a.y + cz * a.z. A caller filling it from rows transposes it silently.
*>
struct Matrix3 {
    Vec3 cx;
    Vec3 cy;
    Vec3 cz;
}

<*
 A world position. Distinct from Vec3 so a position is never silently used as a direction.
 box3d widens this to double in large-world mode, which this package does not build.
*>
typedef Pos = inline Vec3;

struct WorldId {
    ushort index1;
    ushort generation;
}

struct BodyId {
    int index1;
    ushort world0;
    ushort generation;
}

struct ShapeId {
    int index1;
    ushort world0;
    ushort generation;
}

struct JointId {
    int index1;
    ushort world0;
    ushort generation;
}

struct ContactId {
    int index1;
    ushort world0;
    short padding;
    uint generation;
}

struct Transform {
    Vec3 p;
    Quat q;
}

struct WorldTransform {
    Pos p;
    Quat q;
}

struct Aabb {
    Vec3 lower_bound;
    Vec3 upper_bound;
}

struct Plane {
    Vec3 normal;
    float offset;
}

struct CosSin {
    float cosine;
    float sine;
}

struct SegmentDistanceResult {
    Vec3 point1;
    float fraction1;
    Vec3 point2;
    float fraction2;
}

extern fn Vec3 point_to_segment_distance(Vec3 a, Vec3 b, Vec3 q) @cname("b3PointToSegmentDistance");
extern fn CosSin compute_cos_sin(float radians) @cname("b3ComputeCosSin");
<*
 An approximate arc tangent of y over x, in radians over [-pi, pi]. box3d's own, because the
 standard library's is not deterministic across platforms: sampled against it every tenth of a
 degree over a full turn the worst error is 0.0000277 radians, 0.00158 degrees. Both zero gives 0.
*>
extern fn float atan2(float y, float x) @cname("b3Atan2");
extern fn SegmentDistanceResult segment_distance(Vec3 p1, Vec3 q1, Vec3 p2, Vec3 q2) @cname("b3SegmentDistance");
<*
 Raw line distance. Private because line_distance() refuses the zero first direction box3d divides
 by wherever the lines are parallel, which a zero direction always is.
*>
extern fn SegmentDistanceResult line_distance_raw(Vec3 p1, Vec3 d1, Vec3 p2, Vec3 d2) @cname("b3LineDistance") @private;
<*
 The inertia tensor of a point mass held at an offset from the origin, the parallel axis theorem's
 term: mass times the squared distance across each axis down the diagonal, the negated
 mass-weighted products off it. Add it to a tensor about the centre of mass to move that tensor.
*>
extern fn Matrix3 steiner(float mass, Vec3 origin) @cname("b3Steiner");
<*
 Raw rotation from a matrix. Private because make_quat_from_matrix() takes the matrix by value
 where box3d takes a pointer to it.
*>
extern fn Quat make_quat_from_matrix_raw(Matrix3* m) @cname("b3MakeQuatFromMatrix") @private;
<*
 Raw rotation between two vectors. Private because compute_quat_between_unit_vectors() refuses the
 vectors box3d does no more than assert are unit.
*>
extern fn Quat compute_quat_between_unit_vectors_raw(Vec3 v1, Vec3 v2) @cname("b3ComputeQuatBetweenUnitVectors") @private;
extern fn bool is_valid_float(float a) @cname("b3IsValidFloat");
extern fn bool is_valid_vec3(Vec3 a) @cname("b3IsValidVec3");
extern fn bool is_valid_position(Pos p) @cname("b3IsValidPosition");
extern fn bool is_valid_quat(Quat q) @cname("b3IsValidQuat");
extern fn bool is_valid_transform(Transform a) @cname("b3IsValidTransform");
<*
 Whether the position is finite and the rotation is a unit quaternion. Nothing bounds how far out
 the position is: one 1e30 length units from the origin passes.
*>
extern fn bool is_valid_world_transform(WorldTransform t) @cname("b3IsValidWorldTransform");
<*
 Whether all nine entries are finite. Not a test for a rotation: the zero matrix passes, and so
 does one whose entries are 1e30.
*>
extern fn bool is_valid_matrix3(Matrix3 a) @cname("b3IsValidMatrix3");
extern fn bool is_valid_aabb(Aabb a) @cname("b3IsValidAABB");
<*
 Two one-sided comparisons and nothing else: false when a lower bound falls under minus B3_HUGE or
 an upper bound rises over it, 1e5 length units so the reach moves with set_length_units_per_meter.
 It reads the two named fields and not where the box lies, so an inverted box is judged the same
 way — one whose lower is far positive and upper far negative passes, one whose lower is far
 negative does not — and a NaN passes because every comparison against one is false.
*>
extern fn bool is_bounded_aabb(Aabb a) @cname("b3IsBoundedAABB");
<*
 Whether the box is both valid and bounded, which is the whole of the test, so it carries nothing
 the two do not: an inverted box near the origin is bounded and not valid, a wide one the reverse.
*>
extern fn bool is_sane_aabb(Aabb a) @cname("b3IsSaneAABB");
extern fn bool is_valid_plane(Plane a) @cname("b3IsValidPlane");

alias AllocFn = fn void*(int size, int alignment);
alias FreeFn = fn void(void* mem);
alias AssertFn = fn int(ZString condition, ZString file_name, int line_number);
alias LogFn = fn void(ZString message);

struct Version {
    int major;
    int minor;
    int revision;
}

extern fn Version version() @cname("b3GetVersion");
extern fn bool is_double_precision() @cname("b3IsDoublePrecision");
extern fn int byte_count() @cname("b3GetByteCount");
extern fn void set_allocator(AllocFn alloc_fn, FreeFn free_fn) @cname("b3SetAllocator");
extern fn void set_assert_fn(AssertFn assert_fn) @cname("b3SetAssertFcn");
extern fn void set_log_fn(LogFn log_fn) @cname("b3SetLogFcn");
extern fn ulong ticks() @cname("b3GetTicks");
extern fn float milliseconds(ulong ticks) @cname("b3GetMilliseconds");
<*
 The milliseconds elapsed since the tick stamp, which it then advances to now. Consecutive calls
 measure the gap between calls, where milliseconds() reads from a stamp it leaves where it is.
*>
extern fn float milliseconds_and_reset(ulong* ticks) @cname("b3GetMillisecondsAndReset");
extern fn void yield() @cname("b3Yield");
extern fn void sleep(int milliseconds) @cname("b3Sleep");
extern fn float length_units_per_meter() @cname("b3GetLengthUnitsPerMeter");
extern fn void set_length_units_per_meter(float length_units) @cname("b3SetLengthUnitsPerMeter");
extern fn float stall_threshold() @cname("b3GetStallThreshold");
extern fn void set_stall_threshold(float seconds) @cname("b3SetStallThreshold");
<*
 Raw hash. Takes a pointer and a count where hash() takes a slice, so it is private to the module.
*>
extern fn uint hash_raw(uint seed, char* data, int count) @cname("b3Hash") @private;

<*
 A colour packed as 0xRRGGBB. Not an enum: box3d's b3HexColor names 145 constants, but the values
 a renderer is handed are not confined to them, box3d passing a shape's custom colour through
 unexamined and packing a debug material preset into the unused high byte.
*>
typedef HexColor = inline uint;

<*
 The number of constraint graph colours, mirroring B3_GRAPH_COLOR_COUNT in constants.h, which the
 C API does not expose as a function. The last of them is the overflow slot.
*>
const int GRAPH_COLOR_COUNT = 24;

<*
 Raw graph colour. Private because graph_color() refuses the out-of-range index box3d does no more
 than assert against before reading past its table.
*>
extern fn HexColor graph_color_raw(int index) @cname("b3GetGraphColor") @private;

<*
 Mixes two touching surfaces' frictions into the one the solver uses, in place of box3d's own
 sqrt(a * b). box3d may call it from a worker thread and hands it no context of the caller's, so it
 must not touch the world. It runs every step the pair's narrow phase finds them touching, and once
 per manifold point against a mesh or height field, where the answers are averaged — recycling,
 sleeping and mere nearness each suppress it, so the count is neither one per pair nor per step.
*>
alias FrictionFn = fn float(float friction_a, ulong user_material_id_a, float friction_b, ulong user_material_id_b);

<*
 Mixes two touching surfaces' restitutions, in place of box3d's own max(a, b). The threading,
 context and frequency rules are FrictionFn's, because box3d asks both from the same place: the
 line after a contact's manifold is recomputed.
*>
alias RestitutionFn = fn float(float restitution_a, ulong user_material_id_a, float restitution_b, ulong user_material_id_b);
alias TaskFn = fn void(void* task_context);
alias EnqueueTaskFn = fn void*(TaskFn task, void* task_context, void* user_context, ZString task_name);
alias FinishTaskFn = fn void(void* user_task, void* user_context);
alias CreateDebugShapeFn = fn void*(void* debug_shape, void* user_context);
alias DestroyDebugShapeFn = fn void(void* user_shape, void* user_context);

<*
 The number of worlds box3d can hold at once. Mirrors B3_MAX_WORLDS in constants.h, which the C API
 does not expose as a function.
*>
const int MAX_WORLDS = 128;

struct Capacity {
    int static_shape_count;
    int dynamic_shape_count;
    int static_body_count;
    int dynamic_body_count;
    int contact_count;
}

struct WorldDef {
    Vec3 gravity;
    float restitution_threshold;
    float hit_event_threshold;
    float contact_hertz;
    float contact_damping_ratio;
    float contact_speed;
    float maximum_linear_speed;
    FrictionFn friction_callback;
    RestitutionFn restitution_callback;
    bool enable_sleep;
    bool enable_continuous;
    uint worker_count;
    EnqueueTaskFn enqueue_task;
    FinishTaskFn finish_task;
    void* user_task_context;
    void* user_data;
    CreateDebugShapeFn create_debug_shape;
    DestroyDebugShapeFn destroy_debug_shape;
    void* user_debug_shape_context;
    Capacity capacity;
    int internal_value;
}

struct Profile {
    float step;
    float pairs;
    float collide;
    float solve;
    float solver_setup;
    float constraints;
    float prepare_constraints;
    float integrate_velocities;
    float warm_start;
    float solve_impulses;
    float integrate_positions;
    float relax_impulses;
    float apply_restitution;
    float store_impulses;
    float split_islands;
    float transforms;
    float sensor_hits;
    float joint_events;
    float hit_events;
    float refit;
    float bullets;
    float sleep_islands;
    float sensors;
}

struct Counters {
    int body_count;
    int shape_count;
    int contact_count;
    int joint_count;
    int island_count;
    int stack_used;
    int arena_capacity;
    int static_tree_height;
    int tree_height;
    int sat_call_count;
    int sat_cache_hit_count;
    int byte_count;
    int task_count;
    int[24] color_counts;
    int[8] manifold_counts;
    int awake_contact_count;
    int recycled_contact_count;
    int distance_iterations;
    int push_back_iterations;
    int root_iterations;
}

extern fn WorldDef default_world_def() @cname("b3DefaultWorldDef");

<*
 Raw world constructor. Bypasses create_world's definition-cookie guard, so it is private to the
 module — box3d_world.c3's create_world is the only caller and is the only public way to a live
 world.
*>
