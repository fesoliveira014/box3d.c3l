module b3;

import std::math::quaternion;

alias Vec3 = float[<3>];
alias Quat = Quaternionf;
alias Matrix3 = Vec3[3];

<*
 A world position. Distinct from Vec3 so a position is never silently used as a direction.
 box3d widens this to double in large-world mode, which this package does not build.
*>
typedef Pos = inline Vec3;

struct WorldId {
    ushort index1;
    ushort generation;
}

struct BodyId {
    int index1;
    ushort world0;
    ushort generation;
}

struct ShapeId {
    int index1;
    ushort world0;
    ushort generation;
}

struct JointId {
    int index1;
    ushort world0;
    ushort generation;
}

struct ContactId {
    int index1;
    ushort world0;
    short padding;
    uint generation;
}

struct Transform {
    Vec3 p;
    Quat q;
}

struct WorldTransform {
    Pos p;
    Quat q;
}

struct Aabb {
    Vec3 lower_bound;
    Vec3 upper_bound;
}

struct Plane {
    Vec3 normal;
    float offset;
}

struct CosSin {
    float cosine;
    float sine;
}

struct SegmentDistanceResult {
    Vec3 point1;
    float fraction1;
    Vec3 point2;
    float fraction2;
}

extern fn Vec3 point_to_segment_distance(Vec3 a, Vec3 b, Vec3 q) @cname("b3PointToSegmentDistance");
extern fn CosSin compute_cos_sin(float radians) @cname("b3ComputeCosSin");
extern fn SegmentDistanceResult segment_distance(Vec3 p1, Vec3 q1, Vec3 p2, Vec3 q2) @cname("b3SegmentDistance");
extern fn bool is_valid_vec3(Vec3 a) @cname("b3IsValidVec3");
extern fn bool is_valid_quat(Quat q) @cname("b3IsValidQuat");
extern fn bool is_valid_transform(Transform a) @cname("b3IsValidTransform");
extern fn bool is_valid_aabb(Aabb a) @cname("b3IsValidAABB");
extern fn bool is_valid_plane(Plane a) @cname("b3IsValidPlane");

alias AllocFn = fn void*(int size, int alignment);
alias FreeFn = fn void(void* mem);
alias AssertFn = fn int(ZString condition, ZString file_name, int line_number);
alias LogFn = fn void(ZString message);

struct Version {
    int major;
    int minor;
    int revision;
}

extern fn Version version() @cname("b3GetVersion");
extern fn bool is_double_precision() @cname("b3IsDoublePrecision");
extern fn int byte_count() @cname("b3GetByteCount");
extern fn void set_allocator(AllocFn alloc_fn, FreeFn free_fn) @cname("b3SetAllocator");
extern fn void set_assert_fn(AssertFn assert_fn) @cname("b3SetAssertFcn");
extern fn void set_log_fn(LogFn log_fn) @cname("b3SetLogFcn");
extern fn ulong ticks() @cname("b3GetTicks");
extern fn float milliseconds(ulong ticks) @cname("b3GetMilliseconds");
extern fn void yield() @cname("b3Yield");
extern fn void sleep(int milliseconds) @cname("b3Sleep");
extern fn float length_units_per_meter() @cname("b3GetLengthUnitsPerMeter");
extern fn void set_length_units_per_meter(float length_units) @cname("b3SetLengthUnitsPerMeter");
extern fn float stall_threshold() @cname("b3GetStallThreshold");
extern fn void set_stall_threshold(float seconds) @cname("b3SetStallThreshold");
<*
 Raw hash. Takes a pointer and a count where hash() takes a slice, so it is private to the module.
*>
extern fn uint hash_raw(uint seed, char* data, int count) @cname("b3Hash") @private;

alias FrictionFn = fn float(float friction_a, ulong user_material_id_a, float friction_b, ulong user_material_id_b);
alias RestitutionFn = fn float(float restitution_a, ulong user_material_id_a, float restitution_b, ulong user_material_id_b);
alias TaskFn = fn void(void* task_context);
alias EnqueueTaskFn = fn void*(TaskFn task, void* task_context, void* user_context, ZString task_name);
alias FinishTaskFn = fn void(void* user_task, void* user_context);
alias CreateDebugShapeFn = fn void*(void* debug_shape, void* user_context);
alias DestroyDebugShapeFn = fn void(void* user_shape, void* user_context);

<*
 The number of worlds box3d can hold at once. Mirrors B3_MAX_WORLDS in constants.h, which the C API
 does not expose as a function.
*>
const int MAX_WORLDS = 128;

struct Capacity {
    int static_shape_count;
    int dynamic_shape_count;
    int static_body_count;
    int dynamic_body_count;
    int contact_count;
}

struct WorldDef {
    Vec3 gravity;
    float restitution_threshold;
    float hit_event_threshold;
    float contact_hertz;
    float contact_damping_ratio;
    float contact_speed;
    float maximum_linear_speed;
    FrictionFn friction_callback;
    RestitutionFn restitution_callback;
    bool enable_sleep;
    bool enable_continuous;
    uint worker_count;
    EnqueueTaskFn enqueue_task;
    FinishTaskFn finish_task;
    void* user_task_context;
    void* user_data;
    CreateDebugShapeFn create_debug_shape;
    DestroyDebugShapeFn destroy_debug_shape;
    void* user_debug_shape_context;
    Capacity capacity;
    int internal_value;
}

struct Profile {
    float step;
    float pairs;
    float collide;
    float solve;
    float solver_setup;
    float constraints;
    float prepare_constraints;
    float integrate_velocities;
    float warm_start;
    float solve_impulses;
    float integrate_positions;
    float relax_impulses;
    float apply_restitution;
    float store_impulses;
    float split_islands;
    float transforms;
    float sensor_hits;
    float joint_events;
    float hit_events;
    float refit;
    float bullets;
    float sleep_islands;
    float sensors;
}

struct Counters {
    int body_count;
    int shape_count;
    int contact_count;
    int joint_count;
    int island_count;
    int stack_used;
    int arena_capacity;
    int static_tree_height;
    int tree_height;
    int sat_call_count;
    int sat_cache_hit_count;
    int byte_count;
    int task_count;
    int[24] color_counts;
    int[8] manifold_counts;
    int awake_contact_count;
    int recycled_contact_count;
    int distance_iterations;
    int push_back_iterations;
    int root_iterations;
}

extern fn WorldDef default_world_def() @cname("b3DefaultWorldDef");

<*
 Raw world constructor. Bypasses create_world's definition-cookie guard, so it is private to the
 module — box3d_world.c3's create_world is the only caller and is the only public way to a live
 world.
*>
extern fn WorldId create_world_raw(WorldDef* def) @cname("b3CreateWorld") @private;
extern fn void WorldId.destroy(self) @cname("b3DestroyWorld");
extern fn void WorldId.step(self, float time_step, int sub_step_count) @cname("b3World_Step");
extern fn bool WorldId.is_valid(self) @cname("b3World_IsValid");
extern fn int world_count() @cname("b3GetWorldCount");

<*
 The high-water mark of worlds that have existed at once since the process started — not a limit.
 `MAX_WORLDS` is the actual ceiling box3d enforces; this can read anywhere at or below it and never
 tells a caller how many more worlds they are allowed to create.
*>
extern fn int max_world_count() @cname("b3GetMaxWorldCount");

extern fn Vec3 WorldId.gravity(self) @cname("b3World_GetGravity");
extern fn void WorldId.set_gravity(self, Vec3 gravity) @cname("b3World_SetGravity");
extern fn float WorldId.restitution_threshold(self) @cname("b3World_GetRestitutionThreshold");
extern fn void WorldId.set_restitution_threshold(self, float value) @cname("b3World_SetRestitutionThreshold");
extern fn float WorldId.hit_event_threshold(self) @cname("b3World_GetHitEventThreshold");
extern fn void WorldId.set_hit_event_threshold(self, float value) @cname("b3World_SetHitEventThreshold");
extern fn float WorldId.maximum_linear_speed(self) @cname("b3World_GetMaximumLinearSpeed");
extern fn void WorldId.set_maximum_linear_speed(self, float maximum_linear_speed) @cname("b3World_SetMaximumLinearSpeed");
extern fn float WorldId.contact_recycle_distance(self) @cname("b3World_GetContactRecycleDistance");
extern fn void WorldId.set_contact_recycle_distance(self, float recycle_distance) @cname("b3World_SetContactRecycleDistance");
extern fn void WorldId.set_contact_tuning(self, float hertz, float damping_ratio, float contact_speed) @cname("b3World_SetContactTuning");
extern fn void WorldId.enable_sleeping(self, bool flag) @cname("b3World_EnableSleeping");
extern fn bool WorldId.is_sleeping_enabled(self) @cname("b3World_IsSleepingEnabled");
extern fn void WorldId.enable_continuous(self, bool flag) @cname("b3World_EnableContinuous");
extern fn bool WorldId.is_continuous_enabled(self) @cname("b3World_IsContinuousEnabled");
extern fn void WorldId.enable_warm_starting(self, bool flag) @cname("b3World_EnableWarmStarting");
extern fn bool WorldId.is_warm_starting_enabled(self) @cname("b3World_IsWarmStartingEnabled");
extern fn void WorldId.enable_speculative(self, bool flag) @cname("b3World_EnableSpeculative");
extern fn int WorldId.worker_count(self) @cname("b3World_GetWorkerCount");
extern fn void WorldId.set_worker_count(self, int count) @cname("b3World_SetWorkerCount");
extern fn int WorldId.awake_body_count(self) @cname("b3World_GetAwakeBodyCount");
extern fn Profile WorldId.profile(self) @cname("b3World_GetProfile");
extern fn Counters WorldId.counters(self) @cname("b3World_GetCounters");
extern fn Capacity WorldId.max_capacity(self) @cname("b3World_GetMaxCapacity");
extern fn Aabb WorldId.bounds(self) @cname("b3World_GetBounds");
extern fn void* WorldId.user_data(self) @cname("b3World_GetUserData");
extern fn void WorldId.set_user_data(self, void* user_data) @cname("b3World_SetUserData");
extern fn void WorldId.rebuild_static_tree(self) @cname("b3World_RebuildStaticTree");

enum BodyType : int {
    STATIC,
    KINEMATIC,
    DYNAMIC,
}

struct MotionLocks {
    bool linear_x;
    bool linear_y;
    bool linear_z;
    bool angular_x;
    bool angular_y;
    bool angular_z;
}

struct MassData {
    float mass;
    Vec3 center;
    Matrix3 inertia;
}

<*
 A body definition. Must come from default_body_def() — see create_body.
*>
struct BodyDef {
    BodyType type;
    Pos position;
    Quat rotation;
    Vec3 linear_velocity;
    Vec3 angular_velocity;
    float linear_damping;
    float angular_damping;
    float gravity_scale;
    float sleep_threshold;
    ZString name;
    void* user_data;
    MotionLocks motion_locks;
    bool enable_sleep;
    bool is_awake;
    bool is_bullet;
    bool is_enabled;
    bool allow_fast_rotation;
    bool enable_contact_recycling;
    int internal_value;
}

extern fn BodyDef default_body_def() @cname("b3DefaultBodyDef");

<*
 Raw body constructor. Bypasses WorldId.create_body's definition-cookie guard, so it is private
 to the module — box3d_body.c3's WorldId.create_body is the only caller and is the only public
 way to a live body.
*>
