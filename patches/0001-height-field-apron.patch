--- a/src/mesh_contact.c
+++ b/src/mesh_contact.c
@@ -522,6 +522,90 @@ typedef struct b3Cluster
 	int pointCount;
 } b3Cluster;
 
+// Is the edge between two height field vertices on the outer border of the grid?
+static bool b3IsHeightFieldBorderEdge( const b3HeightFieldData* heightField, int index1, int index2 )
+{
+	int columnCount = heightField->columnCount;
+	int rowCount = heightField->rowCount;
+	int row1 = index1 / columnCount;
+	int row2 = index2 / columnCount;
+	int column1 = index1 - row1 * columnCount;
+	int column2 = index2 - row2 * columnCount;
+
+	bool alongRow = row1 == row2 && ( row1 == 0 || row1 == rowCount - 1 );
+	bool alongColumn = column1 == column2 && ( column1 == 0 || column1 == columnCount - 1 );
+	return alongRow || alongColumn;
+}
+
+// A border edge is only ever flagged flat when the height field was created with an apron on that
+// side, so the surface continues past it. A sphere edge or vertex contact there is a ghost of the
+// neighbouring height field, which makes its own contact with the sphere.
+static bool b3IsApronFeature( const b3HeightFieldData* heightField, const b3LocalManifold* manifold )
+{
+	int flags = manifold->triangleFlags;
+	bool isBorder[3] = {
+		b3IsHeightFieldBorderEdge( heightField, manifold->i1, manifold->i2 ),
+		b3IsHeightFieldBorderEdge( heightField, manifold->i2, manifold->i3 ),
+		b3IsHeightFieldBorderEdge( heightField, manifold->i3, manifold->i1 ),
+	};
+	bool isFlat[3] = {
+		( flags & b3_flatEdge1 ) == b3_flatEdge1,
+		( flags & b3_flatEdge2 ) == b3_flatEdge2,
+		( flags & b3_flatEdge3 ) == b3_flatEdge3,
+	};
+
+	// The two triangle edges that meet at each vertex
+	int edgeA = 0;
+	int edgeB = 0;
+	switch ( manifold->feature )
+	{
+		case b3_featureEdge1:
+			return isBorder[0] && isFlat[0];
+
+		case b3_featureEdge2:
+			return isBorder[1] && isFlat[1];
+
+		case b3_featureEdge3:
+			return isBorder[2] && isFlat[2];
+
+		case b3_featureVertex1:
+			edgeA = 0;
+			edgeB = 2;
+			break;
+
+		case b3_featureVertex2:
+			edgeA = 0;
+			edgeB = 1;
+			break;
+
+		case b3_featureVertex3:
+			edgeA = 1;
+			edgeB = 2;
+			break;
+
+		default:
+			return false;
+	}
+
+	// A vertex qualifies when it meets the border and every border edge there is flat
+	bool meetsBorder = isBorder[edgeA] || isBorder[edgeB];
+	bool borderIsFlat = ( isBorder[edgeA] == false || isFlat[edgeA] ) && ( isBorder[edgeB] == false || isFlat[edgeB] );
+	return meetsBorder && borderIsFlat;
+}
+
+// Replace a sphere edge or vertex manifold with the contact against the plane of its triangle. The
+// point is half way between the sphere and the plane, as in b3CollideTriangleAndSphere, so the
+// contact matches the one the neighbouring height field makes with its own face.
+static void b3SnapSphereManifoldToTriangleFace( b3LocalManifold* manifold, b3Vec3 vertex, const b3Sphere* sphere )
+{
+	b3Vec3 normal = manifold->triangleNormal;
+	float distance = b3Dot( b3Sub( sphere->center, vertex ), normal );
+
+	manifold->normal = normal;
+	manifold->points[0].point = b3MulSub( sphere->center, 0.5f * ( sphere->radius + distance ), normal );
+	manifold->points[0].separation = distance - sphere->radius;
+}
