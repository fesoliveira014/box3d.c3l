+
+	/// A mask of b3HeightFieldApronSides. Each set bit marks a side of the grid that touches another
+	/// height field placed next to this one. Zero means the grid stands alone.
+	/// An apron is a ring of samples from the neighbouring height field. It is only read while the
+	/// height field is created, to compute the edge flags of the cells along that side as if the
+	/// two fields were one surface. The apron is not stored, so the height field data, its bounds and
+	/// its hash are the same as without it. Sides whose bit is clear are padded but not read.
+	/// Apron samples are quantized like every other sample, so they must be given in the same
+	/// global minimum and maximum height as the neighbour. A neighbour cell that is a hole leaves
+	/// the shared edge open. A height field loaded or dumped through b3LoadHeightField and
+	/// b3DumpHeightData does not keep its apron.
+	uint8_t apronSides;
 } b3HeightFieldDef;
 
+/// The sides of a height field grid that can carry an apron. These are bits of b3HeightFieldDef::apronSides.
+typedef enum b3HeightFieldApronSides
+{
+	/// The side at column 0.
+	b3_apronNegativeX = 0x01,
+
+	/// The side at the last column.
+	b3_apronPositiveX = 0x02,
+
+	/// The side at row 0.
+	b3_apronNegativeZ = 0x04,
+
+	/// The side at the last row.
+	b3_apronPositiveZ = 0x08,
+} b3HeightFieldApronSides;
+
 /// This material index is used to designate holes in a height field.
 #define B3_HEIGHT_FIELD_HOLE 0xFF
 
