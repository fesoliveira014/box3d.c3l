+void b3DynamicTree_RecomputeInternalBounds( b3DynamicTree* tree )
+{
+	b3TreeNode* nodes = tree->nodes;
+	const int32_t* parents = tree->parents;
+
+	// Empty nodes pass as leaves, so this resets exactly the internal nodes.
+	b3AABB emptyBox = { { FLT_MAX, FLT_MAX, FLT_MAX }, { -FLT_MAX, -FLT_MAX, -FLT_MAX } };
+	for ( int index = 0; index < tree->nodeEnd; ++index )
+	{
+		if ( b3IsLeaf( nodes + index ) == false )
+		{
+			nodes[index].aabb = emptyBox;
+		}
+	}
+
+	// Each internal node is the union of the leaves enlarged into it so far, so a node that already
+	// holds a leaf box has ancestors that hold it too and the walk can stop there. The result is
+	// the exact union whatever the leaf order.
+	for ( int proxyId = 0; proxyId < tree->proxyCapacity; ++proxyId )
+	{
+		int leaf = tree->proxies[proxyId].node;
+		if ( leaf == B3_NULL_INDEX )
+		{
+			continue;
+		}
+
+		b3AABB box = nodes[leaf].aabb;
+		int index = parents[leaf];
+		while ( index != B3_NULL_INDEX )
+		{
+			if ( b3EnlargeAABB( &nodes[index].aabb, box ) == false )
+			{
+				break;
+			}
+			index = parents[index];
+		}
+	}
+}
