+static b3Pos b3ShiftPos( b3Pos p, b3Pos origin )
+{
+	p.x -= origin.x;
+	p.y -= origin.y;
+	p.z -= origin.z;
+	return p;
+}
+
+// x - origin rounded toward negative infinity, so a shifted lower bound never moves inward.
+static float b3ShiftDownFloat( float x, double origin )
+{
+	double d = (double)x - origin;
+	float f = (float)d;
+	return (double)f > d ? nextafterf( f, -FLT_MAX ) : f;
+}
+
+// x - origin rounded toward positive infinity, so a shifted upper bound never moves inward.
+static float b3ShiftUpFloat( float x, double origin )
+{
+	double d = (double)x - origin;
+	float f = (float)d;
+	return (double)f < d ? nextafterf( f, FLT_MAX ) : f;
+}
+
+static b3AABB b3ShiftAABB( b3AABB box, b3Pos origin )
+{
+	b3AABB out;
+	out.lowerBound.x = b3ShiftDownFloat( box.lowerBound.x, origin.x );
+	out.lowerBound.y = b3ShiftDownFloat( box.lowerBound.y, origin.y );
+	out.lowerBound.z = b3ShiftDownFloat( box.lowerBound.z, origin.z );
+	out.upperBound.x = b3ShiftUpFloat( box.upperBound.x, origin.x );
+	out.upperBound.y = b3ShiftUpFloat( box.upperBound.y, origin.y );
+	out.upperBound.z = b3ShiftUpFloat( box.upperBound.z, origin.z );
+	return out;
+}
+
+void b3World_ShiftOrigin( b3WorldId worldId, b3Pos newOrigin )
+{
+	b3World* world = b3GetUnlockedWorldFromId( worldId );
+	if ( world == NULL )
+	{
+		return;
+	}
+
+	B3_ASSERT( b3IsValidPosition( newOrigin ) );
+	if ( b3IsValidPosition( newOrigin ) == false )
+	{
+		return;
+	}
+
+	B3_REC( world, WorldShiftOrigin, worldId, newOrigin );
+
+	// Every solver set holds body sims: static, disabled, awake and one per sleeping island. The
+	// body states hold velocities and deltas only, which do not depend on the origin.
+	int setCount = world->solverSets.count;
+	for ( int setIndex = 0; setIndex < setCount; ++setIndex )
+	{
+		b3SolverSet* set = world->solverSets.data + setIndex;
+		if ( set->setIndex == B3_NULL_INDEX )
+		{
+			continue;
+		}
+
+		for ( int i = 0; i < set->bodySims.count; ++i )
+		{
+			b3BodySim* sim = set->bodySims.data + i;
+			sim->transform.p = b3ShiftPos( sim->transform.p, newOrigin );
+			sim->center = b3ShiftPos( sim->center, newOrigin );
+			sim->center0 = b3ShiftPos( sim->center0, newOrigin );
+		}
+	}
+
+	// The tight box is recomputed at the shifted transform, as a step would compute it. The fat box
+	// is shifted with outward rounding, and grown to the tight box if rounding left it outside. The
+	// leaf of the proxy takes the fat box, as it always holds between steps. No proxy is marked as
+	// moved, so the shift creates no pairs and rebuilds no tree.
+	b3BroadPhase* broadPhase = &world->broadPhase;
+	for ( int shapeId = 0; shapeId < world->shapes.count; ++shapeId )
+	{
+		b3Shape* shape = world->shapes.data + shapeId;
+		if ( shape->id == B3_NULL_INDEX )
+		{
+			continue;
+		}
+
+		b3Body* body = b3Array_Get( world->bodies, shape->bodyId );
+		b3BodySim* bodySim = b3GetBodySim( world, body );
+		b3AABB aabb = b3ComputeFatShapeAABB( shape, bodySim->transform, B3_SPECULATIVE_DISTANCE );
+		shape->aabb = aabb;
+
+		b3AABB fatAABB = b3ShiftAABB( world->fatAABBs.data[shapeId], newOrigin );
+		b3EnlargeAABB( &fatAABB, aabb );
+		world->fatAABBs.data[shapeId] = fatAABB;
+
+		if ( shape->proxyKey != B3_NULL_INDEX )
+		{
+			b3DynamicTree* tree = broadPhase->trees + B3_PROXY_TYPE( shape->proxyKey );
+			int nodeIndex = tree->proxies[B3_PROXY_ID( shape->proxyKey )].node;
+			tree->nodes[nodeIndex].aabb = fatAABB;
+		}
+	}
+
+	for ( int treeIndex = 0; treeIndex < b3_bodyTypeCount; ++treeIndex )
+	{
+		b3DynamicTree_RecomputeInternalBounds( broadPhase->trees + treeIndex );
+	}
+
+	// A mesh contact caches the triangles under a world space query box. An empty box makes its
+	// next update query the triangles again, which keeps the caches of the triangles it finds.
+	b3AABB emptyBox = { { FLT_MAX, FLT_MAX, FLT_MAX }, { -FLT_MAX, -FLT_MAX, -FLT_MAX } };
+	for ( int contactIndex = 0; contactIndex < world->contacts.count; ++contactIndex )
+	{
+		b3Contact* contact = world->contacts.data + contactIndex;
+		if ( contact->contactId == B3_NULL_INDEX || ( contact->flags & b3_simMeshContact ) == 0 )
+		{
+			continue;
+		}
+
+		contact->meshContact.queryBounds = emptyBox;
+	}
+
+	for ( int i = 0; i < world->bodyMoveEvents.count; ++i )
+	{
+		b3BodyMoveEvent* event = world->bodyMoveEvents.data + i;
+		event->transform.p = b3ShiftPos( event->transform.p, newOrigin );
+	}
+
+	for ( int i = 0; i < world->contactHitEvents.count; ++i )
+	{
+		b3ContactHitEvent* event = world->contactHitEvents.data + i;
+		event->point = b3ShiftPos( event->point, newOrigin );
+	}
+
+	b3ValidateSolverSets( world );
+	b3ValidateBroadPhase( broadPhase );
+}
