 	else
diff --git a/src/physics_world.c b/src/physics_world.c
index 0a77e19..c71b675 100644
--- a/src/physics_world.c
+++ b/src/physics_world.c
@@ -3436,6 +3436,47 @@ void b3World_SetPreSolveCallback( b3WorldId worldId, b3PreSolveFcn* fcn, void* c
 	world->preSolveContext = context;
 }
 
+// A recycled contact skips the narrow phase and keeps its material, and a resting contact is
+// recycled on every step, so a change of materials reaches it only through a full update.
+static void b3InvalidateAllContactMaterials( b3World* world )
+{
+	for ( int contactIndex = 0; contactIndex < world->contacts.count; ++contactIndex )
+	{
+		b3Contact* contact = world->contacts.data + contactIndex;
+		if ( contact->contactId != B3_NULL_INDEX )
+		{
+			contact->flags &= ~b3_relativeTransformValid;
+		}
+	}
+}
+
+void b3World_SetContactMaterialCallback( b3WorldId worldId, b3ContactMaterialFcn* fcn, void* context )
+{
+	b3World* world = b3GetUnlockedWorldFromId( worldId );
+	if ( world == NULL )
+	{
+		return;
+	}
+	world->contactMaterialFcn = fcn;
+	world->contactMaterialContext = context;
+
+	// The callback is not recorded, but the invalidation changes the simulation, so it is.
+	B3_REC( world, WorldInvalidateContactMaterials, worldId );
+	b3InvalidateAllContactMaterials( world );
+}
+
+void b3World_InvalidateContactMaterials( b3WorldId worldId )
+{
+	b3World* world = b3GetUnlockedWorldFromId( worldId );
+	if ( world == NULL )
+	{
+		return;
+	}
+
+	B3_REC( world, WorldInvalidateContactMaterials, worldId );
+	b3InvalidateAllContactMaterials( world );
+}
