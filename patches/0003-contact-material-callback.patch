diff --git a/src/shape.c b/src/shape.c
index 7b21700..4845f7a 100644
--- a/src/shape.c
+++ b/src/shape.c
@@ -1492,6 +1492,34 @@ void b3Shape_EnablePreSolveEvents( b3ShapeId shapeId, bool flag )
 	shape->flags = flag ? shape->flags | b3_enablePreSolveEvents : shape->flags & ~b3_enablePreSolveEvents;
 }
 
+void b3Shape_InvalidateContactMaterials( b3ShapeId shapeId )
+{
+	b3World* world = b3GetUnlockedWorld( shapeId.world0 );
+	if ( world == NULL )
+	{
+		return;
+	}
+
+	B3_REC( world, ShapeInvalidateContactMaterials, shapeId );
+
+	b3Shape* shape = b3GetShape( world, shapeId );
+	b3Body* body = b3Array_Get( world->bodies, shape->bodyId );
+
+	// A recycled contact skips the narrow phase and keeps its material; see b3World_InvalidateContactMaterials.
+	int edgeKey = body->headContactKey;
+	while ( edgeKey != B3_NULL_INDEX )
+	{
+		int contactId = edgeKey >> 1;
+		int edgeIndex = edgeKey & 1;
+		b3Contact* contact = b3Array_Get( world->contacts, contactId );
+		if ( contact->shapeIdA == shape->id || contact->shapeIdB == shape->id )
+		{
+			contact->flags &= ~b3_relativeTransformValid;
+		}
+		edgeKey = contact->edges[edgeIndex].nextKey;
+	}
+}
