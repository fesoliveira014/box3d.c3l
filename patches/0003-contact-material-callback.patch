+/// The material inputs the contact solver reads for one contact.
+/// @see b3ContactMaterialFcn
+/// @ingroup world
+typedef struct b3ContactMaterial
+{
+	/// The Coulomb friction coefficient, usually in the range [0,1].
+	float friction;
+
+	/// The coefficient of restitution (bounce), usually in the range [0,1].
+	float restitution;
+
+	/// The rolling resistance, already scaled by the radius of the rolling shape.
+	float rollingResistance;
+
+	/// The relative surface velocity in world space, for conveyor belts: the solver drives the
+	/// tangential part of the velocity of body B relative to body A at the contact toward this.
+	/// The mixed value is the surface velocity of shape A minus that of shape B.
+	b3Vec3 tangentVelocity;
+} b3ContactMaterial;
+
+/// Prototype for a contact material callback.
+/// This is called after a touching contact is updated, before it goes to the solver. The material
+/// holds the values mixed from the two shapes' surface materials by the friction and restitution
+/// callbacks. Change any of them to override the material of this contact for this update.
+/// Notes:
+/// - this function must be thread-safe, it is called from the worker threads of the step
+/// - this is called for every touching contact the narrow phase updates, not for contacts that
+///   are recycled, sleeping or not touching, which keep the last material written to them
+/// - a resting contact is recycled on every step, so it keeps its material for as long as it
+///   rests: setting the callback updates every contact once, and when the answers change later
+///   call b3World_InvalidateContactMaterials or b3Shape_InvalidateContactMaterials
+/// - there is no child index or triangle: on a multi-material mesh, height field or compound the
+///   material holds the contact's averaged mix
+/// - a negative or non-finite friction, restitution or rolling resistance, or a non-finite
+///   tangent velocity, is ignored and the mixed value is kept
+/// - the callback is not recorded, like the pre-solve callback, so a replay of a world that uses
+///   it diverges
+/// - the context pointer is stored in the world and passed to every call
+/// @warning Do not attempt to read or modify the world inside this callback
+/// @ingroup world
+typedef void b3ContactMaterialFcn( b3ShapeId shapeIdA, b3ShapeId shapeIdB, b3ContactMaterial* material, void* context );
+
 /// Prototype callback for overlap queries.
 /// Called for each shape found in the query.
 /// @see b3World_OverlapAABB
diff --git a/src/contact.c b/src/contact.c
index d200301..67b62f1 100644
--- a/src/contact.c
+++ b/src/contact.c
@@ -731,6 +731,45 @@ static bool b3UpdateConvexContact( b3World* world, int workerIndex, b3Contact* c
 	return true;
 }
 
+// Lets the application override the mixed material of a touching contact. Runs on a worker thread
+// and writes only to this contact, so the result does not depend on the thread or the order.
+static void b3ApplyContactMaterial( b3World* world, b3Contact* contact, const b3Shape* shapeA, const b3Shape* shapeB )
+{
+	b3ShapeId shapeIdA = { shapeA->id + 1, world->worldId, shapeA->generation };
+	b3ShapeId shapeIdB = { shapeB->id + 1, world->worldId, shapeB->generation };
+
+	b3ContactMaterial material = {
+		.friction = contact->friction,
+		.restitution = contact->restitution,
+		.rollingResistance = contact->rollingResistance,
+		.tangentVelocity = contact->tangentVelocity,
+	};
+
+	// this call assumes thread safety
+	world->contactMaterialFcn( shapeIdA, shapeIdB, &material, world->contactMaterialContext );
+
+	// A value the solver cannot use keeps the mixed one
+	if ( b3IsValidFloat( material.friction ) && material.friction >= 0.0f )
+	{
+		contact->friction = material.friction;
+	}
+
+	if ( b3IsValidFloat( material.restitution ) && material.restitution >= 0.0f )
+	{
+		contact->restitution = material.restitution;
+	}
+
+	if ( b3IsValidFloat( material.rollingResistance ) && material.rollingResistance >= 0.0f )
+	{
+		contact->rollingResistance = material.rollingResistance;
+	}
+
+	if ( b3IsValidVec3( material.tangentVelocity ) )
+	{
+		contact->tangentVelocity = material.tangentVelocity;
+	}
+}
