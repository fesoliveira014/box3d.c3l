diff --git a/include/box3d/types.h b/include/box3d/types.h
index 11678e5..5e27bb6 100644
--- a/include/box3d/types.h
+++ b/include/box3d/types.h
@@ -96,6 +96,48 @@ typedef bool b3CustomFilterFcn( b3ShapeId shapeIdA, b3ShapeId shapeIdB, void* co
 typedef bool b3PreSolveFcn( b3ShapeId shapeIdA, b3ShapeId shapeIdB, b3Pos point, b3Vec3 normal,
