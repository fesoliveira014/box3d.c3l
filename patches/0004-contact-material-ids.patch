@@ -114,6 +114,13 @@ typedef struct b3ContactMaterial
 	/// tangential part of the velocity of body B relative to body A at the contact toward this.
 	/// The mixed value is the surface velocity of shape A minus that of shape B.
 	b3Vec3 tangentVelocity;
+
+	/// Input only: the user material id of the surface material that shape A touches with at this
+	/// contact (b3SurfaceMaterial::userMaterialId). A write is ignored.
+	uint64_t userMaterialIdA;
+
+	/// Input only: the same for shape B. A write is ignored.
+	uint64_t userMaterialIdB;
 } b3ContactMaterial;
 
