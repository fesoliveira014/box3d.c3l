module b3;

enum BodyType : int {
    STATIC,
    KINEMATIC,
    DYNAMIC,
}

struct MotionLocks {
    bool linear_x;
    bool linear_y;
    bool linear_z;
    bool angular_x;
    bool angular_y;
    bool angular_z;
}

struct MassData {
    float mass;
    Vec3 center;
    Matrix3 inertia;
}

<*
 A body definition. Must come from default_body_def() — see create_body.
*>
struct BodyDef {
    BodyType type;
    Pos position;
    Quat rotation;
    Vec3 linear_velocity;
    Vec3 angular_velocity;
    float linear_damping;
    float angular_damping;
    float gravity_scale;
    float sleep_threshold;
    ZString name;
    void* user_data;
    MotionLocks motion_locks;
    bool enable_sleep;
    bool is_awake;
    bool is_bullet;
    bool is_enabled;
    bool allow_fast_rotation;
    bool enable_contact_recycling;
    int internal_value;
}

extern fn BodyDef default_body_def() @cname("b3DefaultBodyDef");

<*
 Raw body constructor. Bypasses create_body's definition-cookie guard, so it is private
 to the module — src/body.c3's create_body is the only caller and is the only public
 way to a live body.
*>
extern fn BodyId create_body_raw(WorldId world_id, BodyDef* def) @cname("b3CreateBody") @private;
extern fn void destroy_body(BodyId body) @cname("b3DestroyBody");
extern fn bool BodyId.is_valid(self) @cname("b3Body_IsValid");
extern fn BodyType BodyId.type(self) @cname("b3Body_GetType");
extern fn void BodyId.set_type(self, BodyType type) @cname("b3Body_SetType");
extern fn WorldId BodyId.world(self) @cname("b3Body_GetWorld");
extern fn bool BodyId.is_enabled(self) @cname("b3Body_IsEnabled");
extern fn void body_disable(BodyId body) @cname("b3Body_Disable");
extern fn void body_enable(BodyId body) @cname("b3Body_Enable");

extern fn Pos BodyId.position(self) @cname("b3Body_GetPosition");
extern fn Quat BodyId.rotation(self) @cname("b3Body_GetRotation");
extern fn WorldTransform BodyId.transform(self) @cname("b3Body_GetTransform");
extern fn void BodyId.set_transform(self, Pos position, Quat rotation) @cname("b3Body_SetTransform");
extern fn void BodyId.set_target_transform(self, WorldTransform target, float time_step, bool wake) @cname("b3Body_SetTargetTransform");
extern fn Vec3 BodyId.local_point(self, Pos world_point) @cname("b3Body_GetLocalPoint");
extern fn Pos BodyId.world_point(self, Vec3 local_point) @cname("b3Body_GetWorldPoint");
extern fn Vec3 BodyId.local_vector(self, Vec3 world_vector) @cname("b3Body_GetLocalVector");
extern fn Vec3 BodyId.world_vector(self, Vec3 local_vector) @cname("b3Body_GetWorldVector");
extern fn Vec3 BodyId.linear_velocity(self) @cname("b3Body_GetLinearVelocity");
extern fn void BodyId.set_linear_velocity(self, Vec3 linear_velocity) @cname("b3Body_SetLinearVelocity");
extern fn Vec3 BodyId.angular_velocity(self) @cname("b3Body_GetAngularVelocity");
extern fn void BodyId.set_angular_velocity(self, Vec3 angular_velocity) @cname("b3Body_SetAngularVelocity");
extern fn Vec3 BodyId.local_point_velocity(self, Vec3 local_point) @cname("b3Body_GetLocalPointVelocity");
extern fn Vec3 BodyId.world_point_velocity(self, Pos world_point) @cname("b3Body_GetWorldPointVelocity");
extern fn void body_apply_force(BodyId body, Vec3 force, Pos point, bool wake) @cname("b3Body_ApplyForce");
extern fn void body_apply_force_to_center(BodyId body, Vec3 force, bool wake) @cname("b3Body_ApplyForceToCenter");
extern fn void body_apply_torque(BodyId body, Vec3 torque, bool wake) @cname("b3Body_ApplyTorque");
extern fn void body_apply_linear_impulse(BodyId body, Vec3 impulse, Pos point, bool wake) @cname("b3Body_ApplyLinearImpulse");
extern fn void body_apply_linear_impulse_to_center(BodyId body, Vec3 impulse, bool wake) @cname("b3Body_ApplyLinearImpulseToCenter");
extern fn void body_apply_angular_impulse(BodyId body, Vec3 impulse, bool wake) @cname("b3Body_ApplyAngularImpulse");
extern fn float BodyId.mass(self) @cname("b3Body_GetMass");
extern fn float BodyId.inverse_mass(self) @cname("b3Body_GetInverseMass");
extern fn Matrix3 BodyId.local_rotational_inertia(self) @cname("b3Body_GetLocalRotationalInertia");
extern fn Matrix3 BodyId.world_inverse_rotational_inertia(self) @cname("b3Body_GetWorldInverseRotationalInertia");
extern fn Vec3 BodyId.local_center(self) @cname("b3Body_GetLocalCenter");
extern fn Pos BodyId.world_center(self) @cname("b3Body_GetWorldCenter");
extern fn void BodyId.set_mass_data(self, MassData mass_data) @cname("b3Body_SetMassData");
extern fn MassData BodyId.mass_data(self) @cname("b3Body_GetMassData");
extern fn void body_apply_mass_from_shapes(BodyId body) @cname("b3Body_ApplyMassFromShapes");
extern fn void BodyId.set_linear_damping(self, float linear_damping) @cname("b3Body_SetLinearDamping");
extern fn float BodyId.linear_damping(self) @cname("b3Body_GetLinearDamping");
extern fn void BodyId.set_angular_damping(self, float angular_damping) @cname("b3Body_SetAngularDamping");
extern fn float BodyId.angular_damping(self) @cname("b3Body_GetAngularDamping");
extern fn void BodyId.set_gravity_scale(self, float gravity_scale) @cname("b3Body_SetGravityScale");
extern fn float BodyId.gravity_scale(self) @cname("b3Body_GetGravityScale");
extern fn Aabb BodyId.compute_aabb(self) @cname("b3Body_ComputeAABB");

extern fn void BodyId.set_name(self, ZString name) @cname("b3Body_SetName");
extern fn ZString BodyId.name(self) @cname("b3Body_GetName");
extern fn void BodyId.set_user_data(self, void* user_data) @cname("b3Body_SetUserData");
extern fn void* BodyId.user_data(self) @cname("b3Body_GetUserData");
extern fn bool BodyId.is_awake(self) @cname("b3Body_IsAwake");
extern fn void BodyId.set_awake(self, bool awake) @cname("b3Body_SetAwake");
extern fn void BodyId.enable_sleep(self, bool enable_sleep) @cname("b3Body_EnableSleep");
extern fn bool BodyId.is_sleep_enabled(self) @cname("b3Body_IsSleepEnabled");
extern fn void BodyId.set_sleep_threshold(self, float sleep_threshold) @cname("b3Body_SetSleepThreshold");
extern fn float BodyId.sleep_threshold(self) @cname("b3Body_GetSleepThreshold");
extern fn void BodyId.set_motion_locks(self, MotionLocks locks) @cname("b3Body_SetMotionLocks");
extern fn MotionLocks BodyId.motion_locks(self) @cname("b3Body_GetMotionLocks");
extern fn void BodyId.set_bullet(self, bool flag) @cname("b3Body_SetBullet");
extern fn bool BodyId.is_bullet(self) @cname("b3Body_IsBullet");
extern fn void body_allow_fast_rotation(BodyId body, bool flag) @cname("b3Body_AllowFastRotation");
extern fn bool BodyId.is_fast_rotation_allowed(self) @cname("b3Body_IsFastRotationAllowed");
extern fn void BodyId.enable_contact_recycling(self, bool flag) @cname("b3Body_EnableContactRecycling");
extern fn bool BodyId.is_contact_recycling_enabled(self) @cname("b3Body_IsContactRecyclingEnabled");
extern fn void BodyId.enable_hit_events(self, bool flag) @cname("b3Body_EnableHitEvents");
