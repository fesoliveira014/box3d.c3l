module b3::record;

import b3::draw;

<*
 A buffer of recorded world mutations: what a world writes between WorldId.start_recording() and
 WorldId.stop_recording(), and what create_player() and validate_replay() replay from. The caller
 owns it and must destroy() it exactly once; byte_count() carries it until then — 64 KiB at the
 default capacity — so a recording never destroyed shifts that count as a leaked world does.
*>
typedef Recording = void;

<*
 Creates a recording buffer. box3d takes 64 KiB when byte_capacity is zero or below, and grows the
 buffer on demand from wherever it starts, so the capacity is a starting size and not a bound.
 Nothing here is fallible — box3d has no refusal path. The caller owns it, and must destroy() it.
*>
extern fn Recording* create_recording(int byte_capacity) @cname("b3CreateRecording");

<*
 Releases the recording and its buffer. The caller owns it and must call this exactly once — see
 Recording. Any slice data() handed out dangles from here.
*>
extern fn void Recording.destroy(&self) @cname("b3DestroyRecording");

extern fn char* recording_data_raw(Recording* recording) @cname("b3Recording_GetData") @private;
extern fn int recording_size_raw(Recording* recording) @cname("b3Recording_GetSize") @private;
extern fn void start_recording_raw(WorldId world_id, Recording* recording) @cname("b3World_StartRecording") @private;

<*
 Ends the session, writing the trailing geometry registry and backpatching the header, which is
 what leaves the buffer self-contained. Inert on a world that is not recording, and
 WorldId.destroy() does this itself, so a world torn down mid-session still leaves playable bytes.
*>
extern fn void WorldId.stop_recording(self) @cname("b3World_StopRecording");

extern fn bool save_recording_raw(Recording* recording, ZString path) @cname("b3SaveRecordingToFile") @private;
extern fn Recording* load_recording_raw(ZString path) @cname("b3LoadRecordingFromFile") @private;
extern fn bool validate_replay_raw(void* data, int size, int worker_count) @cname("b3ValidateReplay") @private;

<*
 A recording being replayed frame by frame. box3d stands a private world up for it, so a live
 player adds one to world_count() and a leaked player leaks that world. Opaque upstream, so it
 could not be copied. Build one with create_player().
*>
typedef Player = void;

<*
 Releases the player, the replay world it stands up, its copy of the recorded bytes, and the
 length unit it took over — see create_player(). The caller owns the player and must call this
 exactly once.
*>
extern fn void Player.destroy(&self) @cname("b3DestroyPlayer");

extern fn Player* create_player_raw(void* data, int size, int worker_count) @cname("b3CreatePlayer") @private;

<*
 What a player read out of its recording when it opened it, so bounds covers the whole recording
 before a frame of it has been replayed. worker_count is the player's own rather than the
 recording's — create_player()'s argument, as Player.set_worker_count() has since clamped it.
*>
struct PlayerInfo {
    int frame_count;
    int worker_count;
    float time_step;
    int sub_step_count;
    float length_scale;
    Aabb bounds;
}

<*
 The kind of spatial query a frame recorded, naming the world call that made it.
*>
enum QueryType : int {
    OVERLAP_AABB,
    OVERLAP_SHAPE,
    CAST_RAY,
    CAST_SHAPE,
    CAST_RAY_CLOSEST,
    CAST_MOVER,
    COLLIDE_MOVER,
}

<*
 One spatial query the replay re-issued for the frame it belongs to. A field the query's kind does
 not carry stays zero. key, id and name are the tag the recorded call's filter carried, so an
 untagged query leaves all three empty, and name borrows the player's tag table rather than owning
 its bytes.
*>
struct QueryInfo {
    QueryType type;
    QueryFilter filter;
    Aabb aabb;
    Pos origin;
    Vec3 translation;
    int hit_count;
    ulong key;
    ulong id;
    ZString name;
}

<*
 One result of a recorded query. point, normal and fraction are written only by CAST_RAY,
 CAST_SHAPE and CAST_RAY_CLOSEST; OVERLAP_AABB, OVERLAP_SHAPE and COLLIDE_MOVER record the shape
 alone, and CAST_MOVER records no hit at all. On the six that write none of them, those three
 fields carry whatever the replay's shared hit scratch last held — which is often zero, since a
 grown scratch copies only what it held before.
*>
struct QueryHit {
    ShapeId shape;
    Pos point;
    Vec3 normal;
    float fraction;
}

<*
 Replays every record up to and including the next step, then the state hash that closes it.
 False once the op stream is exhausted, which is what ends a replay loop.
*>
extern fn bool Player.step_frame(&self) @cname("b3RecPlayer_StepFrame");

<*
 Replays a frame that creates bodies in two calls, the first stopping at the pose those bodies
 were created in — see is_at_pre_step(). A frame that creates none is replayed whole by a single
 call, so this is not a fixed two calls per frame.
*>
extern fn void Player.sub_step_frame(&self) @cname("b3RecPlayer_SubStepFrame");

<*
 Rewinds to frame 0 in place, which is what keeps world_id() stable across it. Clears the
 divergence latch and the frame's recorded queries, and rolls the body list back to frame 0's.
*>
extern fn void Player.restart(&self) @cname("b3RecPlayer_Restart");

<*
 Replays to target_frame, a backward seek restoring the nearest keyframe before it rather than
 replaying from the start. Neither end is refused: a negative target lands on frame 0, and one
 past the recording stops at its last frame with is_at_end() true.
*>
extern fn void Player.seek_frame(&self, int target_frame) @cname("b3RecPlayer_SeekFrame");

<*
 The world this player drives. restart() and every seek keep it, but set_debug_shape_callbacks()
 stands a new world up and leaves the id read before it invalid.
*>
extern fn WorldId Player.world_id(&self) @cname("b3RecPlayer_GetWorldId");

<*
 The last fully replayed frame: 0 before the first step, frame_count() at the end.
*>
extern fn int Player.frame(&self) @cname("b3RecPlayer_GetFrame");

extern fn int Player.frame_count(&self) @cname("b3RecPlayer_GetFrameCount");
extern fn bool Player.is_at_end(&self) @cname("b3RecPlayer_IsAtEnd");

<*
 True while sub_step_frame() is paused between a frame's body creations and its step, which is
 where a renderer draws a body at the pose it was created in. step_frame() never leaves it true.
*>
extern fn bool Player.is_at_pre_step(&self) @cname("b3RecPlayer_IsAtPreStep");

<*
 True once a replayed frame failed to reproduce the recording — a state hash that did not match,
 or any re-issued query that answered differently. restart() clears it, diverge_frame() names the
 frame, and box3d's own header names only the hash.
*>
extern fn bool Player.has_diverged(&self) @cname("b3RecPlayer_HasDiverged");

extern fn PlayerInfo Player.info(&self) @cname("b3RecPlayer_GetInfo");
extern fn int diverge_frame_raw(Player* player) @cname("b3RecPlayer_GetDivergeFrame") @private;

<*
 Sets the worker count the replay world partitions its constraint graph across, clamped into 1 to
 MAX_WORKERS rather than refused. A count the recording was not made at turns the state hash check
 into a cross-thread determinism test.
*>
extern fn void Player.set_worker_count(&self, int count) @cname("b3RecPlayer_SetWorkerCount");

<*
 Tunes the keyframe ring a backward seek restores from, trading memory for seek speed. A budget of
 zero or an interval below one keeps the value it had rather than setting it, and either way the
 ring is dropped, so a later replay repopulates it under the policy left here.
*>
extern fn void Player.set_keyframe_policy(
  &self,
  usz budget_bytes,
  int min_interval_frames,
) @cname("b3RecPlayer_SetKeyframePolicy");

extern fn usz Player.keyframe_budget(&self) @cname("b3RecPlayer_GetKeyframeBudget");
extern fn int Player.keyframe_min_interval(&self) @cname("b3RecPlayer_GetKeyframeMinInterval");

<*
 The spacing keyframes are actually captured at: keyframe_min_interval() until the ring evicts to
 stay under budget, and doubling from there.
*>
extern fn int Player.keyframe_interval(&self) @cname("b3RecPlayer_GetKeyframeInterval");

extern fn usz Player.keyframe_bytes(&self) @cname("b3RecPlayer_GetKeyframeBytes");

<*
 How many bodies the replay has created up to this frame, keeping the ordinal of every destroyed
 one, so it is the bound body_id() indexes against and not a count of live bodies.
*>
extern fn int Player.body_count(&self) @cname("b3RecPlayer_GetBodyCount");

extern fn BodyId body_id_raw(Player* player, int index) @cname("b3RecPlayer_GetBodyId") @private;

<*
 Wires a renderer's per-shape callbacks into the replay world, which box3d reaches from a draw of
 that world and nowhere else, so replaying alone calls neither. It stands a new world up and
 rewinds to frame 0, so it belongs immediately after create_player(). A body or shape id from the
 old world still reads valid where the world id does not, and the pre-step pause and the frame's
 recorded queries survive the rewind where the divergence latch and end flag do not.
*>
extern fn void Player.set_debug_shape_callbacks(
  &self,
  CreateDebugShapeFn create_debug_shape,
  DestroyDebugShapeFn destroy_debug_shape,
  void* context,
) @cname("b3RecPlayer_SetDebugShapeCallbacks");

<*
 How many spatial queries the last replayed frame re-issued. A query is recorded ahead of the step
 it precedes, so it belongs to the frame that step completes; every other frame reports none,
 except after set_debug_shape_callbacks(), which rewinds without clearing this store.
*>
extern fn int Player.frame_query_count(&self) @cname("b3RecPlayer_GetFrameQueryCount");

extern fn QueryInfo frame_query_raw(Player* player, int index) @cname("b3RecPlayer_GetFrameQuery") @private;
extern fn QueryHit frame_query_hit_raw(
  Player* player,
  int query_index,
  int hit_index,
) @cname("b3RecPlayer_GetFrameQueryHit") @private;

<*
 Draws the queries the last replayed frame re-issued, for a renderer to layer over the world it
 has just drawn: casts as segments with a point and a normal per hit, movers and cast proxies as
 capsules and spheres, overlaps as boxes around the shapes they found. It reads none of the
 definition's flags, and a null callback or a null definition draws nothing here where
 draw::WorldId.draw() would call or dereference it.

 @param query_index : `which of the frame's queries to draw, or any negative value for all`
 @param selected_index : `which to draw in the reserved colour and label; an index no query
   holds draws none`
*>
extern fn void Player.draw_frame_queries(
  &self,
  DebugDraw* draw,
  int query_index,
  int selected_index,
) @cname("b3RecPlayer_DrawFrameQueries");
